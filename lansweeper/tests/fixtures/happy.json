{
  "name": "happy",
  "integration": "lansweeper",
  "description": "The authorized-site bootstrap followed by one page of assetResources. Proves the site query result drives the per-site asset query, that an item is keyed on its site-scoped key, that softwares becomes Software with the CPE 2.2 application binding assigned to cpe23 while a CPE 2.3 formatted string is kept as a custom attribute instead (Software.cpe23 only accepts ^cpe:/a: and a 2.3 string would fail validation and drop the whole record), that a duplicate name/version pair is folded, and that an item with no key and a non-object item are each skipped by name without ending the page. A site whose id contains characters Lansweeper never issues is refused, because the id is interpolated straight into the GraphQL document. The asset query must name \"key\" in its requested fields list: build_asset reads item.key as the foreign id, and a Lansweeper that returned only the requested fields would otherwise hand back keyless items and import zero assets.",
  "kwargs": {
    "url": "$BASE",
    "application_identity_code": "fixture-identity-code",
    "import_software": "true",
    "page_size": "200"
  },
  "routes": [
    {
      "name": "authorized-sites",
      "match": {
        "method": "POST",
        "path": "/api/v2/graphql",
        "body_contains": "authorizedSites"
      },
      "responses": [
        {
          "status": 200,
          "json": {
            "data": {
              "authorizedSites": {
                "sites": [
                  {
                    "id": "site-aaa111",
                    "name": "HQ"
                  },
                  {
                    "id": "bad site id",
                    "name": "Injected"
                  },
                  {
                    "id": "",
                    "name": "No id"
                  }
                ]
              }
            }
          }
        }
      ],
      "when_exhausted": "error"
    },
    {
      "name": "asset-page-first",
      "match": {
        "method": "POST",
        "path": "/api/v2/graphql",
        "body_contains": "\"page\":\"FIRST\""
