{
  "name": "page-limit",
  "integration": "aruba-clearpass",
  "description": "Proves the max_pages parameter actually drives the loop bound rather than decorating the credential form, and that a run stopped by the ceiling says so. max_pages is 2, page_size is 1, and the server offers a third full page, so a walk that ignored the parameter would fetch it.\n\nEach page carries a DIFFERENT endpoint, so the repeated-page check cannot fire and the ceiling is the only thing that can stop this walk. Every page fills the requested limit of one and advertises a next link, because a short page or an absent next link is the walk's own exit.\n\nThe offset=2 route is a regression terminator: it ends the walk one request past the ceiling, so an integration that ignored max_pages fails on request_count, requests_absent and the missing log line rather than by TIMING OUT at the 20,000-page default.\n\nThe asserted line carries the ' - raise the max_pages parameter to import the rest' remediation, which is the only thing that tells an operator a truncated run is fixable and how.\n\nno_mac_in_id is skipped for the reason recorded in happy: ClearPass identifies an endpoint by its MAC and that is the only stable id it has.",
  "kwargs": {
    "url": "$BASE",
    "client_id": "fixture-client",
    "client_secret": "fixture-secret",
    "page_size": "1",
    "max_pages": "2"
  },
  "routes": [
    {
      "name": "oauth-token",
      "match": {
        "method": "POST",
        "path": "/api/oauth"
      },
      "responses": [
        {
          "status": 200,
          "json": {
            "access_token": "fixture-access-token",
            "expires_in": 28800
          }
        }
      ],
      "when_exhausted": "repeat_last"
    },
    {
      "name": "endpoints-page-3-terminator",
      "match": {
        "method": "GET",
        "path": "/api/endpoint",
        "query_contains": "offset=2"
      },
      "responses": [
        {
          "status": 200,
          "json": {
            "_embedded": {
              "items": [
                {
                  "id": 7003,
                  "mac_address": "00:11:22:77:00:03",
                  "status": "Known",
                  "added_at": "2026-05-01 10:00:00",
                  "updated_at": "2026-08-15 06:01:00",
                  "profile": {
                    "ipv4_address": "10.77.0.3",
                    "host_name": "cppm-cap-3",
                    "device_category": "Computer",
                    "last_profiled_at": "2026-08-15 05:00:00"
                  }
                }
              ]
            }
          }
        }
      ],
      "when_exhausted": "empty"
    },
    {
      "name": "endpoints",
      "match": {
        "method": "GET",
        "path": "/api/endpoint"
      },
      "responses": [
        {
          "status": 200,
          "json": {
            "_embedded": {
              "items": [
                {
                  "id": 7001,
                  "mac_address": "00:11:22:77:00:01",
                  "status": "Known",
                  "added_at": "2026-05-01 10:00:00",
                  "updated_at": "2026-08-15 06:01:00",
                  "profile": {
                    "ipv4_address": "10.77.0.1",
                    "host_name": "cppm-cap-1",
                    "device_category": "Computer",
                    "last_profiled_at": "2026-08-15 05:00:00"
                  }
                }
              ]
            },
            "_links": {
              "next": {
                "href": "/api/endpoint?offset=next"
              }
            }
          }
        },
        {
          "status": 200,
          "json": {
            "_embedded": {
              "items": [
                {
                  "id": 7002,
                  "mac_address": "00:11:22:77:00:02",
                  "status": "Known",
                  "added_at": "2026-05-01 10:00:00",
                  "updated_at": "2026-08-15 06:01:00",
                  "profile": {
                    "ipv4_address": "10.77.0.2",
                    "host_name": "cppm-cap-2",
                    "device_category": "Computer",
                    "last_profiled_at": "2026-08-15 05:00:00"
                  }
                }
              ]
            },
            "_links": {
              "next": {
                "href": "/api/endpoint?offset=next"
              }
            }
          }
        }
      ],
      "when_exhausted": "repeat_last"
    }
  ],
  "expect": {
    "asset_count": 2,
    "request_count": 3,
    "requests_absent": [
      {
        "method": "GET",
        "path": "/api/endpoint",
        "query_contains": "offset=2"
      }
    ],
    "log_contains": [
      "aruba-clearpass: page limit of 2 hit (integration safety limit, walking endpoints, retrieved 2 assets, total not reported) - raise the max_pages parameter to import the rest"
    ]
  },
  "invariants": {
    "skip": [
      "no_mac_in_id"
    ]
  }
}
