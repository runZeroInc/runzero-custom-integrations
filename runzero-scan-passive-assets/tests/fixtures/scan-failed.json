            "type": "scan",
            "status": "processed",
            "stats": {}
          }
        }
      ],
      "when_exhausted": "repeat_last"
    },
    {
      "name": "second explorer's scan errors",
      "match": {"method": "GET", "path": "/api/v1.0/org/tasks/cccccccc-2222-4333-8444-555555555555"},
      "responses": [
        {
          "status": 200,
          "json": {
            "id": "cccccccc-2222-4333-8444-555555555555",
            "agent_id": "b1b1b1b1-5555-4666-8777-888888888888",
            "type": "scan",
            "status": "error",
            "error": "explorer disconnected",
            "stats": {}
          }
        }
      ],
      "when_exhausted": "repeat_last"
