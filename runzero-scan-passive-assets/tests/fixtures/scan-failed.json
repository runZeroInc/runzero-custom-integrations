              "last_agent_id": "a0a0a0a0-1111-4222-8333-444444444444"
            },
            {
              "id": "11111111-aaaa-4bbb-8ccc-000000000003",
              "addresses": ["192.168.7.31"],
              "last_agent_id": "b1b1b1b1-5555-4666-8777-888888888888"
            }
          ]
        }
      ]
    },
    {
      "name": "create scan task",
      "match": {"method": "PUT", "path": "/api/v1.0/org/sites/77777777-6666-5555-4444-333333333333/scan"},
      "responses": [
        {
          "status": 200,
          "json": {
            "id": "cccccccc-1111-4222-8333-444444444444",
            "site_id": "77777777-6666-5555-4444-333333333333",
            "agent_id": "a0a0a0a0-1111-4222-8333-444444444444",
