    "request_count": 6,
    "requests_include": [
      {"method": "POST", "path": "/api/v1.0/org/assets/bulk/delete", "body_contains": "11111111-aaaa-4bbb-8ccc-000000000001"},
      {"method": "POST", "path": "/api/v1.0/org/assets/bulk/delete", "body_contains": "11111111-aaaa-4bbb-8ccc-000000000002"}
    ],
    "requests_absent": [
