            "agent_id": "b1b1b1b1-5555-4666-8777-888888888888",
            "type": "scan",
            "status": "new",
            "stats": {}
          }
        }
      ],
      "when_exhausted": "error"
    },
    {
      "name": "first explorer's scan completes",
      "match": {"method": "GET", "path": "/api/v1.0/org/tasks/cccccccc-1111-4222-8333-444444444444"},
