{
  "name": "scan-failed",
  "integration": "runzero-scan-passive-assets",
  "script": "runzero-scan-passive-assets/runzero-scan-passive-assets.star",
  "description": "Two Explorers, two scans, two different outcomes -- which is why asset ids are grouped by Explorer rather than kept in one flat list. The first Explorer's scan reaches `processed` and its two assets have genuinely been superseded, so they are deleted. The second Explorer's scan ends in `error` (models/task.go lists it among the terminal statuses, and actions/tasks.go renders it as failed): nothing was discovered, so its asset is the only record of that host and must survive. The bulk-delete body is the assertion -- it must carry the first Explorer's two ids and must NOT carry the third. A run that deleted on the strength of a queued scan, or that tracked one flat id list, would delete all three and lose a host that no scan ever reached. `error` rather than `canceled` because it is the outcome an operator will actually meet: an Explorer that went offline mid-scan.",

  "kwargs": {
    "url": "$BASE",
    "site_id": "77777777-6666-5555-4444-333333333333",
    "org_api_token": "OT9f8e7d6c5b4a39281706f5e4d3c2b1a0"
  },

  "routes": [
    {
      "name": "passive asset export",
      "match": {"method": "GET", "path": "/api/v1.0/export/org/assets.json"},
      "responses": [
        {
          "status": 200,
          "json": [
            {
              "id": "11111111-aaaa-4bbb-8ccc-000000000001",
              "addresses": ["10.42.0.11"],
              "last_agent_id": "a0a0a0a0-1111-4222-8333-444444444444"
            },
            {
              "id": "11111111-aaaa-4bbb-8ccc-000000000002",
