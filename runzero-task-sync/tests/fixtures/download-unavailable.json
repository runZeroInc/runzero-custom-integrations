  "default_response": {"status": 404, "text": "no fixture route"},

  "expect": {
    "asset_count": 0,
    "request_count": 6,
    "requests_include": [
      {"method": "GET", "path": "/api/v1.0/org/tasks/d5d5d5d5-3333-4444-8555-666666666666/data"},
      {"method": "GET", "path": "/scan-bucket/scan_d6d6d6d6_eeeeeeee.json.gz"},
      {"method": "PUT", "path": "/api/v1.0/org/sites/cccccccc-9999-4aaa-8bbb-cccccccccccc/import"},
      {"method": "POST", "path": "/api/v1.0/org/tasks/d6d6d6d6-6666-4777-8888-999999999999/hide"}
    ],
    "requests_absent": [
      {"method": "POST", "path": "/api/v1.0/org/tasks/d5d5d5d5-3333-4444-8555-666666666666/hide"}
    ],
    "log_contains": [
      "Failed to download task: d5d5d5d5-3333-4444-8555-666666666666",
      "Sync failed for task: d5d5d5d5-3333-4444-8555-666666666666",
      "Successfully synced task: d6d6d6d6-6666-4777-8888-999999999999",
      "Task hidden: d6d6d6d6-6666-4777-8888-999999999999"
    ]
  }
}
