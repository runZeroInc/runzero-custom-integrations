{
  "name": "detail-cap",
  "integration": "asimily",
  "description": "Installed software is an N+1 fetch: Asimily keys /assets/application on MAC address, so it costs one request per device. With software_device_limit=2 and three MAC-bearing devices, exactly two application requests may be made and the third device must be imported without software and counted in the skipped log line. The fourth device has no MAC at all and must not consume any budget. check_determinism is off because the id is scoped by the portal host, which under the fixture server carries an ephemeral port.",
  "kwargs": {
    "url": "$BASE",
    "username": "fixture-user",
    "api_key": "fixture-key",
    "include_vulnerabilities": "false",
    "include_software": "true",
    "software_device_limit": "2",
    "page_size": "10"
  },
  "default_response": {"status": 400, "json": {"error": "missing or malformed source header"}},
  "routes": [
    {
      "name": "applications-alpha",
      "match": {"method": "GET", "path": "/api/extapi/assets/application", "query_contains": "macAddr=00%3A1B%3A44%3A80%3A00%3A01", "header": {"source": "runzero"}},
      "responses": [
        {
          "status": 200,
          "json": [
            {
              "macAddr": "00:1B:44:80:00:01",
              "applications": [
                {"application": "Acme Control Suite", "version": "3.4.0"},
                {"application": "OpenSSL", "version": "1.1.1w"},
                {"application": "Wildcard Agent", "version": "*"}
              ]
            }
          ]
        }
      ],
      "when_exhausted": "repeat_last"
    },
    {
      "name": "applications-beta",
      "match": {"method": "GET", "path": "/api/extapi/assets/application", "query_contains": "macAddr=00%3A1B%3A44%3A80%3A00%3A02", "header": {"source": "runzero"}},
      "responses": [
        {
          "status": 200,
          "json": [
            {
              "macAddr": "00:1B:44:80:00:02",
              "applications": [
                {"application": "Beta Monitor Agent", "version": "2.0.1"}
              ]
            }
          ]
        }
      ],
      "when_exhausted": "repeat_last"
    },
    {
      "name": "applications-any",
      "match": {"method": "GET", "path": "/api/extapi/assets/application", "header": {"source": "runzero"}},
      "responses": [
        {"status": 500, "text": "this device is past the software limit and must never be queried"}
      ],
      "when_exhausted": "repeat_last"
    },
    {
      "name": "assets",
      "match": {"method": "GET", "path": "/api/extapi/assets", "header": {"source": "runzero"}},
      "responses": [
        {
          "status": 200,
          "json": {
            "totalPages": 1,
            "content": [
              {
                "deviceID": 80001,
                "hostName": "alpha-sw-01",
                "macAddr": "00:1B:44:80:00:01",
                "v4IpAddrs": ["10.80.1.1"],
                "deviceType": "Workstation",
                "deviceClass": "IT",
                "lastDiscoveredAt": "2026-08-10T00:00:00Z"
              },
              {
                "deviceID": 80002,
                "hostName": "beta-sw-02",
                "macAddr": "00:1B:44:80:00:02",
                "v4IpAddrs": ["10.80.1.2"],
                "deviceType": "Patient Monitor",
                "deviceClass": "Medical",
                "lastDiscoveredAt": "2026-08-10T01:00:00Z"
              },
              {
                "deviceID": 80003,
                "hostName": "gamma-sw-03",
                "macAddr": "00:1B:44:80:00:03",
                "v4IpAddrs": ["10.80.1.3"],
                "deviceType": "Workstation",
                "deviceClass": "IT",
                "lastDiscoveredAt": "2026-08-10T02:00:00Z"
              },
              {
                "deviceID": 80004,
                "hostName": "delta-nomac-04",
                "macAddr": "",
                "v4IpAddrs": ["10.80.1.4"],
                "deviceType": "Kiosk",
                "deviceClass": "IT",
                "lastDiscoveredAt": "2026-08-10T03:00:00Z"
              }
            ]
          }
        }
      ],
      "when_exhausted": "empty"
    }
  ],
  "expect": {
    "asset_count": 4,
    "min_software_total": 3,
    "requests_include": [
      {"method": "GET", "path": "/api/extapi/assets/application", "query_contains": "macAddr=00%3A1B%3A44%3A80%3A00%3A01"},
      {"method": "GET", "path": "/api/extapi/assets/application", "query_contains": "macAddr=00%3A1B%3A44%3A80%3A00%3A02"}
    ],
    "requests_absent": [
      {"path": "/api/extapi/assets/application", "query_contains": "macAddr=00%3A1B%3A44%3A80%3A00%3A03"}
    ],
    "log_contains": [
      "asimily: fetched software for 2 devices",
      "asimily: skipped software for 1 devices; raise the software device limit (2) to cover more"
    ]
  },
  "invariants": {
    "skip": []
  },
  "check_determinism": false
}
