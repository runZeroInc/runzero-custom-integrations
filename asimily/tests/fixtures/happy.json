      "when_exhausted": "empty"
    }
  ],
  "expect": {
    "asset_count": 3,
    "min_requests": 2,
    "requests_include": [
      {"method": "POST", "path": "/api/extapi/assets/device-cves", "query_contains": "sort=deviceInfoId"},
      {"method": "POST", "path": "/api/extapi/assets/device-cves", "body_contains": "isFixed"},
      {"method": "GET", "path": "/api/extapi/assets", "query_contains": "size=200"},
      {"header_contains": "Basic"},
      {"method": "POST", "path": "/api/extapi/assets/device-cves", "header": {"source": "runzero"}},
      {"method": "GET", "path": "/api/extapi/assets", "header": {"source": "runzero"}}
    ],
    "requests_absent": [
      {"path": "/api/extapi/assets/application"}
    ],
    "log_contains": ["asimily: indexed 3 open CVEs across 2 devices"]
  },
  "invariants": {
    "skip": []
  },
  "check_determinism": false
}
