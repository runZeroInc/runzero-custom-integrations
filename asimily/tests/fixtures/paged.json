{
  "name": "paged",
  "integration": "asimily",
  "description": "Two-page walk over both endpoints. Asimily paginates with a zero-based `page` parameter and a `totalPages` count, so the second call must carry page=1 and the walk must stop once page+1 reaches totalPages rather than looping forever. CVEs indexed on page 2 of /device-cves are joined onto a device that only appears on page 2 of /assets, proving the index is built fully before the asset stream starts. check_determinism is off and `ids` is unasserted because the id is scoped by the portal host, which under the fixture server is 127.0.0.1:<ephemeral port>.",
  "kwargs": {
    "url": "$BASE",
    "username": "fixture-user",
    "api_key": "fixture-key",
    "include_vulnerabilities": "true",
    "page_size": "2"
  },
  "default_response": {"status": 400, "json": {"error": "missing or malformed source header"}},
  "routes": [
    {
      "name": "device-cves",
      "match": {"method": "POST", "path": "/api/extapi/assets/device-cves", "header": {"source": "runzero"}},
      "responses": [
        {
          "status": 200,
          "json": {
            "totalPages": 2,
            "content": [
              {
                "deviceId": 70001,
                "cves": [
                  {"cveName": "CVE-2025-70001", "productName": "AlphaFW", "score": 8.2,
                   "cvssBaseScore": 8.8, "isFixed": 56}
                ]
              }
            ]
          }
        },
        {
          "status": 200,
          "json": {
            "totalPages": 2,
            "content": [
              {
                "deviceId": 70004,
                "cves": [
                  {"cveName": "CVE-2025-70004", "productName": "DeltaFW", "score": 6.0,
                   "cvssBaseScore": 6.4, "isFixed": 56}
                ]
              }
            ]
          }
        }
      ],
      "when_exhausted": "error"
    },
    {
      "name": "assets",
      "match": {"method": "GET", "path": "/api/extapi/assets", "header": {"source": "runzero"}},
      "responses": [
        {
          "status": 200,
          "json": {
            "totalPages": 2,
            "content": [
              {
                "deviceID": 70001,
                "hostName": "alpha-01",
                "macAddr": "00:1B:44:70:00:01",
                "v4IpAddrs": ["10.70.1.1"],
                "deviceType": "Ultrasound",
                "deviceClass": "Medical",
                "manufacturer": "Acme Medical",
                "lastDiscoveredAt": "2026-08-10T00:00:00Z"
              },
              {
                "deviceID": 70002,
                "hostName": "beta-02",
                "macAddr": "00:1B:44:70:00:02",
                "v4IpAddrs": ["10.70.1.2"],
                "deviceType": "Ventilator",
                "deviceClass": "Medical",
                "lastDiscoveredAt": "2026-08-11T00:00:00Z"
              }
            ]
          }
        },
        {
          "status": 200,
          "json": {
            "totalPages": 2,
            "content": [
              {
                "deviceID": 70003,
                "hostName": "gamma-03",
                "macAddr": "00:1B:44:70:00:03",
                "v4IpAddrs": ["10.70.1.3"],
                "deviceType": "Workstation",
                "deviceClass": "IT",
                "lastDiscoveredAt": "2026-08-12T00:00:00Z"
              },
              {
                "deviceID": 70004,
                "hostName": "delta-04",
                "macAddr": "00:1B:44:70:00:04",
                "v4IpAddrs": ["10.70.1.4"],
                "deviceType": "Infusion Pump",
                "deviceClass": "Medical",
                "lastDiscoveredAt": "2026-08-12T12:00:00Z"
              }
            ]
          }
        }
      ],
      "when_exhausted": "error"
    }
  ],
  "expect": {
    "asset_count": 4,
    "request_count": 4,
    "requests_include": [
      {"method": "POST", "path": "/api/extapi/assets/device-cves", "query_contains": "page=0"},
      {"method": "POST", "path": "/api/extapi/assets/device-cves", "query_contains": "page=1"},
      {"method": "GET", "path": "/api/extapi/assets", "query_contains": "page=0"},
      {"method": "GET", "path": "/api/extapi/assets", "query_contains": "page=1"}
    ],
    "requests_absent": [
      {"path": "/api/extapi/assets", "query_contains": "page=2"},
      {"path": "/api/extapi/assets/device-cves", "query_contains": "page=2"}
    ],
    "log_contains": ["asimily: indexed 2 open CVEs across 2 devices"]
  },
  "invariants": {
    "skip": []
  },
  "check_determinism": false
}
