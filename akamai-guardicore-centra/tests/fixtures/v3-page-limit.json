{
  "name": "v3-page-limit",
  "integration": "akamai-guardicore-centra",
  "script": "akamai-guardicore-centra/centra-v3-api.star",
  "description": "Proves the max_pages parameter actually drives the loop bound rather than decorating the credential form, and that a run stopped by the ceiling says so. max_pages is set to 2 and the status=on walk is offered a third full page, so a walk that ignored the parameter would fetch it.\n\nEach page carries a DIFFERENT first row, so the page-signature check cannot fire and the ceiling is the only thing that can stop this walk. Every page is full at a thousand rows because a short page is the walk's own exit; one real row per page proves rows are still parsed and reported and the remaining 999 carry no id and are skipped.\n\nThe route matching start_at=2000 is a regression terminator: it ends the walk on an empty page one request past the ceiling, so an integration that ignored max_pages fails on request_count, requests_absent and the missing log line rather than by TIMING OUT at the 10,000-page default.\n\ntotal_count is far larger than what is served, so log_contains pins the retrieved-versus-available shape and the ' - raise the max_pages parameter' remediation, which is the only thing that tells an operator a truncated run is fixable.\n\nnamespaced_ids is skipped for the reason recorded in happy: the id is the bare Centra asset guid with no appliance scope.",
  "kwargs": {
    "url": "$BASE",
    "username": "fixture-user",
    "password": "fixture-password",
    "max_pages": "2"
  },
  "routes": [
    {
      "name": "auth",
      "match": {
        "method": "POST",
        "path": "/api/v3.0/authenticate"
      },
      "responses": [
        {
          "status": 200,
          "json": {
            "access_token": "fixture-centra-token"
          }
        }
      ]
    },
    {
      "name": "assets-on-page-3-terminator",
      "match": {
        "method": "GET",
        "path": "/api/v4.0/assets",
        "query_contains": "start_at=2000"
      },
      "responses": [
        {
          "status": 200,
          "json": {
            "total_count": 450000,
            "objects": []
          }
        }
      ],
      "when_exhausted": "empty"
    },
    {
      "name": "assets-on",
      "match": {
        "method": "GET",
        "path": "/api/v4.0/assets",
        "query_contains": "status=on"
      },
