{
  "name": "v3-malformed",
  "integration": "akamai-guardicore-centra",
  "script": "akamai-guardicore-centra/centra-v3-api.star",
  "description": "A page mixing an agented asset, an agentless asset whose guest_agent_details is present-but-null (the shape that used to abort the whole run with 'NoneType has no .get' -- verified against the real scanner), a bare string row, a null row, a non-dict label member, and a metadata array holding non-string members. All of it must be survived: the two real assets import, the junk rows are skipped with a log line, and the odd label/metadata members become plain attributes instead of aborting .items()/join. has_correlator is skipped with reason: the v3 shape takes hostname and NICs only from guest_agent_details, so a genuinely agentless asset carries no correlator -- this scenario proves the run survives it, not that the record is useful. namespaced_ids is skipped for the reason recorded in the other v3 scenarios: the id is the bare Centra asset guid.",
  "kwargs": {
    "url": "$BASE",
    "username": "fixture-user",
    "password": "fixture-password"
  },
  "routes": [
    {
      "name": "auth",
      "match": {"method": "POST", "path": "/api/v3.0/authenticate"},
      "responses": [{"status": 200, "json": {"access_token": "fixture-centra-token", "2fa_required": false}}],
      "when_exhausted": "repeat_last"
    },
    {
      "name": "assets-on",
      "match": {"method": "GET", "path": "/api/v4.0/assets", "query_contains": "status=on"},
      "responses": [
        {
          "status": 200,
          "json": {
            "total_count": 2,
            "objects": [
              {
                "id": "asset-guid-0401",
                "name": "syn-centra-401",
                "status": "on",
                "labels": [{"key": "env", "value": "prod"}, "stray-label-string"],
                "metadata": [["source", "vsphere"], ["mixed", 42, null], "bare-metadata-string"],
                "guest_agent_details": {
                  "hostname": "syn-centra-401",
                  "os_details": {"os_version_name": "Ubuntu 22.04", "os_type": "Linux"},
                  "hardware": {"vendor": "VMware, Inc.", "hw_uuid": "bbbbbbbb-0000-4000-8000-000000000401"},
                  "network": [
                    {"hardware_address": "00:50:56:00:c4:01", "ip_addresses": [{"address": "198.51.100.41"}, "not-an-address-object"]}
                  ]
                }
              },
              {
                "id": "asset-guid-0402",
                "name": "syn-centra-402-agentless",
                "status": "on",
                "guest_agent_details": null,
                "labels": null,
                "metadata": null,
                "orchestration_details": null,
                "recent_domains": null
              },
              "this row is a string, not an asset object",
              null
            ]
          }
        }
      ],
      "when_exhausted": "repeat_last"
    },
    {
      "name": "assets-off",
      "match": {"method": "GET", "path": "/api/v3.0/assets", "query_contains": "status=off"},
      "responses": [{"status": 200, "json": {"total_count": 0, "objects": []}}],
      "when_exhausted": "repeat_last"
    }
  ],
  "expect": {
    "asset_count": 2,
    "ids": ["asset-guid-0401", "asset-guid-0402"],
    "assets": [
      {
        "id": "asset-guid-0401",
        "fields": {
          "ipAddresses": "198.51.100.41",
          "macAddresses": "00:50:56:00:c4:01"
        }
      }
    ],
    "log_contains": [
      "centra-v3: skipping non-dict asset record: string",
      "centra-v3: skipping non-dict asset record: NoneType"
    ],
    "request_count": 3
  },
  "invariants": {
    "skip": ["namespaced_ids", "has_correlator"]
  }
}
