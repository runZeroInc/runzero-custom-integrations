{
  "name": "nic-without-details",
  "integration": "akamai-guardicore-centra",
  "script": "akamai-guardicore-centra/centra-v4-api.star",
  "description": "Centra returns NICs with nothing usable on them -- an orchestration-only record with an empty ip_addresses list and a null mac_address, or a NIC whose hardware address the agent has not reported. network_interface() answers None for both, and the unguarded interfaces.append() put that None into networkInterfaces, which ImportAsset rejects by ABORTING the whole run: asset 0201 carries the empty NIC, so 0202 later on the same page and 0203 on the following status page were both lost with it. All three assets must import, the unusable NICs must be dropped rather than emitted, and the assets that do have a NIC must keep it. namespaced_ids is skipped because the script uses Centra's own asset guid as the foreign id, unscoped, exactly as the happy and degraded scenarios do -- that is a separate identity concern, not this one.",
  "kwargs": {
    "url": "$BASE",
    "username": "fixture-user",
    "password": "fixture-password"
  },
  "routes": [
    {
      "name": "auth",
      "match": {"method": "POST", "path": "/api/v3.0/authenticate"},
      "responses": [{"status": 200, "json": {"access_token": "fixture-centra-token", "2fa_required": false}}],
      "when_exhausted": "repeat_last"
    },
    {
      "name": "assets-on",
      "match": {"method": "GET", "path": "/api/v4.0/assets", "query_contains": "status=on"},
      "responses": [
        {
          "status": 200,
          "json": {
            "total_count": 2,
            "objects": [
              {
                "id": "asset-guid-0201",
                "name": "syn-centra-201",
                "status": "on",
                "asset_type": "Server",
                "first_seen": "2026-01-05 08:15:00",
                "last_seen": "2026-08-01 09:00:00",
                "os_info": {"type": "Linux", "full_kernel_version": "5.15.0-105-generic"},
                "agent": {"id": "agent-0201", "agent_version": "5.2.0", "agent_last_seen": "2026-08-01 09:05:00"},
                "nics": [
                  {"mac_address": "00:50:56:00:c2:01", "ip_addresses": ["192.0.2.11"]},
                  {"mac_address": null, "ip_addresses": []}
                ]
              },
              {
                "id": "asset-guid-0202",
                "name": "syn-centra-202",
                "status": "on",
                "asset_type": "Server",
                "first_seen": "2026-02-05 08:15:00",
                "last_seen": "2026-08-02 09:00:00",
                "os_info": {"type": "Windows"},
                "agent": {"id": "agent-0202", "agent_version": "5.2.0", "agent_last_seen": "2026-08-02 09:05:00"},
                "nics": [
                  {"mac_address": "00:50:56:00:c2:02", "ip_addresses": ["192.0.2.12"]}
                ]
              }
            ]
          }
        }
      ],
      "when_exhausted": "repeat_last"
    },
    {
      "name": "assets-off",
      "match": {"method": "GET", "path": "/api/v4.0/assets", "query_contains": "status=off"},
      "responses": [
        {
          "status": 200,
          "json": {
            "total_count": 1,
            "objects": [
              {
                "id": "asset-guid-0203",
                "name": "syn-centra-203",
                "status": "off",
                "asset_type": "Server",
                "first_seen": "2026-03-05 08:15:00",
                "last_seen": "2026-08-03 09:00:00",
                "os_info": {"type": "Linux"},
                "agent": {"id": "agent-0203", "agent_version": "5.2.0"},
                "nics": [
                  {"mac_address": "not-a-mac", "ip_addresses": []}
                ]
              }
            ]
          }
        }
      ],
      "when_exhausted": "repeat_last"
    }
  ],
  "expect": {
    "asset_count": 3,
    "ids": ["asset-guid-0201", "asset-guid-0202", "asset-guid-0203"],
    "assets": [
      {
        "id": "asset-guid-0201",
        "fields": {
          "ipAddresses": "192.0.2.11",
          "macAddresses": "00:50:56:00:c2:01"
        }
      },
      {
        "id": "asset-guid-0202",
        "fields": {
          "ipAddresses": "192.0.2.12",
          "macAddresses": "00:50:56:00:c2:02"
        }
      },
      {
        "id": "asset-guid-0203",
        "fields": {"hostnames": "syn-centra-203"},
        "fields_absent": ["ipAddresses", "macAddresses"]
      }
    ],
    "request_count": 3
  },
  "invariants": {
    "skip": ["namespaced_ids"]
  }
}
