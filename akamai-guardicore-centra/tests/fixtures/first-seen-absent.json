{
  "name": "first-seen-absent",
  "integration": "akamai-guardicore-centra",
  "script": "akamai-guardicore-centra/centra-v4-api.star",
  "description": "Centra returns assets whose first_seen the script cannot turn into a time: the key is absent entirely, present but null, or carries a format neither timestamp regex reads. parse_centra_ts answers None for all three, and `or ''` turned that into an empty string that was passed unconditionally as ImportAsset(first_seen_ts=...) -- which takes only a time object or None and ABORTS the whole run on anything else with 'first_seen_ts must be a time object'. The blast radius is the page, not the row: 0301 is built before 0302 on the same page and report_assets is only reached after the loop finishes, so the well-formed asset is lost along with the malformed one. All four assets must import, and the three unreadable timestamps must leave firstSeenTS unset rather than defaulted -- while 0301 keeps its own (1767600900 = 2026-01-05T08:15:00Z), so a 'fix' that simply stopped passing first_seen_ts for everyone fails here too. The unreadable format is logged rather than guessed at. namespaced_ids is skipped because the script uses Centra's own asset guid as the foreign id, unscoped, exactly as the happy and degraded scenarios do -- that is a separate identity concern, not this one.",
  "kwargs": {
    "url": "$BASE",
    "username": "fixture-user",
    "password": "fixture-password"
  },
  "routes": [
    {
      "name": "auth",
      "match": {"method": "POST", "path": "/api/v3.0/authenticate"},
      "responses": [{"status": 200, "json": {"access_token": "fixture-centra-token", "2fa_required": false}}],
      "when_exhausted": "repeat_last"
    },
    {
      "name": "assets-on",
      "match": {"method": "GET", "path": "/api/v4.0/assets", "query_contains": "status=on"},
      "responses": [
        {
          "status": 200,
          "json": {
            "total_count": 3,
            "objects": [
              {
                "id": "asset-guid-0301",
                "name": "syn-centra-301",
                "status": "on",
                "asset_type": "Server",
                "first_seen": "2026-01-05 08:15:00",
                "last_seen": "2026-08-01 09:00:00",
                "os_info": {"type": "Linux", "full_kernel_version": "5.15.0-105-generic"},
                "agent": {"id": "agent-0301", "agent_version": "5.2.0", "agent_last_seen": "2026-08-01 09:05:00"},
                "nics": [{"mac_address": "00:50:56:00:c3:01", "ip_addresses": ["192.0.2.21"]}]
              },
              {
                "id": "asset-guid-0302",
                "name": "syn-centra-302",
                "status": "on",
                "asset_type": "Server",
                "last_seen": "2026-08-02 09:00:00",
                "os_info": {"type": "Windows"},
                "agent": {"id": "agent-0302", "agent_version": "5.2.0", "agent_last_seen": "2026-08-02 09:05:00"},
                "nics": [{"mac_address": "00:50:56:00:c3:02", "ip_addresses": ["192.0.2.22"]}]
              },
              {
                "id": "asset-guid-0303",
                "name": "syn-centra-303",
                "status": "on",
                "asset_type": "Server",
                "first_seen": null,
                "last_seen": "2026-08-03 09:00:00",
                "os_info": {"type": "Linux"},
                "agent": {"id": "agent-0303", "agent_version": "5.2.0"},
                "nics": [{"mac_address": "00:50:56:00:c3:03", "ip_addresses": ["192.0.2.23"]}]
              }
            ]
          }
        }
      ],
      "when_exhausted": "repeat_last"
    },
    {
      "name": "assets-off",
      "match": {"method": "GET", "path": "/api/v4.0/assets", "query_contains": "status=off"},
      "responses": [
        {
          "status": 200,
          "json": {
            "total_count": 1,
            "objects": [
              {
                "id": "asset-guid-0304",
                "name": "syn-centra-304",
                "status": "off",
                "asset_type": "Server",
                "first_seen": "05/01/2026 08:15",
                "last_seen": "2026-08-04 09:00:00",
                "os_info": {"type": "Linux"},
                "agent": {"id": "agent-0304", "agent_version": "5.2.0"},
                "nics": [{"mac_address": "00:50:56:00:c3:04", "ip_addresses": ["192.0.2.24"]}]
              }
            ]
          }
        }
      ],
      "when_exhausted": "repeat_last"
    }
  ],
  "expect": {
    "asset_count": 4,
    "ids": [
      "asset-guid-0301",
      "asset-guid-0302",
      "asset-guid-0303",
      "asset-guid-0304"
    ],
    "assets": [
      {
        "id": "asset-guid-0301",
        "fields": {
          "hostnames": "syn-centra-301",
          "ipAddresses": "192.0.2.21",
          "firstSeenTS": "1767600900"
        }
      },
      {
        "id": "asset-guid-0302",
        "fields": {
          "hostnames": "syn-centra-302",
          "ipAddresses": "192.0.2.22",
          "macAddresses": "00:50:56:00:c3:02"
        },
        "fields_absent": ["firstSeenTS"]
      },
      {
        "id": "asset-guid-0303",
        "fields": {
          "hostnames": "syn-centra-303",
          "ipAddresses": "192.0.2.23"
        },
        "fields_absent": ["firstSeenTS"]
      },
      {
        "id": "asset-guid-0304",
        "fields": {
          "hostnames": "syn-centra-304",
          "ipAddresses": "192.0.2.24"
        },
        "fields_absent": ["firstSeenTS"]
      }
    ],
    "log_contains": [
      "centra-v4: unrecognized timestamp, leaving it unset: 05/01/2026 08:15"
    ],
    "request_count": 3
  },
  "invariants": {
    "skip": ["namespaced_ids"]
  }
}
