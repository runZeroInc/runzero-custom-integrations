{
  "name": "malformed",
  "integration": "akamai-guardicore-centra",
  "script": "akamai-guardicore-centra/centra-v4-api.star",
  "description": "A page mixing a fully-agented asset with an agentless asset whose agent, os_info, nics, scoping_details, labels, label_groups, orchestration_metadata, and orchestration_details are all present-but-null -- the shape that used to abort the entire task with 'NoneType has no .get' (verified against the real scanner; every earlier fixture spelled agentless as an ABSENT agent key, the one shape that did not fail). It also carries a bare string row, a null row, a non-dict NIC member, and a non-dict label_groups member, all of which must be skipped or preserved without aborting. namespaced_ids is skipped for the reason recorded in the other scenarios: the id is the bare Centra asset guid.",
  "kwargs": {
    "url": "$BASE",
    "username": "fixture-user",
    "password": "fixture-password"
  },
  "routes": [
    {
      "name": "auth",
      "match": {"method": "POST", "path": "/api/v3.0/authenticate"},
      "responses": [{"status": 200, "json": {"access_token": "fixture-centra-token", "2fa_required": false}}],
      "when_exhausted": "repeat_last"
    },
    {
      "name": "assets-on",
      "match": {"method": "GET", "path": "/api/v4.0/assets", "query_contains": "status=on"},
      "responses": [
        {
          "status": 200,
          "json": {
            "total_count": 2,
            "objects": [
              {
                "id": "asset-guid-0601",
                "name": "syn-centra-601",
                "status": "on",
                "asset_type": "Server",
                "first_seen": "2026-01-05 08:15:00",
                "last_seen": "2026-08-01 09:00:00",
                "agent": {"id": "agent-0601", "agent_version": "5.2.0", "agent_last_seen": "2026-08-01 09:00:00"},
                "os_info": {"type": "Linux", "full_kernel_version": "5.15.0"},
                "label_groups": [{"name": "prod"}, "stray-group-string"],
                "nics": [
                  {"mac_address": "00:50:56:00:c6:01", "ip_addresses": ["198.51.100.61"]},
                  "not-a-nic-object"
                ]
              },
              {
                "id": "asset-guid-0602",
                "name": "syn-centra-602-agentless",
                "status": "on",
                "first_seen": null,
                "last_seen": null,
                "agent": null,
                "os_info": null,
                "nics": null,
                "scoping_details": null,
                "labels": null,
                "label_groups": null,
                "orchestration_metadata": null,
                "orchestration_details": null
              },
              "this row is a string, not an asset object",
              null
            ]
          }
        }
      ],
      "when_exhausted": "repeat_last"
    },
    {
      "name": "assets-off",
      "match": {"method": "GET", "path": "/api/v4.0/assets", "query_contains": "status=off"},
      "responses": [{"status": 200, "json": {"total_count": 0, "objects": []}}],
      "when_exhausted": "repeat_last"
    }
  ],
  "expect": {
    "asset_count": 2,
    "ids": ["asset-guid-0601", "asset-guid-0602"],
    "assets": [
      {
        "id": "asset-guid-0601",
        "fields": {
          "ipAddresses": "198.51.100.61",
          "macAddresses": "00:50:56:00:c6:01",
          "deviceType": "Server"
        }
      },
      {
        "id": "asset-guid-0602",
        "fields": {"hostnames": "syn-centra-602-agentless"},
        "fields_absent": ["ipAddresses", "macAddresses", "deviceType"]
      }
    ],
    "log_contains": [
      "centra-v4: skipping non-dict asset record: string",
      "centra-v4: skipping non-dict asset record: NoneType"
    ],
    "request_count": 3
  },
  "invariants": {
    "skip": ["namespaced_ids"]
  }
}
