{
  "name": "identity-stability",
  "integration": "cisco-cyber-vision",
  "description": "The regression test for an id built out of something mutable.\n\nThe first two devices are the case that decided it. Identical machine skids are the normal state of an OT plant, so eeee0001 and eeee0002 carry the same label and the same address on two isolated cells behind one Center. An id derived from the name or the address would fold them into one asset; the Center-allocated UUID keeps them apart, and both survive as separate assets here.\n\nThe third device is the same PLC after an operator renamed it and the cell was readdressed: label and customLabel now differ from originalLabel, and the address is in a different subnet from the one the device was discovered on. Cyber Vision keeps originalLabel and customLabel separate from label precisely so a rename does not disturb identity, and the emitted id contains none of the three, nor the address.\n\nids_absent names each id this could have been built from instead -- the address, the name, the MAC, the bare unnamespaced UUID, and the UUID scoped on host:port. The last one matters operationally as well as here: an id carrying the port would re-key the entire estate the day someone puts the Center behind a different one, and it is also what the determinism re-run would catch, since that run binds a new ephemeral port.",
  "kwargs": {
    "url": "$BASE",
    "api_token": "fixture-token",
    "collect_vulnerabilities": "false",
    "page_size": "500"
  },
  "routes": [
    {
      "name": "devices",
      "match": {"method": "GET", "path": "/api/3.0/devices"},
      "responses": [
        {
          "status": 200,
          "json": [
            {
              "id": "eeee0001-0000-4000-8000-000000000001",
              "label": "Cell5-PLC-01",
              "originalLabel": "Cell5-PLC-01",
              "ip": "10.24.0.11",
              "mac": "00:1d:9c:55:00:11",
              "isDevice": true,
              "vulnerabilitiesCount": 0,
              "group": {"label": "Skid A"}
            },
            {
              "id": "eeee0002-0000-4000-8000-000000000002",
              "label": "Cell5-PLC-01",
              "originalLabel": "Cell5-PLC-01",
              "ip": "10.24.0.11",
              "mac": "00:1d:9c:55:00:22",
              "isDevice": true,
              "vulnerabilitiesCount": 0,
              "group": {"label": "Skid B"}
            },
            {
              "id": "eeee0003-0000-4000-8000-000000000003",
              "label": "Cell5-Drive-03-renamed",
              "originalLabel": "Cell5-Drive-03",
              "customLabel": "Cell5-Drive-03-renamed",
              "ip": "10.99.7.7",
              "mac": "00:1d:9c:55:00:33",
              "isDevice": true,
              "vulnerabilitiesCount": 0
            }
          ]
        }
      ],
      "when_exhausted": "empty"
    }
  ],
  "expect": {
    "asset_count": 3,
    "ids": [
      "cisco-cyber-vision:$HOST:eeee0001-0000-4000-8000-000000000001",
      "cisco-cyber-vision:$HOST:eeee0002-0000-4000-8000-000000000002",
      "cisco-cyber-vision:$HOST:eeee0003-0000-4000-8000-000000000003"
    ],
    "ids_absent": [
      "cisco-cyber-vision:$HOST:10.24.0.11",
      "cisco-cyber-vision:$HOST:Cell5-PLC-01",
      "cisco-cyber-vision:$HOST:00:1d:9c:55:00:11",
      "cisco-cyber-vision:$HOST:Cell5-Drive-03",
      "cisco-cyber-vision:$HOST:10.99.7.7",
      "cisco-cyber-vision:$BASE_HOST:eeee0001-0000-4000-8000-000000000001",
      "eeee0001-0000-4000-8000-000000000001"
    ],
    "assets": [
      {
        "id": "cisco-cyber-vision:$HOST:eeee0001-0000-4000-8000-000000000001",
        "fields": {
          "hostnames": "Cell5-PLC-01",
          "macAddresses": "00:1d:9c:55:00:11",
          "tags": "group:Skid A"
        }
      },
      {
        "id": "cisco-cyber-vision:$HOST:eeee0002-0000-4000-8000-000000000002",
        "fields": {
          "hostnames": "Cell5-PLC-01",
          "macAddresses": "00:1d:9c:55:00:22",
          "tags": "group:Skid B"
        }
      },
      {
        "id": "cisco-cyber-vision:$HOST:eeee0003-0000-4000-8000-000000000003",
        "fields": {
          "hostnames": "Cell5-Drive-03\tCell5-Drive-03-renamed",
          "ipAddresses": "10.99.7.7",
          "cisco_cyber_vision_original_label": "Cell5-Drive-03",
          "cisco_cyber_vision_custom_label": "Cell5-Drive-03-renamed"
        }
      }
    ],
    "log_contains": ["cisco-cyber-vision: reported 3 devices"]
  },
  "check_determinism": true
}
