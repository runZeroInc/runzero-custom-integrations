              }
            ]
          }
        }
      ],
      "when_exhausted": "repeat_last"
    }
  ],
  "expect": {
    "ids": [
      "forescout-rem:$HOST:rem-zero-01",
      "forescout-rem:$HOST:rem-zero-02",
      "forescout-rem:$HOST:rem-zero-03",
      "forescout-rem:$HOST:rem-zero-04"
    ],
    "requests_include": [
      {
        "query_contains": "order_by=risk_score"
      }
    ],
    "log_contains": [
      "narrowing it on time"
    ]
  },
  "check_determinism": true
}
