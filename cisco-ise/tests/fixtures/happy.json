{
  "name": "happy",
  "integration": "cisco-ise",
  "description": "Four ISE ActiveList sessions. Proves the XML session extractor runs to completion (the script used to abort on an invalid network_interface keyword), that a session carrying a MAC and an IP becomes an asset, and that two sessions belonging to the same RADIUS user stay two assets rather than collapsing into one. The two same-user rows are alice/AF3C1D2E and alice/AF3C1D30; a build that imported user_name as a hostname would give both the hostname 'alice' and merge the two endpoints in the platform. Note: the harness `expect` block cannot assert hostnames, so the 'plain username contributes no hostname' half of that rule is asserted here only through the asset count and the distinct ids; see identity-machine-auth for the host/ prefix case.",
  "kwargs": {
    "url": "$BASE",
    "basic_auth_credential": "Zml4dHVyZS11c2VyOmZpeHR1cmUtcGFzcw=="
  },
  "routes": [
    {
      "name": "active-session-list",
      "match": {"method": "GET", "path": "/admin/API/mnt/Session/ActiveList"},
      "responses": [
        {
          "status": 200,
          "headers": {"Content-Type": "application/xml"},
          "text": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<sessionParameters>\n<noOfActiveSession>4</noOfActiveSession>\n<activeSession>\n<user_name>alice</user_name>\n<calling_station_id>00:11:22:33:44:55</calling_station_id>\n<nas_ip_address>10.20.0.1</nas_ip_address>\n<acct_session_id>0000A1B2/00:11:22:33:44:55/1201</acct_session_id>\n<audit_session_id>0A14000100000012AF3C1D2E</audit_session_id>\n<server>ise-psn-01</server>\n<framed_ip_address>10.20.4.55</framed_ip_address>\n<device_ip_address>10.20.4.55</device_ip_address>\n</activeSession>\n<activeSession>\n<user_name>host/WKS-042</user_name>\n<calling_station_id>00:11:22:33:44:66</calling_station_id>\n<nas_ip_address>10.20.0.1</nas_ip_address>\n<acct_session_id>0000A1B3/00:11:22:33:44:66/1202</acct_session_id>\n<audit_session_id>0A14000100000013AF3C1D2F</audit_session_id>\n<server>ise-psn-01</server>\n<framed_ip_address>10.20.4.66</framed_ip_address>\n<device_ip_address>10.20.4.66</device_ip_address>\n</activeSession>\n<activeSession>\n<user_name>alice</user_name>\n<calling_station_id>00:11:22:33:44:77</calling_station_id>\n<nas_ip_address>10.20.0.2</nas_ip_address>\n<acct_session_id>0000A1B4/00:11:22:33:44:77/1203</acct_session_id>\n<audit_session_id>0A14000200000014AF3C1D30</audit_session_id>\n<server>ise-psn-02</server>\n<framed_ip_address>10.20.5.77</framed_ip_address>\n<device_ip_address>10.20.5.77</device_ip_address>\n</activeSession>\n<activeSession>\n<user_name>00-11-22-33-44-88</user_name>\n<calling_station_id>00:11:22:33:44:88</calling_station_id>\n<nas_ip_address>10.20.0.2</nas_ip_address>\n<acct_session_id>0000A1B5/00:11:22:33:44:88/1204</acct_session_id>\n<audit_session_id>0A14000200000015AF3C1D31</audit_session_id>\n<server>ise-psn-02</server>\n<framed_ip_address>10.20.5.88</framed_ip_address>\n<device_ip_address>10.20.5.88</device_ip_address>\n</activeSession>\n</sessionParameters>\n"
        }
      ],
      "when_exhausted": "repeat_last"
    }
  ],
  "expect": {
    "asset_count": 4,
    "ids": [
      "0A14000100000012AF3C1D2E",
      "0A14000100000013AF3C1D2F",
      "0A14000200000014AF3C1D30",
      "0A14000200000015AF3C1D31"
    ],
    "request_count": 1,
    "requests_include": [
      {"method": "GET", "path": "/admin/API/mnt/Session/ActiveList"},
      {"header_contains": "Basic Zml4dHVyZS11c2VyOmZpeHR1cmUtcGFzcw=="}
    ],
    "log_contains": ["Total number of sessions: 4"]
  },
  "invariants": {
    "skip": ["namespaced_ids"]
  }
