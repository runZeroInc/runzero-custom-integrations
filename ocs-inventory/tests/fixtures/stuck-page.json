{
 "name": "stuck-page",
 "integration": "ocs-inventory",
 "description": "A server whose computers route ignores `start` and answers every request with the identical full page of 50 -- what a misrouted rewrite rule or a caching proxy produces. The walk's natural exits are an empty page and a short page, and a replayed full page is neither, so without a repeated-page guard the loop would re-import the same 50 computers until the 1M-page pager backstop raised. The guard compares the page's key set to the previous page and must stop on the first replay, BEFORE reporting, so the 50 computers come out exactly once (unique_ids is the other half of this lock). Software enrichment is disabled to keep the scenario about the paging.",
 "kwargs": {
  "url": "$BASE",
  "include_software": "false"
 },
