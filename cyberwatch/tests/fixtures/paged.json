{
  "name": "paged",
  "integration": "cyberwatch",
  "description": "Three-page walk with details off. Cyberwatch publishes its result count only in response headers, which get_json does not expose, so paging must stop on the first SHORT page and the page size must be learned from the first response rather than assumed to be the requested per_page. Asserts each successive call carries the next page number and the category filter, and that no fourth page is requested after the short third page.",
  "kwargs": {
    "url": "$BASE",
    "api_access_key": "fixture-access",
    "api_secret_key": "fixture-secret",
    "include_details": "false",
    "category": "industrial_device"
  },
  "routes": [
    {
      "name": "server-list",
      "match": {"method": "GET", "path": "/api/v3/vulnerabilities/servers"},
      "responses": [
        {
          "status": 200,
          "json": [
            {"id": 301, "hostname": "plc-301", "category": "industrial_device", "created_at": "2025-05-01T00:00:00.000Z", "last_communication": "2026-08-10T00:00:00.000Z", "addresses": ["10.80.1.1"], "os": {"name": "VxWorks 6.9"}},
            {"id": 302, "hostname": "plc-302", "category": "industrial_device", "created_at": "2025-05-01T00:00:00.000Z", "last_communication": "2026-08-10T00:00:00.000Z", "addresses": ["10.80.1.2"], "os": {"name": "VxWorks 6.9"}}
          ]
        },
        {
          "status": 200,
          "json": [
            {"id": 303, "hostname": "plc-303", "category": "industrial_device", "created_at": "2025-05-01T00:00:00.000Z", "last_communication": "2026-08-10T00:00:00.000Z", "addresses": ["10.80.1.3"], "os": {"name": "VxWorks 6.9"}},
            {"id": 304, "hostname": "plc-304", "category": "industrial_device", "created_at": "2025-05-01T00:00:00.000Z", "last_communication": "2026-08-10T00:00:00.000Z", "addresses": ["10.80.1.4"], "os": {"name": "VxWorks 6.9"}}
          ]
        },
        {
          "status": 200,
          "json": [
            {"id": 305, "hostname": "plc-305", "category": "industrial_device", "created_at": "2025-05-01T00:00:00.000Z", "last_communication": "2026-08-10T00:00:00.000Z", "addresses": ["10.80.1.5"], "os": {"name": "VxWorks 6.9"}}
          ]
        }
      ],
      "when_exhausted": "error"
    }
  ],
  "expect": {
    "asset_count": 5,
    "ids": [
      "cyberwatch:127.0.0.1:301",
      "cyberwatch:127.0.0.1:303",
      "cyberwatch:127.0.0.1:305"
    ],
    "request_count": 3,
    "requests_include": [
      {"method": "GET", "query_contains": "page=1"},
      {"method": "GET", "query_contains": "page=2"},
      {"method": "GET", "query_contains": "page=3"},
      {"method": "GET", "query_contains": "category=industrial_device"}
    ],
    "requests_absent": [
      {"query_contains": "page=4"},
      {"path_contains": "/api/v3/assets/servers/"}
    ],
    "log_contains": [
      "reported 5 assets"
    ]
  },
  "invariants": {
    "skip": []
  }
}
