{
  "name": "hidden-with-lookback",
  "integration": "tenable-ot-security",
  "description": "Both filters at once, server-side. ExprOp publishes And alongside Or, and AssetExpressionsParams documents `expressions: [AssetExpressionsParams!]` as 'List of expressions, Must be applied when using [And/Or] operators', so there is no reason to make the console choose between pyTenable's hidden equality and Elastic's Or over lastUpdate/firstSeen. Before this the two were mutually exclusive and a lookback silently forfeited server-side hidden filtering, which means the console assembled and transferred every suppressed asset in the window for the script to throw away on arrival -- the expensive half of the work done twice for nothing. The request body is asserted structurally rather than by keyword: the first substring pins one And at the top level whose FIRST expression is the hidden equality, and the second pins the Or closing inside that same And, so a flattened filter, a second And, or a top-level Or all fail. Only the cutoff timestamp is left out of the match, because it moves with the clock. The client-side drop stays as a guard whatever the console does with the filter, which is why `hidden` is still selected and why this fixture serves a hidden asset the server-side filter should have excluded: HIDDEN-LEFTOVER must not reach runZero even though the fixture server ignores the filter entirely.",
  "kwargs": {
    "url": "$BASE",
    "api_key": "fixture-api-key",
    "page_size": "200",
    "lookback_days": "30",
    "include_hidden": "false",
    "import_vulnerabilities": "false",
    "import_software": "false",
    "import_services": "false"
  },
  "routes": [
    {
      "name": "assets",
      "match": {
        "method": "POST",
        "path": "/graphql",
        "body_contains": "getAssets"
      },
      "responses": [
        {
          "status": 200,
          "json": {
            "data": {
              "assets": {
                "nodes": [
                  {
                    "id": "a5a5a5a5-0001-4001-8001-000000000001",
                    "name": "PLC-RECENT-01",
                    "type": "Plc",
                    "superType": "Controller",
                    "purdueLevel": "Level1",
                    "criticality": "HighCriticality",
                    "hidden": false,
                    "lastSeen": "2026-08-25T06:00:00Z",
                    "lastUpdate": "2026-08-25T06:00:04Z",
                    "macs": {"nodes": ["00:1d:9c:bb:00:01"]},
                    "ips": {"nodes": ["10.160.9.1"]},
                    "directMacs": {"nodes": ["00:1d:9c:bb:00:01"]},
                    "directIps": {"nodes": ["10.160.9.1"]},
                    "directNetworkInterfaces": {"nodes": []},
                    "segments": {"nodes": []},
                    "osDetails": null,
                    "plugins": {"nodes": []}
                  },
                  {
                    "id": "a5a5a5a5-0002-4002-8002-000000000002",
                    "name": "HIDDEN-LEFTOVER",
                    "type": "OtDevice",
                    "superType": "OtDevice",
                    "hidden": true,
                    "lastSeen": "2026-08-25T06:05:00Z",
                    "lastUpdate": "2026-08-25T06:05:02Z",
                    "macs": {"nodes": ["00:1d:9c:bb:00:02"]},
                    "ips": {"nodes": ["10.160.9.2"]},
                    "directMacs": {"nodes": ["00:1d:9c:bb:00:02"]},
                    "directIps": {"nodes": ["10.160.9.2"]},
                    "directNetworkInterfaces": {"nodes": []},
                    "segments": {"nodes": []},
                    "osDetails": null,
                    "plugins": {"nodes": []}
                  }
                ],
                "pageInfo": {"hasNextPage": false, "endCursor": null}
              }
            }
          }
        }
      ],
      "when_exhausted": "error"
    }
  ],
  "expect": {
    "asset_count": 1,
    "request_count": 1,
    "ids": [
      "tenable-ot-security:$HOST:a5a5a5a5-0001-4001-8001-000000000001"
    ],
    "ids_absent": [
      "tenable-ot-security:$HOST:a5a5a5a5-0002-4002-8002-000000000002"
    ],
    "requests_include": [
      {
        "method": "POST",
        "path": "/graphql",
        "body_contains": "\"filter\":{\"expressions\":[{\"field\":\"hidden\",\"op\":\"Equal\",\"values\":\"false\"},{\"expressions\":[{\"field\":\"lastUpdate\",\"op\":\"GreaterEqual\",\"values\":\""
      },
      {
        "body_contains": "\"field\":\"firstSeen\",\"op\":\"GreaterEqual\""
      },
      {
        "body_contains": "}],\"op\":\"Or\"}],\"op\":\"And\"}"
      }
    ],
    "log_contains": [
      "tenable-ot-security: excluded 1 hidden assets",
      "tenable-ot-security: reported 1 assets"
    ]
  },
  "check_determinism": true
}
