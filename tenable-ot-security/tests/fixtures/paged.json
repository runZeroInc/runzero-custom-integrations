{
  "name": "paged",
  "integration": "tenable-ot-security",
  "description": "Relay-style forward cursor paging. Page one reports hasNextPage true with endCursor YXNzZXRzOjE5OQ==, and the only route that can serve page two matches on that exact cursor value appearing in the request body, so a walk that dropped or re-invented the `after` variable would starve on an unrouted document. This scenario runs lookback_days=30 with include_hidden=false, which now produces a single And wrapping the hidden equality and the lastUpdate/firstSeen Or rather than the Or alone; the structural assertion on that filter lives in hidden-with-lookback, and the GreaterEqual match here still pins the lookback half of it. Page two reports hasNextPage false, which is the documented termination condition -- Elastic's CEL program keeps paging on exactly body.data.assets.pageInfo.hasNextPage -- and page three's route asserts that no third request is made even though page two still publishes an endCursor. The lookback window is on, so this also proves the Or expression over lastUpdate and firstSeen is sent instead of the hidden filter.",
  "kwargs": {
    "url": "$BASE",
    "api_key": "fixture-api-key",
    "page_size": "2",
    "lookback_days": "30",
    "include_hidden": "false",
    "import_vulnerabilities": "false",
    "import_software": "false"
  },
  "routes": [
    {
      "name": "assets-page-2",
      "match": {
        "method": "POST",
        "path": "/graphql",
        "body_contains": "YXNzZXRzOjE5OQ=="
      },
      "responses": [
        {
          "status": 200,
          "json": {
            "data": {
              "assets": {
                "nodes": [
                  {
                    "id": "3c9d0f11-6b2a-4e55-9d07-8a1c2b3d4e5f",
                    "name": "paged-plc-03",
                    "type": "Plc",
                    "superType": "Controller",
                    "category": "ControllersCategory",
                    "purdueLevel": "Level1",
                    "criticality": "LowCriticality",
                    "hidden": false,
                    "lastSeen": "2026-08-21T09:00:00Z",
                    "macs": {
                      "nodes": [
                        "00:1d:9c:aa:00:03"
                      ]
                    },
                    "ips": {
                      "nodes": [
                        "10.120.3.3"
                      ]
                    },
                    "directMacs": {
                      "nodes": [
                        "00:1d:9c:aa:00:03"
                      ]
                    },
                    "directIps": {
                      "nodes": [
                        "10.120.3.3"
                      ]
                    },
                    "segments": {
                      "nodes": []
                    },
                    "risk": {
                      "totalRisk": "12.5"
                    }
                  }
                ],
                "pageInfo": {
                  "hasNextPage": false,
                  "endCursor": "YXNzZXRzOjI5OQ=="
                }
              }
            }
          }
        }
      ],
      "when_exhausted": "error"
    },
    {
      "name": "assets-page-3-must-not-be-requested",
      "match": {
        "method": "POST",
        "path": "/graphql",
        "body_contains": "YXNzZXRzOjI5OQ=="
      },
      "responses": [
        {
          "status": 500,
          "json": {
            "errors": [
              {
                "message": "page three must never be requested"
              }
            ]
          }
        }
      ],
      "when_exhausted": "repeat_last"
    },
    {
      "name": "assets-page-1",
      "match": {
