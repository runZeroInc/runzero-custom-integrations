{
  "name": "empty",
  "integration": "opnsense",
  "description": "A freshly installed firewall with an empty ARP cache, an empty NDP table, and no DHCP backend installed at all. The run must still import the firewall itself and report zero discovered hosts rather than failing. This is the degrade-gracefully path OPNsense makes unavoidable: ISC dhcpd never had a lease API, and an install that has not moved to Kea or dnsmasq answers 404 on both. The asserted MAC is 50:54:00:aa:bb:cc where the fixture supplies 52:54:00:aa:bb:cc, which is not a typo: 0x52 is the QEMU/KVM prefix and carries the locally administered bit, and network_interface clears that bit deliberately so the same NIC matches across sources. That is correct for an interface and is exactly why this integration never builds an id through network_interface.",
  "kwargs": {
    "url": "$BASE",
    "api_key": "fixture-key",
    "api_secret": "fixture-secret"
  },
  "routes": [
    {
      "name": "system-information",
      "match": {"method": "GET", "path": "/api/diagnostics/system/systemInformation"},
      "responses": [
        {"status": 200, "json": {"name": "fw03.example.com", "versions": ["OPNsense 25.1.5_4-amd64"], "updates": ""}}
      ],
      "when_exhausted": "repeat_last"
    },
    {
      "name": "interface-config",
      "match": {"method": "GET", "path": "/api/diagnostics/interface/getInterfaceConfig"},
      "responses": [
        {
          "status": 200,
          "json": {
            "vtnet0": {
              "device": "vtnet0",
              "macaddr": "52:54:00:aa:bb:cc",
              "is_physical": true,
              "status": "active",
              "ipv4": [{"ipaddr": "198.51.100.30", "subnetbits": 24, "tunnel": false}],
              "ipv6": []
            }
          }
        }
      ],
      "when_exhausted": "repeat_last"
    },
    {
      "name": "arp",
      "match": {"method": "GET", "path": "/api/diagnostics/interface/getArp"},
      "responses": [{"status": 200, "json": []}],
      "when_exhausted": "repeat_last"
    },
    {
      "name": "ndp",
      "match": {"method": "GET", "path": "/api/diagnostics/interface/getNdp"},
      "responses": [{"status": 200, "json": []}],
      "when_exhausted": "repeat_last"
    }
  ],
  "default_response": {"status": 404, "text": "plugin not installed"},
  "expect": {
    "asset_count": 1,
    "ids": ["opnsense:$HOST:appliance"],
    "assets": [
      {
        "id": "opnsense:$HOST:appliance",
        "fields": {
          "deviceType": "Firewall",
          "os": "OPNsense",
          "osVersion": "25.1.5_4",
          "hostnames": "fw03",
          "ipAddresses": "198.51.100.30",
          "macAddresses": "50:54:00:aa:bb:cc"
        }
      }
    ],
    "requests_include": [
      {"method": "POST", "path_contains": "/api/kea/leases4/search"},
      {"method": "POST", "path_contains": "/api/dnsmasq/leases/search"}
    ],
    "log_contains": [
      "no DHCP lease backend answered",
      "reported 1 firewall and 0 discovered hosts"
    ]
  },
  "check_determinism": true
}
