{
  "name": "rate-limit",
  "integration": "maze-security",
  "description": "The first search is answered 429 and the retry succeeds. Proves the run does not abandon the page on a throttle -- post_json retries three times by default, so no hand-rolled backoff is needed and the asset still lands.\n\nnamespaced_ids is skipped: Maze ids are bare vendor strings with no tenant scope.",
  "kwargs": {
    "url": "$BASE",
    "api_key": "fixture-key"
  },
  "routes": [
    {
      "name": "investigations-search",
      "match": {"method": "POST", "path": "/v1/investigations/search"},
      "responses": [
        {"status": 429, "headers": {"Retry-After": "1"}, "json": {"error": "rate limit exceeded"}},
        {
          "status": 200,
          "json": {
            "has_more": false,
            "data": [
              {
                "id": "inv-after-throttle",
                "cve_id": "CVE-2025-60001",
                "maze_severity": "HIGH",
                "exploitability": "exploitable",
                "scanner_finding_hash": "fixture-scanner::CVE-2025-60001::throttled.corp.example.com",
                "snapshot": {"cvss": {"base_score": 7.2, "version": "3.1"}}
              }
            ]
          }
        }
      ],
      "when_exhausted": "error"
    }
  ],
  "expect": {
    "asset_count": 1,
    "ids": ["throttled.corp.example.com"],
    "min_vulnerabilities_total": 1,
    "min_requests": 2,
    "log_contains": ["Reported 1 assets from 1 investigations"]
  },
  "invariants": {"skip": ["namespaced_ids"]}
}
