{
  "name": "legacy-credentials",
  "integration": "audit-events-to-webhook",
  "script": "audit-events-to-webhook/audit-events-to-webhook.star",
  "description": "The documented back-compat path, which is the half of this script no other scenario reaches. Every named parameter is absent and a single JSON blob supplies all four settings, including the legacy key name `webhook_url` -- which the current CONFIG calls `dst_url`, so the fallback chain has to try both. The blob arrives as a STRING and is json_decode'd, then read with .get; a regression that dropped the `type(creds) == 'string'` branch, or that looked only for `dst_url`, would leave webhook_url empty and the script would return early on 'Missing destination webhook URL' with no POST at all. Asserting the POST lands on /hooks/legacy-endpoint with the legacy bearer proves the whole chain resolved from the blob and not from a default. Note that CONFIG `required` and `default` are console-side only -- they are not applied on the `script --kwargs` path -- which is exactly what lets this scenario omit rz_account_token as a named parameter and prove the legacy fallback really is what supplied it.",

  "kwargs": {
    "legacy_credentials": "{\"webhook_url\": \"$BASE/hooks/legacy-endpoint\", \"external_api_key\": \"legacy-webhook-key\", \"rz_account_token\": \"CT0000legacyaccounttoken0000\", \"src_url\": \"$BASE\"}"
  },

  "routes": [
    {
      "name": "account event log",
      "match": {"method": "GET", "path": "/api/v1.0/account/events.json"},
      "responses": [
        {
          "status": 200,
          "json": [
            {
              "id": "6c9f4053-2d71-4e0f-b244-50819daebf23",
              "created_at": 1755334000,
              "client_id": "11111111-2222-3333-4444-555555555555",
              "organization_id": "aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee",
              "site_id": "00000000-0000-0000-0000-000000000000",
              "action": "organization-export-token-created",
              "source_id": "c1d2e3f4-a5b6-4788-99aa-bbccddeeff00",
              "source_name": "jdoe@example.com",
              "source_type": "user",
              "target_id": "aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee",
              "target_name": "Primary",
              "target_type": "organization",
              "success": true,
              "details": {"ip": "203.0.113.24", "path": "/organizations", "method": "POST"},
              "state": "",
              "processor_id": "00000000-0000-0000-0000-000000000000",
              "processed_at": 0
            }
          ]
        }
      ]
    },
    {
      "name": "legacy destination webhook",
      "match": {"method": "POST", "path": "/hooks/legacy-endpoint"},
      "responses": [{"status": 200, "text": "ok"}]
    }
  ],

  "default_response": {"status": 404, "text": "no fixture route"},

  "expect": {
    "asset_count": 0,
    "request_count": 2,
    "requests_include": [
      {
        "method": "GET",
        "path": "/api/v1.0/account/events.json",
        "header_contains": "Bearer CT0000legacyaccounttoken0000"
      },
      {
        "method": "POST",
        "path": "/hooks/legacy-endpoint",
        "header": {"Authorization": "Bearer legacy-webhook-key"},
        "body_contains": "organization-export-token-created"
      }
    ],
    "requests_absent": [
      {"method": "POST", "path": "/"}
    ],
    "log_contains": [
      "Sending 1 events to Webhook",
      "Response code from Webhook: 200"
    ]
  }
}
