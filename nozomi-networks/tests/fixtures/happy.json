      "when_exhausted": "repeat_last"
    }
  ],
  "expect": {
    "asset_count": 3,
    "ids": [
      "nozomi-networks:$HOST:fixture-asset-0001",
      "nozomi-networks:$HOST:fixture-asset-0002",
      "nozomi-networks:$HOST:fixture-asset-0003"
    ],
    "request_count": 4,
    "requests_include": [
      {
        "method": "POST",
        "path": "/api/open/sign_in",
        "body_contains": "fixture-key-token"
      },
      {
        "method": "GET",
        "path": "/api/open/query/do",
        "query_contains": "count=1&page=1&query=asset_cves"
      },
      {
        "method": "GET",
        "path": "/api/open/query/do",
        "query_contains": "count=500&page=1&query=assets%20%7C%20sort%20id"
      },
      {
        "header_contains": "Bearer nozomi-fixture-token"
      }
    ],
    "log_contains": [
      "nozomi-networks: indexed 2 unresolved CVE findings across 2 assets",
      "nozomi-networks: skipping asset with no id: name=a row the appliance never assigned an id",
      "nozomi-networks: reported 3 assets"
    ],
    "min_software_total": 1,
    "assets": [
      {
        "id": "nozomi-networks:$HOST:fixture-asset-0001",
        "fields": {
