{
  "name": "happy",
  "integration": "nozomi-networks",
  "description": "Full Open API walk: sign_in returns the bearer token in the Authorization response header, the asset_cves table is probed and then indexed, and the assets query is parsed into assets with firmware software and CVE findings. Covers the scalar-instead-of-array collapse a projected query produces, the '-' not-determined placeholder, an assets row whose name is an address (which must not become a hostname), a resolved CVE (which must not be imported), and a row with no id. Asset 0002 proves two mappings at once: its name is an address so it must carry no hostname, and its vendor and product are the '-' placeholder so no manufacturer or model may be asserted. The a8:bb: MACs are the aa:bb: values with the locally administered bit cleared, which normalize_mac does deliberately.",
  "kwargs": {
    "url": "$BASE",
    "key_name": "fixture-key-name",
    "key_token": "fixture-key-token",
    "include_cves": "true"
  },
  "routes": [
    {
      "name": "sign-in",
      "match": {
        "method": "POST",
        "path": "/api/open/sign_in"
      },
      "responses": [
        {
          "status": 200,
          "json": {
            "authenticated": true
          },
          "headers": {
            "Authorization": "Bearer nozomi-fixture-token"
          }
        }
      ],
      "when_exhausted": "repeat_last"
    },
    {
      "name": "cve-probe",
      "match": {
        "method": "GET",
        "path": "/api/open/query/do",
        "query_contains": "count=1&"
      },
      "responses": [
        {
          "status": 200,
          "json": {
            "result": [
              {
                "id": "cve-row-1"
              }
            ],
            "total": 4,
            "error": null
          }
        }
      ],
      "when_exhausted": "repeat_last"
    },
    {
      "name": "asset-cves",
      "match": {
        "method": "GET",
        "path": "/api/open/query/do",
        "query_contains": "query=asset_cves"
      },
      "responses": [
        {
          "status": 200,
          "json": {
            "result": [
              {
                "id": "cve-row-1",
                "asset_id": "fixture-asset-0001",
                "cve": "CVE-2024-30001",
                "name": "Fixture stack overflow",
                "summary": "A synthetic overflow in fixture firmware.",
                "score": 9.8,
                "resolved": false,
                "is_kev": true,
                "latest_hotfix": "4.2.9",
                "minimum_hotfix": "4.2.7",
                "matching_cpes": [
                  "cpe:2.3:o:fixture:controller_firmware:4.2.1:*:*:*:*:*:*:*"
                ],
                "creation_time": 1710000000000,
                "time": 1750000000000,
                "update_time": 1755000000000,
                "epss_score": 0.42,
                "cwe_id": "CWE-121"
              },
              {
                "id": "cve-row-2",
                "asset_id": "fixture-asset-0002",
                "cve": "CVE-2023-30002",
                "score": "5.4",
                "resolved": "false",
                "is_kev": false
              },
              {
                "id": "cve-row-3",
                "asset_id": "fixture-asset-0001",
                "cve": "CVE-2022-30003",
                "score": 7.1,
                "resolved": true
              },
              {
                "id": "cve-row-4",
                "cve": "CVE-2021-30004",
                "score": 2.0,
                "resolved": false
              }
            ],
            "total": 4,
            "error": null
          }
        }
      ],
      "when_exhausted": "repeat_last"
    },
    {
      "name": "assets",
      "match": {
        "method": "GET",
        "path": "/api/open/query/do",
        "query_contains": "query=assets%20"
      },
      "responses": [
        {
          "status": 200,
          "json": {
            "result": [
              {
                "id": "fixture-asset-0001",
                "name": "plc-line-3",
                "ip": [
                  "10.100.0.10",
                  "10.100.0.11"
                ],
