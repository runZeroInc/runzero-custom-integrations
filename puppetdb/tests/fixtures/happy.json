  "expect": {
    "asset_count": 4,
    "ids": [
      "puppetdb:$HOST:web01.corp.example.com",
      "puppetdb:$HOST:db01.corp.example.com",
      "puppetdb:$HOST:legacy01.corp.example.com",
      "puppetdb:$HOST:nofacts.corp.example.com"
    ],
    "log_contains": [
      "skipping node with no certname",
      "indexed 20 active fact rows for 3 nodes",
      "reported 4 active nodes"
    ],
    "requests_include": [
      {
        "method": "GET",
        "path": "/pdb/query/v4/facts",
        "query_contains": "networking"
      },
      {
        "method": "GET",
        "path": "/pdb/query/v4/nodes",
        "query_contains": "order_by"
      },
      {
        "header": {
          "X-Authentication": "fixture-rbac-token"
        }
      }
    ],
    "requests_absent": [
      {
        "path_contains": "/package-inventory"
      }
    ],
    "assets": [
      {
        "id": "puppetdb:$HOST:web01.corp.example.com",
        "fields": {
          "ipAddresses": "10.80.0.11\t10.81.0.11\t2001:db8:80::11",
