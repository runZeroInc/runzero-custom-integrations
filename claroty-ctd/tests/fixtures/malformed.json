{
  "name": "malformed",
  "integration": "claroty-ctd",
  "description": "Junk in both payloads must be skipped without losing the run. On the asset side: a row whose resource_id is null (skipped and logged, because id alone is site-scoped and there is no safe fallback), a row that is a bare string rather than an object, a row whose ipv4 and mac arrive as scalars rather than the documented lists, and a row whose network and subnet objects arrive as strings. On the vulnerability side: cvss_v3_score and epss_score are documented as OBJECTS, so a build that sends a bare number for either must still parse; a lower-case cve_id must be upper-cased; a cve_id that misses the CVE-YYYY-NNNN shape must be carried as a plain name rather than assigned to the cve field, because the platform validates that field and rejects the WHOLE record on a miss; and a row with neither a resource_id nor a cve_id is dropped. no_placeholder_hostnames is skipped only in the sense that the scenario deliberately feeds 'unknown' and a bare IP as names and asserts they never reach the asset - the invariant itself still runs.",
  "kwargs": {
    "url": "$BASE",
    "username": "fixture-user",
    "password": "fixture-password",
    "include_vulnerabilities": "true",
    "last_updated_days": "0"
  },
  "routes": [
    {
      "name": "authenticate",
      "match": {"method": "POST", "path": "/auth/authenticate"},
      "responses": [{"status": 200, "json": {"token": "malformed-token", "password_expired": false}}],
      "when_exhausted": "error"
    },
    {
      "name": "asset-vulnerabilities",
      "match": {"method": "GET", "path": "/ranger/asset-vulnerabilities"},
      "responses": [
        {"status": 200, "json": {
          "count_filtered": 5,
          "count_in_page": 5,
          "count_total": 5,
          "objects": [
            {
              "resource_id": "801-1",
