{
  "name": "paged",
  "integration": "claroty-ctd",
  "description": "A two-page walk of both endpoints, driven by the response's own count rather than by page size. Every page here is SHORT - two rows against a per_page of 500 - which is the case that matters: no server-side per_page ceiling is documented for this API, so an appliance that clamps the requested page size would make every page look short. Stopping on a short page alone would then truncate the whole import to page one with no error, which is why the count still governs a short page and the short-page rule is only the fallback for a response carrying no usable count. Proves the second request carries page=2 and that the walk stops once the running count reaches the total instead of asking for a third page. The counts agree here; filtered-count is the scenario where they diverge and count_filtered is shown to be the one that binds. has_correlator is skipped: 33-1 is the address-less backplane card described in the happy scenario.",
  "kwargs": {
    "url": "$BASE",
    "username": "fixture-user",
    "password": "fixture-password",
    "include_vulnerabilities": "true",
    "last_updated_days": "0"
  },
  "routes": [
    {
      "name": "authenticate",
      "match": {"method": "POST", "path": "/auth/authenticate"},
      "responses": [{"status": 200, "json": {"token": "paged-token", "password_expired": false, "username": "admin"}}],
      "when_exhausted": "error"
    },
    {
      "name": "vulnerabilities-page-2",
      "match": {"method": "GET", "path": "/ranger/asset-vulnerabilities", "query_contains": "page=2"},
      "responses": [
        {"status": 200, "json": {
          "count_filtered": 3,
          "count_in_page": 1,
          "count_total": 3,
          "objects": [
            {
              "resource_id": "612-1",
              "asset_id": "202-1",
              "asset_name": "hmi-02",
              "cve_id": "CVE-2021-22779",
