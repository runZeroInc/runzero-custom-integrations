{
  "name": "happy",
  "integration": "netskope",
  "description": "One page of the clientstatus datasearch. Proves the groupbys/fields/offset/limit query is assembled and the token is sent BOTH as the documented Netskope-Api-Token header and as Authorization: Bearer (either server behavior authenticates), that a short page is followed by one more request that must answer empty before the walk ends (a server may cap pages below the requested limit, so a short page is not proof of the last page), that one interface is emitted per reported MAC, that a record with neither _id.nsdeviceuid nor device_id is skipped with a log line, and that a Mac osName is normalised to macOS. It also brackets the device-type hint: Netskope's own os enum separates 'Windows Server' (documented value 4) from 'Windows' (0), so app-srv-04 must come out typed Server even though its make and model are the VMware placeholders that tell runZero's hardware fingerprinter nothing, while the Windows laptop and the Mac must carry NO deviceType, because neither os says whether it is a desktop or a laptop. No netskope asset carries an address: the clientstatus event reports MACs and no IP, so an interface exists only where a MAC did. (The hardcoded ips = [\"127.0.0.1\"] that used to be built into every interface here is gone; the no-address scenario is its regression lock.) Skips namespaced_ids: netskope uses the bare nsdeviceuid as the foreign id, with no tenant scope, so two Netskope tenants imported into one runZero instance would collide -- see the report accompanying these fixtures.",
  "kwargs": {
    "url": "$BASE",
    "api_token": "fixture-netskope-token"
  },
  "routes": [
    {
      "name": "clientstatus",
      "match": {"method": "GET", "path": "/api/v2/events/datasearch/clientstatus"},
      "responses": [{
        "status": 200,
        "json": {
          "ok": 1,
          "status": 200,
          "result": [
            {
              "_id": {"nsdeviceuid": "NSDEV-0000-0000-0001"},
              "device_id": "DEV-0001",
              "hostname": "sales-mbp-01",
              "mac_addresses": ["3C:22:FB:11:22:33", "9E:44:55:66:77:88"],
              "device_make": "Apple",
              "device_model": "MacBook Pro 16-inch",
              "os": "Mac OS X",
              "os_version": "14.5",
              "serial_number": "C02FIXTURE0001",
              "ns_tenant_id": "fixture-tenant",
              "steering_config": "Default",
              "user_status": "ACTIVE",
              "usergroup": ["sales"],
              "groups": ["corp-managed"],
              "deleted": false,
              "timestamp": 1767398400
            },
            {
              "_id": {"nsdeviceuid": "NSDEV-0000-0000-0002"},
              "device_id": "DEV-0002",
              "hostname": "eng-win-02",
              "mac_addresses": [],
              "device_make": "Dell Inc.",
              "device_model": "Latitude 7440",
              "os": "Windows",
              "os_version": "11",
              "serial_number": "DLFIXTURE0002",
              "ns_tenant_id": "fixture-tenant",
              "user_status": "ACTIVE",
              "deleted": false,
              "timestamp": 1767398500
            },
            {
              "_id": {"nsdeviceuid": "NSDEV-0000-0000-0004"},
              "device_id": "DEV-0004",
              "hostname": "app-srv-04",
              "mac_addresses": ["00:50:56:AB:CD:01"],
              "device_make": "VMware, Inc.",
              "device_model": "VMware Virtual Platform",
              "os": "Windows Server",
              "os_version": "2019",
              "serial_number": "VMFIXTURE0004",
              "ns_tenant_id": "fixture-tenant",
              "user_status": "ACTIVE",
              "deleted": false,
              "timestamp": 1767398600
            },
            {
              "_id": {},
              "hostname": "no-identifier-03",
              "mac_addresses": ["00:1A:2B:3C:4D:5E"],
              "os": "Windows",
              "ns_tenant_id": "fixture-tenant"
            }
          ]
        }
      },
      {"status": 200, "json": {"ok": 1, "status": 200, "result": []}}],
      "when_exhausted": "error"
    }
  ],
  "expect": {
    "assets": [
      {
        "id": "NSDEV-0000-0000-0001",
        "fields": {"macAddresses": "3c:22:fb:11:22:33\t9c:44:55:66:77:88", "hostnames": "sales-mbp-01", "os": "macOS"},
        "fields_absent": ["ipAddresses", "deviceType"]
      },
      {
        "id": "NSDEV-0000-0000-0002",
        "fields": {"hostnames": "eng-win-02", "os": "Windows"},
        "fields_absent": ["ipAddresses", "macAddresses", "deviceType"]
      },
      {
        "id": "NSDEV-0000-0000-0004",
        "fields": {"hostnames": "app-srv-04", "os": "Windows Server", "deviceType": "Server"},
        "fields_absent": ["ipAddresses"]
      }
    ],
    "asset_count": 3,
    "ids": [
      "NSDEV-0000-0000-0001",
      "NSDEV-0000-0000-0002",
      "NSDEV-0000-0000-0004"
    ],
    "request_count": 2,
    "requests_include": [
      {"method": "GET", "path": "/api/v2/events/datasearch/clientstatus", "query_contains": "groupbys=nsdeviceuid"},
      {"query_contains": "offset=0"},
      {"query_contains": "offset=4"},
      {"query_contains": "limit=20000"},
      {"query_contains": "fields=client_version"},
      {"header": {"Netskope-Api-Token": "fixture-netskope-token"}},
      {"header": {"Authorization": "Bearer fixture-netskope-token"}}
    ],
    "log_contains": [
      "netskope: skipping record with no nsdeviceuid/device_id"
    ]
  },
  "invariants": {
    "skip": ["namespaced_ids"]
  }
}
