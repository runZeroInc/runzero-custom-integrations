              "affected_items": []
            }
          }
        }
      ],
      "when_exhausted": "repeat_last"
    }
  ],
  "expect": {
    "asset_count": 5,
    "assets": [
      {
        "id": "wazuh:$HOST:agent:101:20260401100000",
        "fields": {
          "hostnames": "win-srv-01",
          "deviceType": "Server"
        }
      },
      {
        "id": "wazuh:$HOST:agent:102:20260401100500",
        "fields": {
          "hostnames": "rhel-db-01",
          "deviceType": "Server"
        }
      },
      {
        "id": "wazuh:$HOST:agent:103:20260401101000",
