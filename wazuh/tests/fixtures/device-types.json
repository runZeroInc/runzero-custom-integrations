                  "version": "Wazuh v4.9.0",
                  "os": {
                    "name": "Ubuntu",
                    "platform": "ubuntu",
                    "version": "22.04.4 LTS"
                  }
                }
              ]
            }
          }
        }
      ],
      "when_exhausted": "error"
    },
    {
      "name": "agents-page-2-empty",
      "match": {
