    "request_count": 7,
    "requests_include": [
      {
        "method": "GET",
        "path": "/agents",
        "query_contains": "offset=0"
      },
      {
        "method": "GET",
        "path": "/agents",
        "query_contains": "offset=500"
      }
    ],
    "requests_absent": [
