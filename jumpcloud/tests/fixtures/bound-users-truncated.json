{
  "name": "bound-users-truncated",
  "integration": "jumpcloud",
  "description": "A host bound to a whole directory. The graph listing for the one system returns 51 bound users in a single page, one past the MAX_BOUND_USERS_LISTED cap of 50. The walk must stop at the cap AND mark the result as a floor: jumpcloud_bound_user_count reads 50+ and jumpcloud_bound_users_truncated is set, instead of the count silently reporting exactly 50 as if it were a total. The user directory is empty, so usernames fall back to the bound ObjectIDs.\n\nnamespaced_ids passes: ids are scoped by org.",
  "kwargs": {
    "url": "$BASE",
    "org_id": "fixture-org",
    "api_key": "fixture-api-key",
    "include_bound_users": "true",
    "include_software": "false",
    "include_mac_addresses": "false",
    "page_size": "100"
  },
