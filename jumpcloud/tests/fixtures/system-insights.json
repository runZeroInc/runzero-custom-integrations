  ],
  "expect": {
    "asset_count": 4,
    "ids": [
      "jumpcloud:fixture-org:6600000000000000000000d1",
      "jumpcloud:fixture-org:6600000000000000000000d2",
      "jumpcloud:fixture-org:6600000000000000000000d3",
      "jumpcloud:fixture-org:6600000000000000000000d4"
    ],
    "min_software_total": 3,
    "assets": [
      {"id": "jumpcloud:fixture-org:6600000000000000000000d3", "fields": {"deviceType": "Server"}},
      {"id": "jumpcloud:fixture-org:6600000000000000000000d1", "fields_absent": ["deviceType"]},
      {"id": "jumpcloud:fixture-org:6600000000000000000000d2", "fields_absent": ["deviceType"]},
      {"id": "jumpcloud:fixture-org:6600000000000000000000d4", "fields_absent": ["deviceType"]}
    ],
    "requests_include": [
      {"method": "GET", "path": "/api/v2/systeminsights/apps", "query_contains": "system_id%3Aeq%3A6600000000000000000000d1"},
      {"method": "GET", "path": "/api/v2/systeminsights/programs", "query_contains": "system_id%3Aeq%3A6600000000000000000000d2"},
      {"method": "GET", "path": "/api/v2/systeminsights/interface_details", "query_contains": "system_id%3Aeq%3A6600000000000000000000d3"}
    ],
    "requests_absent": [
      {"path": "/api/v2/systeminsights/programs", "query_contains": "system_id%3Aeq%3A6600000000000000000000d1"},
      {"path": "/api/v2/systeminsights/apps", "query_contains": "system_id%3Aeq%3A6600000000000000000000d2"},
      {"path": "/api/v2/systeminsights/apps", "query_contains": "system_id%3Aeq%3A6600000000000000000000d3"},
      {"path": "/api/v2/systeminsights/apps", "query_contains": "system_id%3Aeq%3A6600000000000000000000d4"},
      {"path": "/api/v2/systeminsights/interface_details", "query_contains": "system_id%3Aeq%3A6600000000000000000000d4"},
      {"path": "/api/systemusers"}
    ],
    "log_contains": [
      "jumpcloud: System Insights is not enabled on 1 systems",
      "jumpcloud: reported 4 of 4 systems"
    ]
  },
  "invariants": {"skip": []}
}
