{
  "name": "happy",
  "integration": "jumpcloud",
  "description": "Two systems, the directory user index that resolves their bindings, and the v2 graph call per system. Proves the v1 inventory and the v2 graph are both routed and correlated, that the per-adapter regrouping turns en0's IPv4 and IPv6 entries into one interface rather than two, that the loopback entry flagged internal and the 169.254 link-local on utun3 never reach an interface, that displayName is only promoted to a hostname when it is still hostname shaped (\"Fixture's MacBook Pro\" is not, and importing it would give runZero a name nothing can resolve), and that domainInfo.partOfDomain gates the domain field so a workgroup machine gets none. The two systems also bracket the device-type hint: srv-db01 reports os 'Windows Server 2022' and must come out typed Server, while the Mac reports an OS that says nothing about whether it is a desktop or a laptop and must carry NO deviceType. Neither system publishes a hardware model -- JumpCloud has hwVendor and no hwModel -- so this is the only type signal the inventory holds.",
  "kwargs": {
    "url": "$BASE",
    "org_id": "fixture-org",
    "api_key": "fixture-api-key",
    "include_bound_users": "true",
    "include_software": "false",
    "include_mac_addresses": "false",
    "page_size": "100"
  },
  "routes": [
    {
      "name": "user-directory",
      "match": {"method": "GET", "path": "/api/systemusers"},
      "responses": [
        {
          "status": 200,
          "json": {
            "totalCount": 2,
            "results": [
              {"_id": "6600000000000000000000a1", "username": "user1", "email": "user1@example.com"},
              {"_id": "6600000000000000000000a2", "username": "user2", "email": "user2@example.com"}
            ]
          }
        }
      ],
      "when_exhausted": "empty"
    },
    {
      "name": "systems",
      "match": {"method": "GET", "path": "/api/systems"},
      "responses": [
        {
          "status": 200,
          "json": {
            "totalCount": 2,
            "results": [
              {
                "_id": "6600000000000000000000b1",
                "hostname": "wks-042",
                "displayName": "Fixture's MacBook Pro",
                "os": "Mac OS X",
                "version": "14.5",
                "serialNumber": "C02X1234ABCD",
                "hwVendor": "Apple Inc.",
                "arch": "arm64",
                "agentVersion": "2.9.1",
                "active": true,
                "created": "2026-01-10T08:00:00Z",
                "lastContact": "2026-08-15T01:00:00.123Z",
                "systemInsights": {"state": "deferred"},
                "fde": {"active": true, "keyPresent": true},
                "domainInfo": {"partOfDomain": false},
                "remoteIP": "198.51.100.4",
                "networkInterfaces": [
                  {"name": "lo0", "address": "127.0.0.1", "family": "ipv4", "internal": true},
                  {"name": "lo0", "address": "::1", "family": "ipv6", "internal": true},
                  {"name": "en0", "address": "10.50.0.20", "family": "ipv4", "internal": false},
                  {"name": "en0", "address": "fe80::c0ff:eeff:fe00:1", "family": "ipv6", "internal": false},
                  {"name": "en0", "address": "2001:db8:50::20", "family": "ipv6", "internal": false},
                  {"name": "utun3", "address": "169.254.5.5", "family": "ipv4", "internal": false}
                ],
                "userMetrics": [
                  {"userName": "user1", "admin": true, "managed": true},
                  {"userName": "root", "admin": true, "managed": false}
                ],
                "primarySystemUser": {"id": "6600000000000000000000a1"}
              },
              {
                "_id": "6600000000000000000000b2",
                "hostname": "srv-db01",
                "displayName": "srv-db01",
                "os": "Windows Server 2022",
                "version": "10.0.20348",
                "serialNumber": "VMware-42 0a bc",
                "hwVendor": "VMware, Inc.",
                "active": false,
                "created": "2025-09-02T10:30:00Z",
                "lastContact": "2026-08-14T22:15:00Z",
                "systemInsights": {"state": "enabled"},
                "fde": {"active": false},
                "domainInfo": {"partOfDomain": true, "domainName": "corp.example.com"},
                "networkInterfaces": [
                  {"name": "Ethernet0", "address": "10.50.1.30", "family": "ipv4", "internal": false},
                  {"name": "Loopback Pseudo-Interface 1", "address": "127.0.0.1", "family": "ipv4", "internal": true}
                ],
                "userMetrics": [{"userName": "svc_backup", "admin": false, "managed": true}]
              }
            ]
          }
        }
      ],
      "when_exhausted": "empty"
    },
    {
      "name": "bound-users-wks042",
      "match": {"method": "GET", "path": "/api/v2/systems/6600000000000000000000b1/users"},
      "responses": [
        {
          "status": 200,
          "json": [
            {
              "id": "6600000000000000000000a1",
              "paths": [[{"type": "system", "id": "6600000000000000000000b1"}]],
              "compiledAttributes": {"sudo": {"enabled": true}}
            }
          ]
        }
      ],
      "when_exhausted": "empty"
    },
    {
      "name": "bound-users-srvdb01",
      "match": {"method": "GET", "path": "/api/v2/systems/6600000000000000000000b2/users"},
      "responses": [
        {
          "status": 200,
          "json": [
            {
              "id": "6600000000000000000000a2",
              "paths": [[{"type": "user_group", "id": "g1"}, {"type": "system", "id": "6600000000000000000000b2"}]],
              "compiledAttributes": {"sudo": {"enabled": false}}
            }
          ]
        }
      ],
      "when_exhausted": "empty"
    }
  ],
  "expect": {
    "asset_count": 2,
    "ids": [
      "jumpcloud:fixture-org:6600000000000000000000b1",
      "jumpcloud:fixture-org:6600000000000000000000b2"
    ],
    "assets": [
      {"id": "jumpcloud:fixture-org:6600000000000000000000b2", "fields": {"deviceType": "Server"}},
      {"id": "jumpcloud:fixture-org:6600000000000000000000b1", "fields_absent": ["deviceType"]}
    ],
    "request_count": 4,
    "requests_include": [
      {"method": "GET", "path": "/api/systemusers", "query_contains": "sort=_id"},
      {"method": "GET", "path": "/api/systems", "query_contains": "skip=0"},
      {"method": "GET", "path": "/api/v2/systems/6600000000000000000000b1/users"},
      {"method": "GET", "path": "/api/v2/systems/6600000000000000000000b2/users"}
    ],
    "log_contains": [
      "jumpcloud: indexed 2 directory users",
      "jumpcloud: reported 2 of 2 systems",
      "jumpcloud: fetched per-system detail for 2 systems"
    ]
  },
  "invariants": {"skip": []}
}
