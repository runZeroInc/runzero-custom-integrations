              },
              {
                "id": 9002,
                "ip": "10.80.1.12",
                "mac_addresses": "00:1b:1b:00:90:12",
                "main_name": "syn-hmi-01",
                "role": "HMI",
                "purdue_level": "2",
                "os_version": "Windows 7 Embedded",
                "first_seen": "2026-02-11T11:00:00Z",
                "last_seen": "2026-08-02T14:30:00Z",
                "open_ports": [
