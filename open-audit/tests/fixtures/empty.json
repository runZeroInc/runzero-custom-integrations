{
  "name": "empty",
  "integration": "open-audit",
  "description": "A server with no devices the credential can see, which is what a fresh install or an organisation filter matching nothing looks like. Open-AudIT answers 200 with an empty data array rather than an error, so the run must report zero assets and exit cleanly instead of treating the empty collection as a failure. Asserts the walk stops after the single page and that no per-device detail request is attempted.",
  "kwargs": {
    "url": "$BASE",
    "username": "fixture-user",
    "password": "fixture-password",
    "org_id": "7"
  },
  "routes": [
    {
      "name": "logon",
      "match": {"method": "POST", "path": "/open-audit/index.php/logon"},
      "responses": [
        {"status": 200, "headers": {"Set-Cookie": "ci_session=fixture-empty-session; Path=/"}, "json": {"id": "3", "name": "runzero"}}
      ],
      "when_exhausted": "repeat_last"
    },
    {
      "name": "devices",
      "match": {"method": "GET", "path": "/open-audit/index.php/devices"},
      "responses": [
        {
          "status": 200,
          "json": {
            "meta": {"collection": "devices", "action": "collection", "format": "json", "header": 200, "version": 1, "limit": 500, "offset": 0, "total": 0, "filtered": 0},
            "included": [],
            "logs": [],
            "data": []
          }
        }
      ],
      "when_exhausted": "error"
    }
  ],
  "default_response": {"status": 404, "text": "no fixture route"},
  "expect": {
    "asset_count": 0,
    "request_count": 2,
    "requests_include": [
      {"method": "GET", "path": "/open-audit/index.php/devices", "query_contains": "devices.org_id=7"}
    ],
    "requests_absent": [
      {"path_contains": "/open-audit/index.php/devices/"}
    ],
    "log_contains": ["open-audit: no assets retrieved"]
  },
  "invariants": {"skip": []},
  "check_determinism": true
}
