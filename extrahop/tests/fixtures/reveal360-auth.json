{
  "name": "reveal360-auth",
  "integration": "extrahop",
  "description": "RevealX 360 deployment: the client_credentials bootstrap at /oauth2/token must run before anything else, and the issued token must be used as a bearer on every later call. Without routing the token exchange the run yields zero assets, which is what makes this the bootstrap regression test.",
  "kwargs": {
    "url": "$BASE",
    "deployment": "reveal360",
    "client_id": "fixture-client-id",
    "client_secret": "fixture-client-secret",
    "require_ip_address": "false",
    "include_software": "false"
  },
  "routes": [
    {
      "name": "token",
      "match": {"method": "POST", "path": "/oauth2/token"},
      "responses": [
        {"status": 200, "json": {"access_token": "fixture-access-token", "token_type": "Bearer", "expires_in": 3600}}
      ]
    },
    {
      "name": "networks",
      "match": {"method": "GET", "path": "/api/v1/networks"},
      "responses": [
        {"status": 200, "json": [{"node_id": null, "appliance_uuid": "appl-uuid-360a"}]}
      ]
    },
    {
      "name": "device-search",
      "match": {"method": "POST", "path": "/api/v1/devices/search"},
      "responses": [
        {
          "status": 200,
          "json": [
            {
              "id": 501,
              "discovery_id": "cloudhost01",
              "node_id": null,
              "is_l3": false,
              "macaddr": "00:11:22:33:55:01",
              "ipaddr4": "10.40.0.7",
              "dns_name": "cloud01.corp.example.com",
              "role": "http_server",
              "cloud_account": "111122223333",
              "cloud_instance_id": "i-0fixture0000000001",
              "last_seen_time": 1786000000000
            }
          ]
        }
      ],
      "when_exhausted": "empty"
    }
  ],
  "expect": {
    "asset_count": 1,
    "ids": ["extrahop:appl-uuid-360a:cloudhost01"],
    "requests_include": [
      {"method": "POST", "path": "/oauth2/token", "body_contains": "grant_type=client_credentials"},
      {"method": "GET", "path": "/api/v1/networks", "header_contains": "Bearer fixture-access-token"},
      {"method": "POST", "path": "/api/v1/devices/search", "header_contains": "Bearer fixture-access-token"}
    ]
  },
  "invariants": {"skip": []}
}
