{
 "name": "clamped-page-size",
 "integration": "device42",
 "description": "REGRESSION LOCK for silent truncation under a server-side row cap. The script requests limit=1000, but an appliance may clamp the served page below that; the old stop condition compared the page length against the REQUESTED limit, so the first (full, but clamped) page looked short, the walk ended after one request, and every device past page one was invisible while the run reported success. The served page size is now learned from the first response (the cyberwatch trick), the offset advances by rows actually served, and only a page shorter than the LEARNED size ends the walk. Here the appliance clamps to 3 rows per page: pages at offset 0 and 3 are full, offset 6 is short, and all seven devices must import across exactly three requests. Every route is when_exhausted:error so a walk that re-fetches or overshoots fails loudly. namespaced_ids is skipped for the reason recorded in happy: the id is the bare Device42 id with no appliance scope.",
 "kwargs": {
  "url": "$BASE",
  "auth_scheme": "basic",
  "credential": "Zml4dHVyZTpmaXh0dXJl"
 },
 "routes": [
  {
   "name": "devices-offset-0",
   "match": {
    "method": "GET",
    "path": "/api/1.0/devices/all/",
    "query_contains": "offset=0"
   },
   "responses": [
    {
     "status": 200,
     "json": {
      "Devices": [
       {
        "id": 9501,
        "name": "d42-clamped-01",
