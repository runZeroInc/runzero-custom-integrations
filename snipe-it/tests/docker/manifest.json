{
  "name": "snipe-it",
  "integration": "snipe-it",
  "description": "Imports three hardware rows created over a real Snipe-IT REST API, proving the per-row MAC custom-field mapping, that a row without a MAC does not inherit the previous row's, that the asset name imports as a hostname (the correlator a stock install's rows otherwise lack), and that the foreign id carries the instance scope rather than being the bare auto-increment primary key.",
  "compose": "compose.yml",
  "service": "snipeit",
  "port": 80,
  "scheme": "http",

  "ready": [
    {
      "name": "web server answering",
      "http": {"path": "/", "status": [200, 302]},
      "timeout": 600,
      "interval": 4
    }
  ],

  "seed": "seed.py",
  "seed_timeout": 900,

  "kwargs": {
    "url": "$BASE",
    "api_token": "${seed.api_token}"
  },

  "expect": {
    "asset_count": 3,
    "assets": [
      {
        "id": "snipe-it:$HOST:hardware:${seed.web_id}",
        "fields": {
          "hostnames": "web01",
          "macAddresses": "00:11:22:33:44:55",
          "deviceType": "Servers",
          "manufacturer": "Dell Inc.",
          "model": "PowerEdge R640",
          "name": "web01",
          "asset.tag": "RZ-0001",
          "serial.number": "SVC12345",
          "status.name": "Ready to Deploy",
          "status.type": "deployable",
          "model.number": "R640"
        },
        "fields_absent": ["ipAddresses"]
      },
      {
        "id": "snipe-it:$HOST:hardware:${seed.db_id}",
        "fields": {
          "hostnames": "db01",
          "macAddresses": "00:11:22:33:44:66",
          "name": "db01",
          "asset.tag": "RZ-0002"
        }
      },
      {
        "id": "snipe-it:$HOST:hardware:${seed.monitor_id}",
        "fields": {
          "hostnames": "monitor01",
          "name": "monitor01",
          "asset.tag": "RZ-0003"
        },
        "fields_absent": ["macAddresses", "ipAddresses"]
      }
    ]
  },

  "invariants": {
    "skip": []
  },

  "check_determinism": true,
  "startup_timeout": 900,
  "timeout": 600
}
