{
  "name": "auth-refresh",
  "integration": "halcyon",
  "description": "The access token expires mid-run. The asset search answers 401 once, and the script must log in again, pick up the second token, replay the same search and finish. Proves _refresh_access_token issues a real second login POST rather than retrying with the stale token, that the replayed call carries the NEW token, and that no asset is lost across the refresh. 401 is deliberately outside get_json/post_json's default retry_on set, so the retry seen here is the script's own re-auth path and not the transport's.\n\nnamespaced_ids is skipped: bare Halcyon asset uuids, as in happy.",
  "kwargs": {
    "url": "$BASE",
    "username": "svc-runzero@example.com",
    "password": "fixture-password"
  },
  "routes": [
    {
      "name": "login",
      "match": {
        "method": "POST",
        "path": "/identity/auth/login"
      },
      "responses": [
        {
          "status": 200,
          "json": {
            "accessToken": "fixture-token-first"
          }
        },
        {
          "status": 200,
          "json": {
            "accessToken": "fixture-token-second"
          }
        }
      ],
      "when_exhausted": "error"
    },
    {
      "name": "search-expires-then-succeeds",
      "match": {
        "method": "POST",
        "path": "/v2/assets/search"
      },
      "responses": [
        {
          "status": 401,
          "json": {
            "error": "token expired"
          }
        },
        {
          "status": 200,
          "json": {
            "items": [
              {
                "id": "7f0e2001-0000-4000-8000-000000002001",
                "name": "syn-halcyon-reauth.example.com",
                "operatingSystem": "Windows Server 2019",
                "registeredDate": "2026-01-07T00:00:00Z"
              }
            ],
            "pagination": {
              "currentPage": 1,
              "totalPages": 1
            }
          }
        }
      ],
      "when_exhausted": "error"
    },
    {
      "name": "detail",
      "match": {
        "method": "GET",
        "path": "/v2/assets/7f0e2001-0000-4000-8000-000000002001"
      },
      "responses": [
        {
          "status": 200,
          "json": {
            "ipAddresses": [
              {
                "ipAddressType": "IPv4",
                "value": "192.0.2.61"
              }
            ],
            "macAddresses": [
              "00:11:22:33:55:61"
            ]
          }
        }
      ],
      "when_exhausted": "error"
    }
  ],
  "expect": {
    "asset_count": 1,
    "ids": [
      "7f0e2001-0000-4000-8000-000000002001"
    ],
    "request_count": 5,
    "requests_include": [
      {
        "method": "POST",
        "path": "/identity/auth/login"
      },
      {
        "header_contains": "fixture-token-first"
      },
      {
        "header_contains": "fixture-token-second"
      },
      {
        "method": "GET",
        "path": "/v2/assets/7f0e2001-0000-4000-8000-000000002001",
        "header_contains": "fixture-token-second"
      }
    ],
    "assets": [
      {
        "id": "7f0e2001-0000-4000-8000-000000002001",
        "fields": {
          "ipAddresses": "192.0.2.61"
        }
      }
    ]
  },
  "invariants": {
    "skip": [
      "namespaced_ids"
    ]
  }
}