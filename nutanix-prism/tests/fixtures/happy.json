              {
                "uuid": "bbbbbbbb-0000-4000-8000-000000000002",
                "name": "syn-db-01",
                "power_state": "off",
                "num_vcpus": 8,
                "memory_mb": 32768,
                "host_uuid": "aaaaaaaa-0000-4000-8000-000000000002",
                "vm_nics": [
                  {
                    "mac_address": "50:6b:8d:00:00:02",
