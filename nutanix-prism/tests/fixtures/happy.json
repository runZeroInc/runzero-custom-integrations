  "expect": {
    "asset_count": 5,
    "ids": [
      "nutanix:00000000-0000-4000-8000-c1u57e40000a:host:aaaaaaaa-0000-4000-8000-000000000001",
      "nutanix:00000000-0000-4000-8000-c1u57e40000a:host:aaaaaaaa-0000-4000-8000-000000000002",
      "nutanix:00000000-0000-4000-8000-c1u57e40000a:host:aaaaaaaa-0000-4000-8000-000000000003",
      "nutanix:00000000-0000-4000-8000-c1u57e40000a:vm:bbbbbbbb-0000-4000-8000-000000000001",
      "nutanix:00000000-0000-4000-8000-c1u57e40000a:vm:bbbbbbbb-0000-4000-8000-000000000002"
    ],
    "assets": [
      {
        "id": "nutanix:00000000-0000-4000-8000-c1u57e40000a:host:aaaaaaaa-0000-4000-8000-000000000001",
        "comment": "Nodes carry no assetTypeBehavior entry, so they resolve to the platform default with all eight flags on.",
        "fields": {
          "_attrType": "host"
        }
      },
      {
        "id": "nutanix:00000000-0000-4000-8000-c1u57e40000a:vm:bbbbbbbb-0000-4000-8000-000000000001",
        "comment": "Guests select the vm type, which is the only entry in assetTypeBehavior.",
        "fields": {
          "_attrType": "vm"
        }
      }
    ],
    "min_requests": 3,
    "requests_include": [
      {"method": "GET", "path": "/PrismGateway/services/rest/v2.0/cluster"},
      {"method": "GET", "path": "/PrismGateway/services/rest/v2.0/hosts", "query_contains": "count=250"},
      {"method": "GET", "path": "/PrismGateway/services/rest/v2.0/vms", "query_contains": "include_vm_nic_config=true"},
      {"header_contains": "Basic"}
    ]
  },
  "invariants": {"skip": []}
}
