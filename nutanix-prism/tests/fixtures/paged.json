{
  "name": "paged",
  "integration": "nutanix-prism",
  "description": "Two pages of each listing with page_size=2, proving the two DIFFERENT paging vocabularies are both driven correctly: hosts advance count/page (1-based page number), VMs advance offset/length (0-based record offset). Both walks must stop on the short final page rather than looping.",
  "kwargs": {
    "url": "$BASE",
    "username": "fixture-viewer",
    "password": "fixture-password",
    "import_vms": "true",
    "page_size": "2"
  },
  "routes": [
    {
      "name": "cluster",
      "match": {"method": "GET", "path": "/PrismGateway/services/rest/v2.0/cluster"},
      "responses": [
        {"status": 200, "json": {"uuid": "00000000-0000-4000-8000-c1u57e40000a", "name": "fixture-cluster", "version": "6.5.3.5"}}
      ]
    },
    {
      "name": "hosts-page-1",
      "match": {"method": "GET", "path": "/PrismGateway/services/rest/v2.0/hosts", "query_contains": "page=1"},
      "responses": [
        {
          "status": 200,
          "json": {
            "metadata": {"grand_total_entities": 3, "count": 2, "page": 1},
            "entities": [
              {"uuid": "aaaaaaaa-0000-4000-8000-000000000001", "name": "NTNX-SYN01-A", "hypervisor_address": "10.55.0.11", "hypervisor_type": "kKvm", "hypervisor_full_name": "Nutanix 20190916.321", "block_model": "NX-3060-G7"},
              {"uuid": "aaaaaaaa-0000-4000-8000-000000000002", "name": "NTNX-SYN01-B", "hypervisor_address": "10.55.0.12", "hypervisor_type": "kKvm", "hypervisor_full_name": "Nutanix 20190916.321", "block_model": "NX-3060-G7"}
            ]
          }
        }
      ]
    },
    {
      "name": "hosts-page-2",
      "match": {"method": "GET", "path": "/PrismGateway/services/rest/v2.0/hosts", "query_contains": "page=2"},
      "responses": [
        {
          "status": 200,
          "json": {
            "metadata": {"grand_total_entities": 3, "count": 1, "page": 2},
            "entities": [
              {"uuid": "aaaaaaaa-0000-4000-8000-000000000003", "name": "NTNX-SYN01-C", "hypervisor_address": "10.55.0.13", "hypervisor_type": "kKvm", "hypervisor_full_name": "Nutanix 20190916.321", "block_model": "NX-1065-G6"}
            ]
          }
        }
      ]
    },
    {
      "name": "hosts-page-3-must-not-happen",
      "match": {"method": "GET", "path": "/PrismGateway/services/rest/v2.0/hosts"},
      "responses": [{"status": 500, "text": "hosts walked past the short final page"}],
      "when_exhausted": "repeat_last"
    },
    {
      "name": "vms-offset-0",
      "match": {"method": "GET", "path": "/PrismGateway/services/rest/v2.0/vms", "query_contains": "offset=0"},
      "responses": [
        {
          "status": 200,
          "json": {
            "metadata": {"grand_total_entities": 3, "count": 2, "offset": 0},
            "entities": [
              {"uuid": "bbbbbbbb-0000-4000-8000-000000000001", "name": "syn-app-01", "power_state": "on", "host_uuid": "aaaaaaaa-0000-4000-8000-000000000001", "vm_nics": [{"mac_address": "50:6b:8d:00:00:01", "ip_addresses": ["10.55.10.21"]}]},
              {"uuid": "bbbbbbbb-0000-4000-8000-000000000002", "name": "syn-db-01", "power_state": "on", "host_uuid": "aaaaaaaa-0000-4000-8000-000000000002", "vm_nics": [{"mac_address": "50:6b:8d:00:00:02", "ip_addresses": ["10.55.10.22"]}]}
            ]
          }
        }
      ]
    },
    {
      "name": "vms-offset-2",
      "match": {"method": "GET", "path": "/PrismGateway/services/rest/v2.0/vms", "query_contains": "offset=2"},
      "responses": [
        {
          "status": 200,
          "json": {
            "metadata": {"grand_total_entities": 3, "count": 1, "offset": 2},
            "entities": [
              {"uuid": "bbbbbbbb-0000-4000-8000-000000000003", "name": "syn-web-01", "power_state": "on", "host_uuid": "aaaaaaaa-0000-4000-8000-000000000003", "vm_nics": [{"mac_address": "50:6b:8d:00:00:03", "ip_address": "10.55.10.23"}]}
            ]
          }
        }
      ]
    },
    {
      "name": "vms-offset-4-must-not-happen",
      "match": {"method": "GET", "path": "/PrismGateway/services/rest/v2.0/vms"},
      "responses": [{"status": 500, "text": "VMs walked past the short final page"}],
      "when_exhausted": "repeat_last"
    }
  ],
  "expect": {
    "asset_count": 6,
    "ids": [
      "nutanix:00000000-0000-4000-8000-c1u57e40000a:host:aaaaaaaa-0000-4000-8000-000000000003",
      "nutanix:00000000-0000-4000-8000-c1u57e40000a:vm:bbbbbbbb-0000-4000-8000-000000000003"
    ],
    "request_count": 5,
    "requests_include": [
      {"method": "GET", "path": "/PrismGateway/services/rest/v2.0/hosts", "query_contains": "count=2&page=1"},
      {"method": "GET", "path": "/PrismGateway/services/rest/v2.0/hosts", "query_contains": "count=2&page=2"},
      {"method": "GET", "path": "/PrismGateway/services/rest/v2.0/vms", "query_contains": "length=2&offset=0"},
      {"method": "GET", "path": "/PrismGateway/services/rest/v2.0/vms", "query_contains": "length=2&offset=2"}
    ],
    "requests_absent": [
      {"path": "/PrismGateway/services/rest/v2.0/hosts", "query_contains": "page=3"},
      {"path": "/PrismGateway/services/rest/v2.0/vms", "query_contains": "offset=4"}
    ],
    "log_contains": [
      "reported 3 hypervisor nodes",
      "reported 3 guest VMs"
    ]
  },
  "invariants": {"skip": []}
}
