                "hardware_serial": "SN-LAP-0012",
                "hardware_model": "MacBookPro18,3",
                "hardware_vendor": "Apple Inc.",
                "created_at": "2026-01-06T11:00:00Z",
                "seen_time": "2026-02-01T08:05:00Z",
                "labels": [{"name": "Laptops", "label_type": "regular"}],
                "policies": [{"name": "FileVault enabled", "response": "pass"}],
                "software": [
                  {"id": 5003, "name": "Firefox", "version": "134.0", "source": "apps"}
