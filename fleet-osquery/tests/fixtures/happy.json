  ],
  "expect": {
    "asset_count": 2,
    "ids": ["fleet-osquery:$HOST:11", "fleet-osquery:$HOST:12"],
    "min_requests": 1,
    "min_software_total": 3,
    "min_services_total": 2,
    "requests_include": [
      {"method": "GET", "path": "/api/v1/fleet/hosts", "query_contains": "page=0"},
      {"query_contains": "populate_software=true"},
      {"query_contains": "additional_info_filters=listening_ports"},
      {"header_contains": "fixture-token"}
    ]
  },
  "invariants": {"skip": []}
}
