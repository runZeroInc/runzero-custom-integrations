{
  "name": "identity-on-pve1",
  "integration": "proxmox",
  "description": "Identity stability, half one of two: VM 100 and container 200 are running on node pve1. Paired with identity-on-pve2.json, which is the same cluster after a live migration moved both guests to pve2 and their addresses changed with them. The ids asserted here are byte-identical in both files, which is the regression test for a VMID-plus-node id: live migration and HA failover move a guest routinely, and an id carrying the node name would mint a duplicate asset on every such event. Skips namespaced_ids: the cluster name scopes the id but is joined with '-' rather than ':'.",
  "kwargs": {
    "base_url": "$BASE",
    "api_token_id": "svc@pve!runzero",
    "api_token_secret": "fixture-secret"
  },
  "routes": [
    {
      "match": {"method": "GET", "path": "/api2/json/version"},
      "responses": [{"status": 200, "json": {"data": {"release": "8.2"}}}]
    },
    {
      "match": {"method": "GET", "path": "/api2/json/cluster/status"},
      "responses": [{"status": 200, "json": {"data": [
        {"type": "cluster", "name": "lab-cluster", "quorate": 1}
      ]}}]
    },
    {
      "match": {"method": "GET", "path": "/api2/json/cluster/config/nodes"},
      "responses": [{"status": 200, "json": {"data": [
        {"node": "pve1", "nodeid": 1, "ring0_addr": "10.30.0.11"}
      ]}}]
    },
    {
      "match": {"method": "GET", "path": "/api2/json/cluster/resources"},
      "responses": [{"status": 200, "json": {"data": [
        {"type": "node", "node": "pve1", "status": "online", "maxcpu": 32}
      ]}}]
    },
    {
      "match": {"method": "GET", "path": "/api2/json/nodes/pve1/qemu"},
      "responses": [{"status": 200, "json": {"data": [
        {"vmid": 100, "name": "app01", "status": "running"}
      ]}}]
    },
    {
      "match": {"method": "GET", "path": "/api2/json/nodes/pve1/qemu/100/config"},
      "responses": [{"status": 200, "json": {"data": {
        "name": "app01", "net0": "virtio=AA:BB:CC:00:01:10,bridge=vmbr0"
      }}}]
    },
    {
      "match": {"method": "GET", "path": "/api2/json/nodes/pve1/qemu/100/agent/network-get-interfaces"},
      "responses": [{"status": 200, "json": {"data": {"result": [
        {"name": "eth0", "hardware-address": "aa:bb:cc:00:01:10",
         "ip-addresses": [{"ip-address": "10.30.10.20", "prefix": 24}]}
      ]}}}]
    },
    {
      "match": {"method": "GET", "path": "/api2/json/nodes/pve1/qemu/100/agent/get-osinfo"},
      "responses": [{"status": 200, "json": {"data": {"result": {
        "pretty-name": "Debian GNU/Linux 12 (bookworm)", "version-id": "12"
      }}}}]
    },
    {
      "match": {"method": "GET", "path": "/api2/json/nodes/pve1/lxc"},
      "responses": [{"status": 200, "json": {"data": [
        {"vmid": 200, "name": "dns01", "status": "running"}
      ]}}]
    },
    {
      "match": {"method": "GET", "path": "/api2/json/nodes/pve1/lxc/200/config"},
      "responses": [{"status": 200, "json": {"data": {
        "hostname": "dns01.lab.example.com", "ostype": "debian"
      }}}]
    },
    {
      "match": {"method": "GET", "path": "/api2/json/nodes/pve1/lxc/200/interfaces"},
      "responses": [{"status": 200, "json": {"data": [
        {"name": "eth0", "hwaddr": "BC:24:11:AA:BB:01",
         "ip-addresses": [{"ip-address": "10.30.20.30", "prefix": 24}]}
      ]}}]
    }
  ],
  "expect": {
    "asset_count": 3,
    "assets": [
      {
        "id": "lab-cluster-vm-100",
        "fields": {"proxmox_node": "pve1", "proxmox_cluster": "lab-cluster", "ipAddresses": "10.30.10.20", "macAddresses": "a8:bb:cc:00:01:10"}
      },
      {
        "id": "lab-cluster-ct-200",
        "fields": {"proxmox_node": "pve1", "proxmox_cluster": "lab-cluster", "ipAddresses": "10.30.20.30", "hostnames": "dns01.lab.example.com"}
      }
    ],
    "ids": [
      "lab-cluster-node-pve1",
      "lab-cluster-vm-100",
      "lab-cluster-ct-200"
    ],
    "ids_absent": [
      "lab-cluster-pve1-vm-100",
      "lab-cluster-vm-pve1-100",
      "lab-cluster-pve1-ct-200",
      "lab-cluster-ct-pve1-200"
    ],
    "requests_include": [
      {"method": "GET", "path": "/api2/json/nodes/pve1/qemu"}
    ]
  },
  "invariants": {
    "skip": ["namespaced_ids"]
  }
}
