{
  "name": "malformed",
  "integration": "icinga2",
  "description": "A results array holding a string, a number, a null, an object whose attrs is a string, and an object whose vars, groups, state, and timestamps are all the wrong type. Every one of those is a shape the object-types reference says cannot occur. The run must drop the elements that are not objects, read what it can from the ones that are - an object with unreadable attrs still has a usable name - and reject an address-shaped typo (192.0.2..300) rather than importing it as a hostname.",
  "kwargs": {
    "url": "$BASE",
    "username": "runzero",
    "password": "fixture-secret"
  },
  "routes": [
    {
      "name": "status",
      "match": {
        "method": "GET",
        "path": "/v1/status/IcingaApplication"
      },
      "responses": [
        {
          "status": 200,
          "json": {
            "results": [
              {
                "perfdata": [],
                "status": {
                  "icingaapplication": {
                    "app": {
                      "enable_event_handlers": true,
                      "enable_flapping": true,
                      "enable_host_checks": true,
                      "enable_notifications": true,
                      "enable_perfdata": true,
                      "enable_service_checks": true,
                      "node_name": "icinga.example.com",
                      "pid": 59819.0,
                      "program_start": 1755000000.093372,
                      "version": "r2.14.2-1"
                    }
                  }
                }
              }
            ]
          }
        }
      ],
      "when_exhausted": "repeat_last"
    },
    {
      "name": "hosts",
      "match": {
        "method": "POST",
        "path": "/v1/objects/hosts"
      },
      "responses": [
        {
          "status": 200,
          "json": {
            "results": [
              "not-an-object",
              42,
              null,
              {
                "name": "attrs-is-a-string",
                "type": "Host",
                "attrs": "boom"
              },
              {
                "name": "bad-types.example.com",
                "type": "Host",
                "attrs": {
                  "name": "bad-types.example.com",
                  "display_name": null,
                  "address": "192.0.2.60",
                  "address6": null,
                  "groups": "not-a-list",
                  "vars": "not-a-dict",
                  "state": "UP",
                  "state_type": "HARD",
                  "last_check": "yesterday",
                  "check_interval": null,
                  "acknowledgement": null,
                  "max_check_attempts": "three",
                  "templates": null
                }
              },
              {
                "name": "junk-address.example.com",
                "type": "Host",
                "attrs": {
                  "name": "junk-address.example.com",
                  "address": "!! not an address !!",
                  "address6": "192.0.2..300",
                  "vars": {},
                  "state": 0
                }
              },
              {
                "name": "good.example.com",
                "type": "Host",
                "attrs": {
                  "name": "good.example.com",
                  "display_name": "good.example.com",
                  "address": "203.0.113.7",
                  "groups": [
                    "linux-servers"
                  ],
                  "vars": {
                    "os": "Linux"
                  },
                  "state": 0.0,
                  "state_type": 1.0,
                  "last_check": 1786840000.5
                }
              }
            ]
          }
        }
      ],
      "when_exhausted": "repeat_last"
    }
  ],
  "default_response": {
    "status": 404,
    "json": {
      "error": 404.0,
      "status": "The requested path was not found."
    }
  },
  "expect": {
    "asset_count": 4,
    "ids": [
      "icinga2:$HOST:attrs-is-a-string",
      "icinga2:$HOST:bad-types.example.com",
      "icinga2:$HOST:junk-address.example.com",
      "icinga2:$HOST:good.example.com"
    ],
    "assets": [
      {
        "id": "icinga2:$HOST:good.example.com",
        "fields": {
          "os": "Linux",
          "icinga_state": "UP",
          "ipAddresses": "203.0.113.7"
        }
      },
      {
        "id": "icinga2:$HOST:bad-types.example.com",
        "fields": {
          "ipAddresses": "192.0.2.60"
        },
        "fields_absent": [
          "os",
          "icinga_state"
        ]
      },
      {
        "id": "icinga2:$HOST:junk-address.example.com",
        "fields": {
          "hostnames": "junk-address.example.com"
        },
        "fields_absent": [
          "ipAddresses",
          "macAddresses"
        ]
      },
      {
        "id": "icinga2:$HOST:attrs-is-a-string",
        "fields": {
          "hostnames": "attrs-is-a-string"
        },
        "fields_absent": [
          "ipAddresses",
          "macAddresses"
        ]
      }
    ],
    "log_contains": [
      "icinga2: reported 4 assets"
    ]
  },
  "invariants": {
    "skip": []
  },
  "check_determinism": true
}