{
  "name": "auth-failure",
  "integration": "icinga2",
  "description": "The ApiUser credential is rejected. The host query must name the credential as the cause rather than reporting an empty inventory, because a silent zero-asset run reads as an emptied estate.  The task now ENDS IN ERROR rather than reporting a successful run with zero assets: a refused credential and an empty tenant are otherwise the same result, and only the exit status separates them.",
  "kwargs": {
    "url": "$BASE",
    "username": "runzero",
    "password": "fixture-secret"
  },
  "routes": [
    {
      "name": "status",
      "match": {
        "method": "GET",
        "path": "/v1/status/IcingaApplication"
      },
      "responses": [
        {
          "status": 200,
          "json": {
            "results": [
              {
                "perfdata": [],
                "status": {
                  "icingaapplication": {
                    "app": {
                      "enable_event_handlers": true,
                      "enable_flapping": true,
                      "enable_host_checks": true,
                      "enable_notifications": true,
                      "enable_perfdata": true,
                      "enable_service_checks": true,
                      "node_name": "icinga.example.com",
                      "pid": 59819.0,
                      "program_start": 1755000000.093372,
                      "version": "r2.14.2-1"
                    }
                  }
                }
              }
            ]
          }
        }
      ],
      "when_exhausted": "repeat_last"
    },
    {
      "name": "hosts",
      "match": {
        "method": "POST",
        "path": "/v1/objects/hosts"
      },
      "responses": [
        {
          "status": 401,
          "text": "<h1>Unauthorized. Please check your user credentials.</h1>"
        }
      ],
      "when_exhausted": "repeat_last"
    }
  ],
  "default_response": {
    "status": 404,
    "json": {
      "error": 404.0,
      "status": "The requested path was not found."
    }
  },
  "expect": {
    "asset_count": 0,
    "min_requests": 2,
    "log_contains": [
      "status 401: the ApiUser name or password was rejected"
     ],
    "script_error": true,
    "error_contains": [
      "icinga2: failed to fetch hosts",
      "the ApiUser name or password was rejected"
    ]
  },
  "invariants": {
    "skip": []
  },
  "check_determinism": true
}