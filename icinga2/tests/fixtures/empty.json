{
  "name": "empty",
  "integration": "icinga2",
  "description": "An Icinga server with no host objects matching the query. Must report zero assets and log the fact rather than failing the task.",
  "kwargs": {
    "url": "$BASE",
    "username": "runzero",
    "password": "fixture-secret"
  },
  "routes": [
    {
      "name": "status",
      "match": {
        "method": "GET",
        "path": "/v1/status/IcingaApplication"
      },
      "responses": [
        {
          "status": 200,
          "json": {
            "results": [
              {
                "perfdata": [],
                "status": {
                  "icingaapplication": {
                    "app": {
                      "enable_event_handlers": true,
                      "enable_flapping": true,
                      "enable_host_checks": true,
                      "enable_notifications": true,
                      "enable_perfdata": true,
                      "enable_service_checks": true,
                      "node_name": "icinga.example.com",
                      "pid": 59819.0,
                      "program_start": 1755000000.093372,
                      "version": "r2.14.2-1"
                    }
                  }
                }
              }
            ]
          }
        }
      ],
      "when_exhausted": "repeat_last"
    },
    {
      "name": "hosts",
      "match": {
        "method": "POST",
        "path": "/v1/objects/hosts"
      },
      "responses": [
        {
          "status": 200,
          "json": {
            "results": []
          }
        }
      ],
      "when_exhausted": "repeat_last"
    }
  ],
  "default_response": {
    "status": 404,
    "json": {
      "error": 404.0,
      "status": "The requested path was not found."
    }
  },
  "expect": {
    "asset_count": 0,
    "min_requests": 2,
    "log_contains": [
      "icinga2: reported 0 assets",
      "icinga2: no assets retrieved"
    ]
  },
  "invariants": {
    "skip": []
  },
  "check_determinism": true
}