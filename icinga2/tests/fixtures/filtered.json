{
  "name": "filtered",
  "integration": "icinga2",
  "description": "A host group and a raw DSL filter set together. Proves the group name travels in filter_vars rather than being pasted into the expression - a group name holding a quote would otherwise change what the filter means - and that the two are combined with && rather than one silently replacing the other.",
  "kwargs": {
    "url": "$BASE",
    "username": "runzero",
    "password": "fixture-secret",
    "host_group": "linux-servers",
    "host_filter": "host.check_interval > 30"
  },
  "routes": [
    {
      "name": "status",
      "match": {
        "method": "GET",
        "path": "/v1/status/IcingaApplication"
      },
      "responses": [
        {
          "status": 200,
          "json": {
            "results": [
              {
                "perfdata": [],
                "status": {
                  "icingaapplication": {
                    "app": {
                      "enable_event_handlers": true,
                      "enable_flapping": true,
                      "enable_host_checks": true,
                      "enable_notifications": true,
                      "enable_perfdata": true,
                      "enable_service_checks": true,
                      "node_name": "icinga.example.com",
                      "pid": 59819.0,
                      "program_start": 1755000000.093372,
                      "version": "r2.14.2-1"
                    }
                  }
                }
              }
            ]
          }
        }
      ],
      "when_exhausted": "repeat_last"
    },
    {
      "name": "hosts",
      "match": {
        "method": "POST",
        "path": "/v1/objects/hosts"
      },
      "responses": [
        {
          "status": 200,
          "json": {
            "results": [
              {
                "name": "app01.example.com",
                "type": "Host",
                "attrs": {
                  "name": "app01.example.com",
                  "address": "192.0.2.81",
                  "groups": [
                    "linux-servers"
                  ],
                  "vars": {
                    "site": "dc1",
                    "os": "Linux"
                  },
                  "state": 0.0,
                  "last_check": 1786840000.0
                }
              }
            ]
          }
        }
      ],
      "when_exhausted": "repeat_last"
    }
  ],
  "default_response": {
    "status": 404,
    "json": {
      "error": 404.0,
      "status": "The requested path was not found."
    }
  },
  "expect": {
    "asset_count": 1,
    "ids": [
      "icinga2:$HOST:app01.example.com"
    ],
    "requests_include": [
      {
        "method": "POST",
        "path": "/v1/objects/hosts",
        "body_contains": "\"filter_vars\":{\"group\":\"linux-servers\"}"
      },
      {
        "method": "POST",
        "path": "/v1/objects/hosts",
        "body_contains": "\"filter\":\"group in host.groups && (host.check_interval > 30)\""
      }
    ],
    "log_contains": [
      "applying host filter: group in host.groups && (host.check_interval > 30)"
    ]
  },
  "invariants": {
    "skip": []
  },
  "check_determinism": true
}