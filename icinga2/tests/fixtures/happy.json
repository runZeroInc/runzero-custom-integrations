{
  "name": "happy",
  "integration": "icinga2",
  "description": "One host query plus the service-check summary. Proves the read is sent as POST + X-HTTP-Method-Override: GET carrying attrs as a JSON array (a repeated query key the runtime cannot express); that address/address6 are classified by what they actually hold, so an FQDN in address becomes a hostname and an IP becomes an interface; that a MAC recovered from vars is used for the interface but never for the id; that a loopback-only host is imported with no interface rather than sharing 127.0.0.1 with the estate; that a future last_check is clamped to now instead of dropping the whole record; and that Icinga service checks raise no runZero Service objects, only counts and names.",
  "kwargs": {
    "url": "$BASE",
    "username": "runzero",
    "password": "fixture-secret",
    "include_checks": "true",
    "include_check_output": "true"
  },
