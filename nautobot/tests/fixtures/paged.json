    "ids": [
      "nautobot:$HOST:device:11111111-1111-4111-8111-111111111111",
      "nautobot:$HOST:device:22222222-2222-4222-8222-222222222222",
      "nautobot:$HOST:device:33333333-3333-4333-8333-333333333333"
    ],
    "request_count": 3,
    "requests_include": [
      {
        "method": "GET",
        "path": "/api/dcim/devices/",
        "query_contains": "depth=1&limit=2&status=active"
      },
      {
        "method": "GET",
