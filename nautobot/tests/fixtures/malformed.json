        "fields": {"hostnames": "device-with-loopback-only"},
        "fields_absent": ["ipAddresses", "macAddresses"]
      },
      {
        "id": "nautobot:$HOST:device:44444444-4444-4444-8444-444444444444",
        "fields": {"hostnames": "device-with-junk-relations"},
        "fields_absent": ["ipAddresses", "macAddresses", "firstSeenTS"]
