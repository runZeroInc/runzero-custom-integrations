{
  "name": "malformed",
  "integration": "nautobot",
  "description": "Junk rows mixed into good ones. A bare string where a device object is documented, a null id, an id that is not a UUID, a device_type typed as a string, an interface whose ip_addresses is a string rather than a list, an interface that is a bare string, an IP address field holding something that is not an address, and a device whose only address is loopback. Each must be skipped or degraded with the run continuing. Also proves the future-timestamp clamp: a device Nautobot reports as last updated in 2099 is still imported, with lastSeenTS pulled back to now, rather than having the entire record rejected - the platform refuses any asset carrying a timestamp after now, and refuses the whole asset rather than the field.",
  "kwargs": {
    "url": "$BASE",
    "api_token": "0123456789abcdef0123456789abcdef01234567",
    "import_virtual_machines": "false"
  },
  "routes": [
    {
      "name": "manufacturers",
      "match": {"method": "GET", "path": "/api/dcim/manufacturers/"},
      "responses": [
        {
          "status": 200,
          "json": {
            "count": 2,
            "next": null,
            "previous": null,
            "results": [
              "this-row-is-a-string-not-an-object",
              {"id": "b329ec0d-5ee7-47d8-b4a7-3951c28e2979", "object_type": "dcim.manufacturer", "name": "Cisco"}
            ]
          }
        }
      ],
      "when_exhausted": "error"
    },
    {
      "name": "devices",
      "match": {"method": "GET", "path": "/api/dcim/devices/"},
      "responses": [
        {
          "status": 200,
          "json": {
            "count": 6,
            "next": null,
            "previous": null,
            "results": [
              "this-row-is-a-string-not-an-object",
              {
                "id": null,
                "object_type": "dcim.device",
                "name": "device-with-no-id",
                "primary_ip4": {"address": "192.0.2.90/24"}
              },
              {
                "id": "not-a-uuid-at-all",
                "object_type": "dcim.device",
                "name": "device-with-integer-style-id",
