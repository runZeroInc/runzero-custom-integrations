{
  "name": "paged",
  "integration": "ivanti_neurons",
  "script": "ivanti_neurons/ivanti_neurons.star",
  "description": "A three-page OData scroll whose pages carry 2, 2 and 1 devices against a reported @odata.count of 5.\n\nTwo regressions are locked here. First, the bearer token: the token endpoint answers with a JSON object holding access_token, and get_token used to return the whole response body, so /devices was called with 'Bearer {\"access_token\":...}'. The Bearer assertion below only matches the unwrapped value.\n\nSecond, the final page. The walk used to be bounded by len(assets_all) < @odata.count - 1, which stops one record short of the tenant's own total -- with 5 devices arriving 2+2+1 it halted after page two with four of them and never issued the third request. The walk is now driven by @odata.nextLink, as Ivanti documents, so all five arrive and the request count is exact.\n\nIds are asserted in the scoped form ivanti-neurons:<tenant id>:<DiscoveryId>: Neurons has no per-tenant subdomain, and the tenant id is the immutable key the gateway routes on (sent as X-TenantId), so two Neurons tenants imported into one runZero org cannot collide.",
  "kwargs": {
    "url": "$BASE",
    "tenant_id": "fixture-tenant",
    "client_id": "fixture-client",
    "client_secret": "fixture-secret"
  },
  "routes": [
    {
      "name": "token",
      "match": {"method": "GET", "path": "/api/apigatewaydataservices/v1/token"},
      "responses": [
        {"status": 200, "json": {"access_token": "fixture-jwt-token"}}
      ],
      "when_exhausted": "repeat_last"
    },
    {
      "name": "devices-page-3",
      "match": {"method": "GET", "path": "/api/apigatewaydataservices/v1/devices", "query_contains": "scrollID=page3"},
      "responses": [
        {
          "status": 200,
          "json": {
            "@odata.count": 5,
            "value": [
              {
                "DiscoveryId": "22220000-4a11-4c31-9c31-1a2b3c4d5e05",
                "DeviceID": "device-0005",
                "DeviceName": "kiosk-05.example.com",
                "DisplayName": "Kiosk 05",
                "OS": {"Name": "Windows 10 IoT Enterprise", "Version": "10.0.19045"},
                "System": {"Model": "ThinkCentre M75n"},
                "Network": {"TCPIP": {"IPAddress": "192.0.2.15"}}
              }
            ]
          }
        }
      ],
      "when_exhausted": "empty"
    },
    {
      "name": "devices-page-2",
      "match": {"method": "GET", "path": "/api/apigatewaydataservices/v1/devices", "query_contains": "scrollID=page2"},
      "responses": [
        {
          "status": 200,
          "json": {
            "@odata.count": 5,
            "value": [
              {
                "DiscoveryId": "22220000-4a11-4c31-9c31-1a2b3c4d5e03",
                "DeviceID": "device-0003",
                "DeviceName": "server-03.example.com",
                "DisplayName": "Server 03",
                "OS": {"Name": "Windows Server 2022", "Version": "10.0.20348"},
                "System": {"Model": "PowerEdge R650"},
                "Network": {"TCPIP": {"IPAddress": "192.0.2.13"}}
              },
              {
                "DiscoveryId": "22220000-4a11-4c31-9c31-1a2b3c4d5e04",
                "DeviceID": "device-0004",
                "DeviceName": "server-04.example.com",
                "DisplayName": "Server 04",
                "OS": {"Name": "Windows Server 2019", "Version": "10.0.17763"},
                "System": {"Model": "PowerEdge R640"},
                "Network": {"TCPIP": {"IPAddress": "192.0.2.14"}}
              }
            ],
            "@odata.nextLink": "$BASE/api/apigatewaydataservices/v1/devices?$scrollID=page3"
          }
        }
      ],
      "when_exhausted": "empty"
    },
    {
      "name": "devices-page-1",
      "match": {"method": "GET", "path": "/api/apigatewaydataservices/v1/devices"},
      "responses": [
        {
          "status": 200,
          "json": {
            "@odata.count": 5,
            "value": [
              {
                "DiscoveryId": "22220000-4a11-4c31-9c31-1a2b3c4d5e01",
                "DeviceID": "device-0001",
                "DeviceName": "workstation-01.example.com",
                "DisplayName": "Workstation 01",
                "OS": {"Name": "Windows 11 Pro", "Version": "10.0.22631"},
                "System": {"Model": "OptiPlex 7090"},
                "Network": {"TCPIP": {"IPAddress": "192.0.2.11"}}
              },
              {
                "DiscoveryId": "22220000-4a11-4c31-9c31-1a2b3c4d5e02",
                "DeviceID": "device-0002",
                "DeviceName": "laptop-02.example.com",
                "DisplayName": "Laptop 02",
                "OS": {"Name": "Windows 10 Enterprise", "Version": "10.0.19045"},
                "System": {"Model": "Latitude 5420"},
                "Network": {"TCPIP": {"IPAddress": "192.0.2.12"}}
              }
            ],
            "@odata.nextLink": "$BASE/api/apigatewaydataservices/v1/devices?$scrollID=page2"
          }
        }
      ],
      "when_exhausted": "empty"
    }
  ],
  "default_response": {"status": 404, "text": "no fixture route"},
  "expect": {
    "asset_count": 5,
    "ids": [
      "ivanti-neurons:fixture-tenant:22220000-4a11-4c31-9c31-1a2b3c4d5e01",
      "ivanti-neurons:fixture-tenant:22220000-4a11-4c31-9c31-1a2b3c4d5e02",
      "ivanti-neurons:fixture-tenant:22220000-4a11-4c31-9c31-1a2b3c4d5e03",
      "ivanti-neurons:fixture-tenant:22220000-4a11-4c31-9c31-1a2b3c4d5e04",
      "ivanti-neurons:fixture-tenant:22220000-4a11-4c31-9c31-1a2b3c4d5e05"
    ],
    "assets": [
      {
        "id": "ivanti-neurons:fixture-tenant:22220000-4a11-4c31-9c31-1a2b3c4d5e05",
        "fields": {"hostnames": "kiosk-05.example.com", "ipAddresses": "192.0.2.15"}
      }
    ],
    "request_count": 4,
    "requests_include": [
      {"method": "GET", "path": "/api/apigatewaydataservices/v1/token"},
      {"method": "GET", "path": "/api/apigatewaydataservices/v1/devices", "header_contains": "Bearer fixture-jwt-token"},
      {"method": "GET", "path": "/api/apigatewaydataservices/v1/devices", "query_contains": "scrollID=page2"},
      {"method": "GET", "path": "/api/apigatewaydataservices/v1/devices", "query_contains": "scrollID=page3"}
    ]
  },
  "invariants": {
    "skip": []
  }
}
