          },
          "text": "<?xml version=\"1.0\" encoding=\"utf-8\"?><Content><Items count=\"2\"><Device><ID>11</ID><Platform>macOS</Platform><LocalIPAddress>10.30.0.11</LocalIPAddress><MACAddress>00:11:22:BB:00:11</MACAddress><Status>Active</Status><LastReported>20.08.2026 07:45:00</LastReported><InvDevice><DeviceName>mac-eng-11</DeviceName><Manufacturer>Apple</Manufacturer><Model>Mac14,10</Model><MarketingName>MacBook Pro</MarketingName><SerialNumber>SN-MIR-0011</SerialNumber></InvDevice><InvOS><Platform>macOS</Platform><Version>15.1</Version></InvOS><Security><EncryptionStatus>Encrypted</EncryptionStatus><PasscodePresent>true</PasscodePresent><JailBroken>false</JailBroken></Security><Enrollment><Type>DEP</Type><EnrolledTime>04.02.2025 09:00:00</EnrolledTime></Enrollment><InvApplications><InvApplication><Name>Safari</Name><Version>18.1</Version><Identifier>com.apple.Safari</Identifier><Size>264241152</Size></InvApplication><InvApplication><Name>Slack</Name><Version>4.41.0</Version><Vendor>Slack Technologies</Vendor><Identifier>com.tinyspeck.slackmacgap</Identifier><Size>0</Size></InvApplication></InvApplications></Device><Device><ID>12</ID><Platform>iOS</Platform><LocalIPAddress>10.30.0.12</LocalIPAddress><MACAddress>00:11:22:BB:00:12</MACAddress><Status>Active</Status><InvDevice><DeviceName>ipad-lobby-12</DeviceName><Manufacturer>Apple</Manufacturer><Model>iPad13,4</Model><MarketingName>iPad Pro</MarketingName></InvDevice><InvOS><Platform>iOS</Platform><Version>18.1</Version></InvOS></Device></Items></Content>"
        }
      ],
      "when_exhausted": "repeat_last"
