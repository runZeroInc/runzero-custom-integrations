              "value": "RZ-0011"
            }
          ]
        }
      ],
      "when_exhausted": "repeat_last"
    },
    {
      "name": "location",
      "match": {
        "method": "GET",
        "path_regex": "/Location"
      },
      "responses": [
        {
          "status": 200,
          "json": [
