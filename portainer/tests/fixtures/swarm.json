            "Labels": [],
            "ServerVersion": "27.0.1",
            "Swarm": {
              "NodeID": "k67qz4598weg5unwwffg6z1m1",
              "NodeAddr": "192.0.2.71",
              "LocalNodeState": "active",
              "ControlAvailable": true,
              "Error": "",
              "RemoteManagers": [
                {"NodeID": "k67qz4598weg5unwwffg6z1m1", "Addr": "192.0.2.71:2377"}
