{
  "name": "swarm",
  "integration": "portainer",
  "description": "A Swarm manager. Swarm is the one place the Docker API reports routable addresses for machines other than the daemon being queried: /info gives the local node's advertise address in Swarm.NodeAddr, and GET /nodes gives every other node's address in Status.Addr. Proves the swarm node listing is only requested when LocalNodeState is active, that each node becomes its own asset keyed on the swarm node ID, and that a worker with no ManagerStatus is handled. Node fields follow the Node schema in moby/moby api/swagger.yaml.",

  "kwargs": {
    "url": "$BASE",
    "mode": "portainer",
    "api_key": "ptr_fixtureAPIKeyValue0000000000000000000000=",
    "import_containers": "none",
    "import_published_ports": "false"
  },

  "routes": [
    {
      "name": "endpoints",
      "match": {"method": "GET", "path": "/api/endpoints"},
      "responses": [
        {
          "status": 200,
          "json": [
            {"Id": 7, "Name": "swarm-prod", "Type": 1, "URL": "unix:///var/run/docker.sock", "Status": 1, "Snapshots": []}
          ]
        }
      ],
      "when_exhausted": "empty"
    },
    {
      "name": "info",
      "match": {"method": "GET", "path": "/api/endpoints/7/docker/info"},
      "responses": [
        {
          "status": 200,
          "json": {
            "ID": "9f8e7d6c-5b4a-4392-8180-7f6e5d4c3b2a",
            "Containers": 12,
            "ContainersRunning": 12,
            "Images": 40,
            "Driver": "overlay2",
            "KernelVersion": "5.15.0-113-generic",
            "OperatingSystem": "Ubuntu 22.04.4 LTS",
            "OSVersion": "22.04",
            "OSType": "linux",
            "Architecture": "x86_64",
            "NCPU": 16,
            "MemTotal": 33537572864,
