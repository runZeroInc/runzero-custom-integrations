              "Cluster": {"ID": "abajmipo7b4xz5ip2nrla6b11", "CreatedAt": "2026-02-18T10:44:24.496525531Z", "DataPathPort": 4789}
            }
          }
        }
      ]
    },
    {
      "name": "nodes",
      "match": {"method": "GET", "path": "/api/endpoints/7/docker/nodes"},
      "responses": [
        {
          "status": 200,
          "json": [
            {
              "ID": "k67qz4598weg5unwwffg6z1m1",
              "Version": {"Index": 373531},
              "CreatedAt": "2026-02-18T10:44:24.496525531Z",
