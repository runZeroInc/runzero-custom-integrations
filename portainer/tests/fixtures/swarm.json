              "Spec": {"Name": "", "Labels": {"rack": "a1"}, "Role": "manager", "Availability": "active"},
              "Description": {
                "Hostname": "swarm-mgr-01",
                "Platform": {"Architecture": "x86_64", "OS": "linux"},
                "Resources": {"NanoCPUs": 16000000000, "MemoryBytes": 33537572864},
                "Engine": {"EngineVersion": "27.0.1", "Labels": {"site": "hq"}}
