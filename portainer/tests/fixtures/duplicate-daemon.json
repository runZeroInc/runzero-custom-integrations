  "default_response": {"status": 404, "text": "no fixture route"},
  "expect": {
    "asset_count": 3,
    "ids": [
      "docker:$HOST:host:bea7c305-c44d-475b-8c73-6f4215a5c947",
      "docker:$HOST:bea7c305-c44d-475b-8c73-6f4215a5c947:container:homeassistant",
      "docker:$HOST:host:c91f0a22-7f18-4a2c-9e55-1b7d9c0e4411"
    ],
    "assets": [
