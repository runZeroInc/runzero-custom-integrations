{
  "name": "software",
  "integration": "absolute",
  "description": "The optional second pass over the applications report. The report is sorted by deviceUid so a device's rows can straddle a page boundary; this proves the partial group is carried across the boundary and flushed only when the next deviceUid appears, that a row with no appName is dropped, and that a repeated deviceAppId is deduplicated. unique_ids and has_correlator are skipped deliberately: the software pass emits a second ImportAsset carrying only the id and the software list, so the same foreign id is emitted twice in one run and the second copy has no MAC, IP, or hostname of its own. That is how the enrichment pass is designed to merge, and it is reported as a finding rather than asserted as correct.",
  "kwargs": {
    "api_host": "$BASE",
    "token_id": "fixture-token-id",
    "secret_key": "fixture-secret-key",
    "import_software": "true",
    "page_size": "3"
  },
  "routes": [
    {
      "name": "jws-validate",
      "match": {"method": "POST", "path": "/jws/validate"},
      "responses": [
        {
