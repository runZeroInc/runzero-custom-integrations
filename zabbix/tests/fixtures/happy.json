{
  "name": "happy",
  "integration": "zabbix",
  "description": "A full Zabbix collection: an unauthenticated apiinfo.version probe, a hostgroup.get to enumerate the groups that bound the response, and one host.get carrying interfaces, the extended inventory, tags, and host groups. Every scalar in the host rows is a JSON STRING, which is what Zabbix really returns ('the Zabbix API always returns values as strings or arrays only'); the field set and the string typing follow a real 22-host production dump from a Zabbix 7.x server, and the interface and inventory shapes follow the vendor's own host.get and hostinterface.get examples. Proves: the version probe carries NO Authorization header while every other call does; selectInventory answering with an empty ARRAY on a host with inventory disabled does not abort; a free-text macaddress_a that is not a MAC is rejected instead of reaching an interface; an interface addressed by DNS with an empty ip produces no Service; a port that is a {$MACRO} reference produces no Service; a status-1 host is dropped even though the server returned it; and the inventory date_hw_expiry sitting in the year 2030 is kept as an attribute and never becomes a timestamp, because a future timestamp makes the platform reject the entire asset record.",
  "kwargs": {
    "url": "$BASE",
    "api_token": "fixture-api-token-0123456789abcdef"
  },
  "routes": [
    {
      "name": "apiinfo",
      "match": {"method": "POST", "path": "/api_jsonrpc.php", "body_contains": "apiinfo.version"},
      "responses": [{"status": 200, "json": {"jsonrpc": "2.0", "result": "7.0.13", "id": 1}}],
      "when_exhausted": "repeat_last"
    },
    {
      "name": "hostgroup-get",
      "match": {"method": "POST", "path": "/api_jsonrpc.php", "body_contains": "hostgroup.get"},
      "responses": [
        {
          "status": 200,
          "json": {
            "jsonrpc": "2.0",
            "result": [
              {"groupid": "4", "name": "Zabbix servers"},
              {"groupid": "19", "name": "Linux servers"}
            ],
            "id": 2
          }
        }
      ],
      "when_exhausted": "repeat_last"
    },
    {
      "name": "host-get",
      "match": {"method": "POST", "path": "/api_jsonrpc.php", "body_contains": "host.get"},
