  "expect": {
    "asset_count": 3,
    "ids": [
      "palo-alto-device-security:1234567890:00:11:22:33:44:55",
      "palo-alto-device-security:1234567890:10.44.7.5",
      "palo-alto-device-security:1234567890:10.44.0.99"
    ],
    "min_requests": 3,
    "requests_include": [
      {"method": "POST", "path": "/oauth2/access_token", "body_contains": "tsg_id"},
      {"method": "GET", "path": "/iot/pub/v1/vulnerability/list", "query_contains": "groupby=device"},
      {"method": "GET", "path": "/iot/pub/v2/device/list", "query_contains": "pagelength=500"},
      {"header_contains": "fixture-access-token"}
    ],
    "log_contains": [
      "indexed 3 vulnerabilities across 2 devices",
      "reported 1 devices seen only in vulnerability data"
    ]
  },
  "invariants": {
    "skip": ["no_mac_in_id"]
  }
}
