{
  "name": "happy",
  "integration": "palo-alto-device-security",
  "description": "OAuth token exchange, one page of confirmed vulnerabilities, one page of devices. Covers a MAC-shaped deviceid, a static-IP-shaped deviceid, and a device that exists only in vulnerability data. no_mac_in_id is skipped because IoT Security documents deviceid AS the device MAC (or its IP for static-IP-only devices); that is exactly why the script sets no-id-match no-id-break, and the id is still emitted so the record has a stable key.",
  "kwargs": {
    "url": "$BASE",
    "auth_url": "$BASE",
    "tsg_id": "1234567890",
    "client_id": "fixture-client",
    "client_secret": "fixture-secret",
    "lookback_days": "30"
  },
  "routes": [
    {
      "name": "token",
      "match": {"method": "POST", "path": "/oauth2/access_token"},
      "responses": [
        {"status": 200, "json": {"access_token": "fixture-access-token", "token_type": "Bearer", "expires_in": 899}}
      ]
    },
    {
      "name": "vulnerabilities",
      "match": {"method": "GET", "path": "/iot/pub/v1/vulnerability/list"},
      "responses": [
        {
          "status": 200,
          "json": {
            "total": 2,
            "items": [
              {
                "deviceid": "00:11:22:33:44:55",
                "name": "clinic-pump-01",
                "ip": "10.44.0.10",
                "vendor": "Acme Medical",
                "model": "PumpMaster 3000",
                "os": "AcmeOS",
                "zb_ticketid": "TICKET-1001",
                "vulnerability_name": "CVE-2025-11001",
                "risk_level": "Critical",
                "risk_score": 92,
                "ticketState": "Confirmed",
                "detected_date": "2026-07-30T09:15:00Z",
                "remediate_instruction": "Apply vendor firmware 4.2.1.",
                "display_profile_category": "Infusion System",
                "siteid": "site-north"
              },
              {
                "deviceid": "00:11:22:33:44:55",
                "name": "clinic-pump-01",
                "ip": "10.44.0.10",
                "zb_ticketid": "TICKET-1002",
                "vulnerability_name": "Weak TLS configuration",
                "risk_level": "Medium",
                "detected_date": "2026-08-01T11:00:00Z"
              },
              {
                "deviceid": "10.44.0.99",
