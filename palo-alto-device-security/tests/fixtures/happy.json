              }
            ]
          }
        },
        {"status": 200, "json": {"items": []}}
      ],
      "when_exhausted": "empty"
    },
    {
      "name": "devices",
      "match": {"method": "GET", "path": "/iot/pub/v2/device/list"},
      "responses": [
        {
          "status": 200,
          "json": {
            "total": 2,
            "devices": [
              {
                "deviceid": "00:11:22:33:44:55",
