        "fields": {
          "hostnames": "kube-proxy-x7k2m.kube-system.pod",
          "k8s.pod.host_network": "true",
          "k8s.pod.pod_ip": "10.40.0.11"
        },
        "fields_absent": ["ipAddresses", "macAddresses"]
      }
    ],
    "min_software_total": 4,
    "request_count": 2,
    "requests_include": [
      {"method": "GET", "path": "/api/v1/nodes"},
      {"method": "GET", "path": "/api/v1/pods"},
      {"header_contains": "fixture-sa-token"}
    ],
    "requests_absent": [
      {"path": "/api/v1/services"}
    ],
    "log_contains": [
      "kubernetes: skipped 1 pods with no metadata.uid (first name: pod-with-no-uid)",
      "kubernetes: imported 2 pods"
    ]
  },
  "invariants": {
    "skip": ["namespaced_ids"]
  },
  "check_determinism": true
}
