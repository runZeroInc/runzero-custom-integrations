          }
        }
      ],
      "when_exhausted": "empty"
    }
  ],
  "expect": {
    "asset_count": 3,
    "ids": [
      "bitdefender-gravityzone:127.0.0.1:c0000000000000000000a1:e0000000000000000000001",
      "bitdefender-gravityzone:127.0.0.1:c0000000000000000000a1:e0000000000000000000002",
      "bitdefender-gravityzone:127.0.0.1:c0000000000000000000a1:e0000000000000000000003"
    ],
    "request_count": 2,
    "requests_include": [
      {"method": "POST", "path": "/api/v1.0/jsonrpc/companies", "body_contains": "getCompanyDetails"},
      {"method": "POST", "path": "/api/v1.1/jsonrpc/network", "body_contains": "getNetworkInventoryItems"},
      {"header_contains": "Basic Zml4dHVyZS1rZXk6"}
    ],
    "requests_absent": [
      {"body_contains": "getManagedEndpointDetails"}
    ],
    "log_contains": [
      "importing under company c0000000000000000000a1 (Fixture Holdings)",
      "skipping inventory item with no id: name=orphan-no-id",
      "skipped 1 inventory items that are not endpoints",
      "reported 3 endpoints"
    ]
  },
  "invariants": {
    "skip": []
  }
}
