{
  "name": "detail-cap",
  "integration": "bitdefender-gravityzone",
  "description": "Opt-in N+1 enrichment with detail_limit=2 over four endpoints. Proves exactly two getManagedEndpointDetails calls are made (the detail route errors if asked a third time), that the endpoints past the cap are still imported from the listing alone, and that the skip count is logged. Also proves the future-timestamp clamp: the first detail reports a lastSeen in 2099, which runZero would reject outright, and the asset must still survive.",
  "kwargs": {
    "url": "$BASE",
    "api_key": "fixture-key",
    "parent_id": "c0000000000000000000c3",
    "fetch_details": "true",
    "detail_limit": "2"
  },
  "routes": [
