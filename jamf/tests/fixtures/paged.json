{
  "name": "paged",
  "integration": "jamf",
  "description": "Two pages of computers-inventory and two pages of mobile-devices/detail. Proves the second call carries page=1 (Jamf pages are 0-based), that the per-device detail fetch runs for the devices on page 2 as well as page 1, and that both walks stop on the first empty results array rather than looping forever. The mobile walk is included because it uses a different endpoint with the same page/page-size vocabulary and its own filter, and a paging bug in one is invisible from the other.\n\nnamespaced_ids is skipped for the same reason as happy: the id is a bare Jamf udid with no tenant scope. Reported as a bug rather than fixed here.",
  "kwargs": {
    "url": "$BASE",
    "client_id": "fixture-client",
    "client_secret": "fixture-secret"
  },
  "routes": [
    {
      "name": "oauth-token",
      "match": {"method": "POST", "path": "/api/oauth/token"},
      "responses": [{"status": 200, "json": {"access_token": "fixture-token-1", "expires_in": 3600, "token_type": "Bearer"}}],
      "when_exhausted": "repeat_last"
    },
    {
      "name": "computers-page-0",
      "match": {"method": "GET", "path": "/api/v1/computers-inventory", "query_contains": "page=0"},
      "responses": [{"status": 200, "json": {"totalCount": 2, "results": [{"id": "101"}]}}],
      "when_exhausted": "error"
    },
    {
      "name": "computers-page-1",
      "match": {"method": "GET", "path": "/api/v1/computers-inventory", "query_contains": "page=1"},
      "responses": [{"status": 200, "json": {"totalCount": 2, "results": [{"id": "102"}]}}],
      "when_exhausted": "error"
    },
    {
      "name": "computers-page-2-empty",
      "match": {"method": "GET", "path": "/api/v1/computers-inventory", "query_contains": "page=2"},
      "responses": [{"status": 200, "json": {"totalCount": 2, "results": []}}],
      "when_exhausted": "repeat_last"
    },
    {
      "name": "computer-detail-101",
      "match": {"method": "GET", "path": "/api/v1/computers-inventory-detail/101"},
      "responses": [
        {
          "status": 200,
          "json": {
            "udid": "AAAA1111-0000-4000-8000-000000000101",
            "general": {"displayName": "syn-mac-101", "lastIpAddress": "10.40.1.101"},
            "hardware": {"macAddress": "00:50:56:00:40:01", "model": "MacBookPro18,3", "make": "Apple", "serialNumber": "SYNSER0000101"},
            "operatingSystem": {"name": "macOS", "version": "14.4.1"}
          }
        }
      ],
      "when_exhausted": "repeat_last"
    },
    {
      "name": "computer-detail-102",
      "match": {"method": "GET", "path": "/api/v1/computers-inventory-detail/102"},
      "responses": [
        {
          "status": 200,
          "json": {
            "udid": "AAAA1111-0000-4000-8000-000000000102",
            "general": {"displayName": "syn-mac-102", "lastIpAddress": "10.40.1.102"},
            "hardware": {"macAddress": "00:50:56:00:40:02", "model": "MacBookAir10,1", "make": "Apple", "serialNumber": "SYNSER0000102"},
            "operatingSystem": {"name": "macOS", "version": "13.6.6"}
          }
        }
      ],
      "when_exhausted": "repeat_last"
    },
    {
      "name": "mobile-page-0",
      "match": {"method": "GET", "path": "/api/v2/mobile-devices/detail", "query_contains": "page=0"},
      "responses": [{"status": 200, "json": {"totalCount": 2, "results": [{"mobileDeviceId": "201"}]}}],
      "when_exhausted": "error"
    },
    {
      "name": "mobile-page-1",
      "match": {"method": "GET", "path": "/api/v2/mobile-devices/detail", "query_contains": "page=1"},
      "responses": [{"status": 200, "json": {"totalCount": 2, "results": [{"mobileDeviceId": "202"}]}}],
      "when_exhausted": "error"
    },
    {
      "name": "mobile-page-2-empty",
      "match": {"method": "GET", "path": "/api/v2/mobile-devices/detail", "query_contains": "page=2"},
      "responses": [{"status": 200, "json": {"totalCount": 2, "results": []}}],
      "when_exhausted": "repeat_last"
    },
    {
      "name": "mobile-detail-201",
      "match": {"method": "GET", "path": "/api/v2/mobile-devices/201/detail"},
      "responses": [
        {
          "status": 200,
          "json": {
            "udid": "BBBB2222-0000-4000-8000-000000000201",
            "name": "syn ipad 201",
            "model": "iPad13,1",
            "wifiMacAddress": "00:50:56:00:40:11",
            "general": {"osVersion": "17.4.1", "ipAddress": "10.40.2.201"}
          }
        }
      ],
      "when_exhausted": "repeat_last"
    },
    {
      "name": "mobile-detail-202",
      "match": {"method": "GET", "path": "/api/v2/mobile-devices/202/detail"},
      "responses": [
        {
          "status": 200,
          "json": {
            "udid": "BBBB2222-0000-4000-8000-000000000202",
            "name": "syn iphone 202",
            "model": "iPhone14,5",
            "wifiMacAddress": "00:50:56:00:40:12",
            "general": {"osVersion": "17.5.1", "ipAddress": "10.40.2.202"}
          }
        }
      ],
      "when_exhausted": "repeat_last"
    }
  ],
  "expect": {
    "asset_count": 4,
    "ids": [
      "AAAA1111-0000-4000-8000-000000000101",
      "AAAA1111-0000-4000-8000-000000000102",
      "BBBB2222-0000-4000-8000-000000000201",
      "BBBB2222-0000-4000-8000-000000000202"
    ],
    "requests_include": [
      {"method": "GET", "path": "/api/v1/computers-inventory", "query_contains": "page=1"},
      {"method": "GET", "path": "/api/v1/computers-inventory", "query_contains": "page=2"},
      {"method": "GET", "path": "/api/v1/computers-inventory-detail/102"},
      {"method": "GET", "path": "/api/v2/mobile-devices/detail", "query_contains": "page=1"},
      {"method": "GET", "path": "/api/v2/mobile-devices/202/detail"}
    ],
    "requests_absent": [
      {"path": "/api/v1/computers-inventory", "query_contains": "page=3"},
      {"path": "/api/v2/mobile-devices/detail", "query_contains": "page=3"}
    ]
  },
  "invariants": {"skip": ["namespaced_ids"]}
}
