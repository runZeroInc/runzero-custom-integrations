      "responses": [{"status": 200, "json": {"totalCount": 0, "results": []}}],
      "when_exhausted": "repeat_last"
    }
  ],
  "expect": {
    "asset_count": 5,
    "assets": [
      {
        "id": "CCCC3333-0000-4000-8000-000000000301",
        "fields": {
          "ipAddresses": "10.41.0.31",
          "macAddresses": "00:50:56:00:41:01\t00:50:56:00:41:02",
          "macPairs": "00:50:56:00:41:01=10.41.0.31"
        }
      },
      {
        "id": "CCCC3333-0000-4000-8000-000000000302",
        "fields": {"ipAddresses": "100.100.5.20", "macAddresses": "00:50:56:00:41:03"}
      },
      {
        "id": "CCCC3333-0000-4000-8000-000000000303",
        "fields": {"ipAddresses": "fd12:3456:789a::20", "macAddresses": "00:50:56:00:41:04"}
      },
      {
        "id": "CCCC3333-0000-4000-8000-000000000304",
        "fields": {"macAddresses": "00:50:56:00:41:05"},
        "fields_absent": ["ipAddresses"]
      },
      {
        "id": "CCCC3333-0000-4000-8000-000000000305",
        "fields": {"ipAddresses": "172.20.5.6", "macAddresses": "00:50:56:00:41:06"}
      }
    ],
    "requests_include": [
      {"method": "POST", "path": "/api/oauth/token"},
      {"method": "GET", "path": "/api/v1/computers-inventory-detail/301"}
    ]
  },
  "invariants": {"skip": ["namespaced_ids"]},
  "check_determinism": true
}
