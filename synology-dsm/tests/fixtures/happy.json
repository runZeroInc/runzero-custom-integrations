{
  "name": "happy",
  "integration": "synology-dsm",
  "description": "A full collection from a DSM 7 NAS with Virtual Machine Manager, Surveillance Station, Active Backup for Business, and the DHCP Server package installed. Proves the whole design rests on API DISCOVERY rather than hardcoding: SYNO.API.Info is queried first, and the CGI path and version range it returns are what every later call uses - which matters because SYNO.API.Auth lives at auth.cgi on DSM 6 and entry.cgi on DSM 7, and because SYNO.DSM.Info and SYNO.DSM.Network are version 2 ONLY. Discovery is also what makes the optional packages safe: a NAS without Surveillance Station is never asked about cameras. Also proves: login is a POST with a form-encoded body so the password never enters a URL, and enable_syno_token is requested so a CSRF-hardened DSM works; the returned synotoken is sent back as X-SYNO-TOKEN on every later call; the chassis serial becomes a real foreign id that IS allowed to drive merges; DSM's dash-separated upper-case MACs are canonicalised; a PPPoE interface with no mac key and an interface holding only APIPA are both handled; VMM guest MACs come from the OFFICIAL SYNO.Virtualization.API.Guest, whose vnics array the internal SYNO.Virtualization.Guest does not have; a camera's address arrives in `host` and may be an IP or a name; and the session is ended with an explicit logout, because DSM allows few concurrent sessions. Camera 1's display name 'Front Door' is an operator label, not a machine name: it carries a space, so it must land in synology_camera_name and NOT in hostnames, where it would be a merge hazard. no_mac_in_id is skipped: a DHCP lease has no identifier but its MAC, deliberately paired with no-id-match no-id-break.",
  "kwargs": {
    "url": "$BASE",
    "username": "fixture-runzero",
    "password": "fixture-password",
    "dhcp_interfaces": "bond0"
  },
  "routes": [
    {
      "name": "api-info",
      "match": {"method": "GET", "path": "/webapi/query.cgi"},
      "responses": [
        {
          "status": 200,
          "json": {
            "success": true,
            "data": {
              "SYNO.API.Info": {"path": "entry.cgi", "minVersion": 1, "maxVersion": 1},
              "SYNO.API.Auth": {"path": "entry.cgi", "minVersion": 1, "maxVersion": 7},
              "SYNO.DSM.Info": {"path": "entry.cgi", "minVersion": 2, "maxVersion": 2, "requestFormat": "JSON"},
              "SYNO.DSM.Network": {"path": "entry.cgi", "minVersion": 2, "maxVersion": 2, "requestFormat": "JSON"},
              "SYNO.Core.System": {"path": "entry.cgi", "minVersion": 1, "maxVersion": 3, "requestFormat": "JSON"},
              "SYNO.Virtualization.API.Guest": {"path": "entry.cgi", "minVersion": 1, "maxVersion": 1, "requestFormat": "JSON"},
              "SYNO.SurveillanceStation.Camera": {"path": "entry.cgi", "minVersion": 1, "maxVersion": 9, "requestFormat": "JSON"},
              "SYNO.ActiveBackup.Task": {"path": "entry.cgi", "minVersion": 1, "maxVersion": 2, "requestFormat": "JSON"},
              "SYNO.Network.DHCPServer.ClientList": {"path": "entry.cgi", "minVersion": 1, "maxVersion": 2, "requestFormat": "JSON"}
            }
          }
        }
      ],
      "when_exhausted": "repeat_last"
    },
    {
