{
  "name": "vuln-cap",
  "integration": "ghost",
  "description": "One repository with 120 findings. runZero rejects an asset carrying more than 99 children, so the bucket must stop at 99 and count the overflow -- the child_caps invariant would fail on an over-cap asset, and the log line proves the truncation is announced rather than silent.\n\nnamespaced_ids is skipped because the foreign id is the bare repository name with no tenant scope -- a known defect outside the scope of this change.",
  "kwargs": {
    "url": "$BASE",
    "api_token": "fixture-ghost-token"
  },
  "routes": [
    {
      "name": "repos",
      "match": {
        "method": "GET",
        "path": "/v1/repos"
      },
      "responses": [
        {
          "status": 200,
          "json": {
            "has_more": false,
            "items": [
              {
                "id": "repo-cap",
                "name": "capped-service",
                "projects": [
                  {
                    "deployments": {
                      "production": [
                        "https://capped.example.com"
                      ]
                    }
                  }
                ]
              }
            ]
          }
        }
      ],
      "when_exhausted": "error"
    },
    {
      "name": "findings",
