    "ids": ["uptycs:fixturecust:a1", "uptycs:fixturecust:a2"],
    "assets": [
      {"id": "uptycs:fixturecust:a2", "fields": {"deviceType": "Server"}},
      {"id": "uptycs:fixturecust:a1", "fields_absent": ["deviceType"]}
    ],
    "request_count": 10,
    "requests_include": [
      {"method": "POST", "path": "/public/api/customers/fixturecust/query", "body_contains": "SELECT * FROM upt_assets ORDER BY id LIMIT 200 OFFSET 0"},
      {"body_contains": "upt_asset_id IN ('a1','a2')"},
      {"body_contains": "upt_day >="},
      {"header_contains": "Bearer "}
    ],
