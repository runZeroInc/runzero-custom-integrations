              {"asset_id": "a1", "interface": "eth0", "address": "2001:db8:150::10"},
              {"asset_id": "a1", "interface": "lo", "address": "127.0.0.1"},
              {"asset_id": "a1", "interface": "docker0", "address": "169.254.5.5"},
