              {"asset_id": "a2", "interface": "vEthernet (Default Switch)", "address": "169.254.7.7"},
              {"asset_id": "a2", "interface": "veth9", "address": "169.254.8.8"},
              {"asset_id": "a2", "interface": "docker0", "address": "169.254.9.9"}
