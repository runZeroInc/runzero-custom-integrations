              {"asset_id": "a1", "address": "10.150.1.10", "port": 443, "protocol": 6, "pid": 2345, "path": "/usr/sbin/nginx"},
              {"asset_id": "a1", "address": "127.0.0.1", "port": 5432, "protocol": 6, "pid": 3456, "path": "/usr/lib/postgresql/bin/postgres"},
              {"asset_id": "a1", "address": "0.0.0.0", "port": 0, "protocol": 6, "pid": 4567, "path": ""},
              {"asset_id": "a1", "address": "10.150.1.10", "port": 53, "protocol": 17, "pid": 5678, "path": "/usr/sbin/named"},
              {"asset_id": "a1", "address": "10.150.1.10", "port": 9999, "protocol": 47, "pid": 6789, "path": "/opt/weird"},
              {"asset_id": "a2", "address": "0.0.0.0", "port": 8080, "protocol": 6, "pid": 7890, "path": "C:\\svc.exe"}
            ]
          }
        }
      ],
      "when_exhausted": "empty"
    },
    {
      "name": "vulnerabilities",
      "match": {"method": "POST", "body_contains": "FROM upt_vulnerabilities_state"},
      "responses": [
        {
          "status": 200,
          "json": {
            "items": [
              {"upt_asset_id": "a1", "cve_list": "CVE-2026-77777", "title": "OpenSSL remote code execution", "description": "A synthetic finding for fixture purposes.", "uptycs_severity": "HIGH", "cvss_score": 8.8, "package_name": "openssl", "package_version": "3.0.2-0ubuntu1.15", "solution": "Upgrade openssl"},
              {"upt_asset_id": "a1", "cve_list": "CVE-2026-77777", "title": "OpenSSL remote code execution", "uptycs_severity": "HIGH", "cvss_score": 8.8, "package_name": "openssl", "package_version": "3.0.2-0ubuntu1.15"},
              {"upt_asset_id": "a2", "cve_list": "CVE-2025-88888", "title": "Edge sandbox escape", "uptycs_severity": "MEDIUM", "cvss_score": 5.4, "package_name": "Microsoft Edge"}
