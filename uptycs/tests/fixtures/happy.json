{
  "name": "happy",
  "integration": "uptycs",
  "description": "One upt_assets page with every enrichment table enabled. The point of this scenario is the virtual-adapter filter on interface names: interface_details and interface_addresses report eth0, docker0, veth123, vEthernet (Default Switch) and lo, and only eth0 may become a network interface. The four virtual adapters are deliberately given 169.254.0.0/16 addresses, so if the name filter ever regresses the no_loopback_interfaces invariant fires on the leaked link-local address. Asset a2 owns nothing but virtual adapters and must therefore come out with NO interface at all, correlating on hostname alone.\n\nAlso covers: the locally-signed HS256 JWT (there is no token endpoint to route, so the run must reach the query endpoint on its first request); wildcard 0.0.0.0 listening_ports rows resolving to the asset's primary IP while an asset with no primary IP drops its wildcard row instead of inventing an address; and the future-timestamp clamp on a2's last_activity_at of 2099, which runZero would otherwise reject outright, dropping the whole record.\n\nThe two assets also bracket the device-type hint. a2 runs Windows Server 2022 on a 'Microsoft Corporation / Virtual Machine' chassis, which tells runZero's hardware fingerprinter nothing, so the OS product name is the only statement of role there is and must reach deviceType. a1 runs Ubuntu, which is a desktop as often as a server, so it must carry NO deviceType rather than a guess.",
  "kwargs": {
    "url": "$BASE",
    "customer_id": "fixturecust",
    "api_key": "fixture-key",
    "api_secret": "fixture-secret",
    "include_host_details": "true",
    "include_software": "true",
    "include_services": "true",
    "include_vulnerabilities": "true",
    "vulnerability_table": "upt_vulnerabilities_state"
  },
  "routes": [
    {
      "name": "upt-assets",
      "match": {"method": "POST", "path": "/public/api/customers/fixturecust/query", "body_contains": "FROM upt_assets"},
      "responses": [
        {
          "status": 200,
          "json": {
            "items": [
              {
                "id": "a1",
                "host_name": "web-a1",
                "os": "Ubuntu",
                "os_version": "22.04",
                "os_flavor": "ubuntu",
                "osquery_version": "5.10.2",
                "status": "active",
                "live": true,
                "hardware_vendor": "Dell Inc.",
                "hardware_model": "PowerEdge R650",
                "cores": 16,
                "memory_mb": 65536,
                "cpu_brand": "Intel(R) Xeon(R) Silver 4314",
                "created_at": "2025-02-01 10:00:00.000",
                "last_activity_at": "2026-08-14 12:00:00.000"
              },
              {
                "id": "a2",
                "host_name": "iso-a2",
                "os": "Windows Server 2022",
                "os_version": "10.0.20348",
                "os_flavor": "windows",
                "osquery_version": "5.10.2",
                "status": "active",
                "hardware_vendor": "Microsoft Corporation",
                "hardware_model": "Virtual Machine",
                "created_at": "2025-06-01 08:00:00.000",
                "last_activity_at": "2099-01-01 00:00:00.000"
              },
              {
                "id": "",
                "host_name": "ghost-a3"
              }
            ]
          }
        }
      ],
      "when_exhausted": "empty"
    },
    {
      "name": "interface-details",
      "match": {"method": "POST", "body_contains": "FROM interface_details"},
      "responses": [
        {
          "status": 200,
          "json": {
            "items": [
              {"asset_id": "a1", "interface": "eth0", "mac": "00:50:56:a1:00:01"},
              {"asset_id": "a1", "interface": "lo", "mac": "00:00:00:00:00:00"},
              {"asset_id": "a1", "interface": "docker0", "mac": "02:42:ac:11:00:02"},
              {"asset_id": "a1", "interface": "veth123", "mac": "6a:11:22:33:44:55"},
              {"asset_id": "a2", "interface": "vEthernet (Default Switch)", "mac": "00:15:5d:00:0a:0b"},
              {"asset_id": "a2", "interface": "veth9", "mac": "6a:aa:bb:cc:dd:ee"},
              {"asset_id": "a2", "interface": "docker0", "mac": "02:42:ac:11:00:02"}
            ]
          }
        }
      ],
      "when_exhausted": "empty"
    },
    {
