{
  "name": "happy",
  "integration": "forescout-counteract",
  "description": "Full Web API walk: login mints a JWT, the host field index drives which properties are requested, and the per-host property documents produce classification, services, software, and CVE findings. Also covers the two skip paths -- a row with no hostId and a host whose only address is loopback with no MAC or name. The _match.behavior assertion is the point of the identity rule: the CounterACT object id is derived from the endpoint's IPv4 address, so it is kept as a record key but must never match or break a merge. Host 1002's all-zero index MAC must not reach an interface.",
  "kwargs": {
    "url": "$BASE",
    "username": "webapi-fixture",
    "password": "fixture-password",
    "include_details": "true"
  },
  "routes": [
    {
      "name": "login",
      "match": {
        "method": "POST",
        "path": "/api/login"
      },
      "responses": [
        {
          "status": 200,
          "text": "eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJmaXh0dXJlIn0.c2lnbmF0dXJlLWZpeHR1cmU"
        }
      ],
      "when_exhausted": "repeat_last"
    },
    {
      "name": "hostfields",
      "match": {
        "method": "GET",
        "path": "/api/hostfields"
      },
      "responses": [
        {
          "status": 200,
          "json": {
            "hostFields": [
              {
                "name": "hostname",
                "label": "Hostname"
              },
              {
                "name": "nbtdomain",
                "label": "NetBIOS Domain"
              },
              {
                "name": "os_classification",
                "label": "Operating System"
              },
              {
                "name": "prim_classification",
                "label": "Function"
              },
              {
                "name": "vendor_classification",
                "label": "Vendor and Model"
              },
              {
                "name": "mac_vendor_string",
                "label": "NIC Vendor"
              },
              {
                "name": "cl_type",
                "label": "Classified By"
              },
              {
                "name": "online",
                "label": "Online"
              },
              {
                "name": "onsite",
                "label": "Onsite"
              },
              {
                "name": "macs",
                "label": "MAC Addresses"
              },
              {
                "name": "openports",
                "label": "Open Ports"
              },
              {
                "name": "installed_applications",
                "label": "Windows Applications Installed"
              },
              {
                "name": "va_cve_list",
                "label": "Vulnerabilities"
              },
              {
                "name": "not_a_property name",
                "label": "Rejected by the field-name screen"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "host-detail-1001",
      "match": {
        "method": "GET",
        "path": "/api/hosts/1001"
      },
      "responses": [
        {
          "status": 200,
          "json": {
            "host": {
              "id": 1001,
              "ip": "10.20.30.40",
              "fields": {
                "hostname": {
                  "value": "acct-ws-01"
                },
                "nbtdomain": {
                  "value": "CORP"
                },
                "os_classification": {
                  "value": "Computer/Windows Machine/Windows 10"
                },
                "prim_classification": {
                  "value": "Computer/Desktop"
                },
                "vendor_classification": {
                  "value": "Dell Inc./OptiPlex 7090"
                },
                "mac_vendor_string": {
                  "value": "Dell Inc."
                },
                "cl_type": {
                  "value": "Classification Engine"
                },
                "online": {
                  "value": "true"
                },
                "onsite": {
                  "value": "true"
                },
                "macs": [
                  {
                    "value": "001122334455"
                  },
                  {
                    "value": "00:11:22:33:44:66"
                  }
                ],
                "openports": [
                  {
                    "value": "445/tcp"
                  },
                  {
                    "value": "3389"
