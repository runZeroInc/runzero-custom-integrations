                    "value": "7-Zip 23.01"
                  }
                ],
                "va_cve_list": [
                  {
                    "value": "cve-2024-12345 and CVE-2023-45678"
                  },
                  {
                    "value": "CVE-2024-12345"
                  }
                ]
              }
            }
          }
        }
      ]
    },
    {
      "name": "host-detail-1002",
      "match": {
        "method": "GET",
        "path": "/api/hosts/1002"
      },
      "responses": [
        {
          "status": 200,
          "json": {
            "host": {
              "id": 1002,
