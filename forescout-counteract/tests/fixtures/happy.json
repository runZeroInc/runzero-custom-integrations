      "responses": [
        {
          "status": 200,
          "json": {
            "hosts": [
              {
                "hostId": 1001,
                "ip": "10.20.30.40",
                "mac": "001122334455"
              },
              {
                "hostId": 1002,
                "ip": "10.20.30.41",
                "mac": "000000000000"
              },
              {
                "hostId": 1003,
                "ip": "127.0.0.1",
                "mac": "000000000000"
              },
              {
                "ip": "10.20.30.44",
                "mac": "00:11:22:33:44:99"
              }
            ]
          }
        }
      ]
    }
  ],
  "expect": {
    "asset_count": 2,
    "ids": [
      "forescout-counteract:$HOST:1001",
      "forescout-counteract:$HOST:1002"
    ],
    "min_requests": 6,
    "requests_include": [
      {
        "method": "POST",
        "path": "/api/login",
        "body_contains": "username=webapi-fixture"
      },
      {
        "method": "GET",
        "path": "/api/hostfields"
      },
      {
        "method": "GET",
        "path": "/api/hosts"
      },
      {
        "method": "GET",
        "path": "/api/hosts/1001",
        "query_contains": "fields=hostname"
      }
    ],
    "log_contains": [
      "forescout-counteract: skipping host with no object id: ip=10.20.30.44",
      "forescout-counteract: skipping host 1003 with no address, MAC, or name to correlate on",
      "the host index returned 4 hosts"
    ],
    "min_services_total": 3,
    "min_software_total": 2,
    "assets": [
      {
        "id": "forescout-counteract:$HOST:1001",
        "fields": {
          "hostnames": "acct-ws-01",
          "ipAddresses": "10.20.30.40",
          "macAddresses": "00:11:22:33:44:55\t00:11:22:33:44:66",
          "os": "Windows 10",
          "deviceType": "Desktop",
          "domain": "CORP",
          "manufacturer": "Dell Inc.",
          "model": "OptiPlex 7090",
          "forescout_counteract_detail_enriched": "true"
        }
      },
      {
        "id": "forescout-counteract:$HOST:1002",
        "fields": {
          "deviceType": "Industrial Control System",
          "ipAddresses": "10.20.30.41"
        },
        "fields_absent": [
          "macAddresses"
        ]
      }
    ],
    "min_vulnerabilities_total": 2
  },
  "invariants": {
    "skip": []
  }
}
