{
  "name": "malformed-details",
  "integration": "bitsight",
  "description": "REGRESSION LOCK on the .get-default-vs-null class inside build_vuln and build_asset. Every field here is PRESENT but null or re-typed, which .get defaults do not cover: a finding with 'dest_port': null used to die in int(None), an explicit-null cvss died in None.get('base'), a null remediation message died in string concatenation, and a non-string threat_groups member died in '\\n'.join. On the asset side a null hosted_by/findings/threats block, a non-string tag, a non-dict product, a non-dict row, and a row with no asset name are all served together. One record like any of these used to end the run with zero assets imported; now the malformed row is skipped with a count and every finding still becomes a vulnerability.\n\nnamespaced_ids and no_placeholder_hostnames are skipped for the reasons the happy scenario records.",
  "kwargs": {
    "url": "$BASE",
    "company_id": "co-fixture",
    "api_token": "fixture-token"
  },
  "routes": [
    {
      "name": "assets",
      "match": {
        "method": "GET",
        "path": "/ratings/v1/companies/co-fixture/assets"
      },
      "responses": [
        {
          "status": 200,
          "json": {
            "count": 3,
            "links": {"next": null, "previous": null},
            "results": [
              {
                "asset": "198.51.100.30",
                "asset_type": "ip",
                "is_ip": true,
                "importance": "high",
                "tags": [null, "Guest Wifi", 42],
                "hosted_by": null,
                "origin_subsidiary": null,
                "cloud_context": null,
                "findings": null,
                "threats": null,
                "products": [null, "bare-string", {"name": "nginx"}]
              },
              "a-row-the-api-degraded-into-a-string",
              {
                "asset_type": "ip",
                "is_ip": true,
                "importance": "low"
              }
            ]
          }
        }
      ],
      "when_exhausted": "repeat_last"
    },
    {
      "name": "findings",
      "match": {
        "method": "GET",
        "path": "/ratings/v1/companies/co-fixture/findings"
      },
      "responses": [
        {
          "status": 200,
          "json": {
            "count": 4,
