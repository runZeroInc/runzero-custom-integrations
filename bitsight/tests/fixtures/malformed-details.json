                    "transport": "tcp"
                  }
                }
              },
              {
                "risk_vector_label": "Open Ports",
                "severity": "high",
                "details": {
                  "dest_port": "not-a-number",
                  "cvss": {"base": null},
                  "observed_ips": ["198.51.100.30:8443"],
                  "diligence_annotations": null
                }
              },
              {
                "risk_vector_label": "SSL Configurations",
                "severity": 5.0,
