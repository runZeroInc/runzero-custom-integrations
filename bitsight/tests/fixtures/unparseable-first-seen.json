{
  "name": "unparseable-first-seen",
  "integration": "bitsight",
  "description": "REGRESSION LOCK on parse_time. build_vuln called parse_time(first_seen) unconditionally, and parse_time ABORTS the script on a value it cannot parse rather than returning an error -- Starlark has no exception handling, so one such finding took down the whole import and lost every asset and finding already built. A `!= None` check after the call is dead code, because the call never returns; the value has to be screened first.\n\nFive findings on one asset cover the shapes that reached it. Only the first is well formed: Bitsight reports first_seen as a bare date, which the script pads to RFC 3339. The other four are the ones that aborted -- an absent key and an explicit null both left first_seen as None and reached parse_time(None); 'not-a-date' and a space-separated timestamp both survived the padding step and arrived at parse_time as 'not-a-dateT00:00:00Z' and '2026-01-05 00:00:00T00:00:00Z'.\n\nAll five must still become vulnerabilities; only the well-formed one carries a firstDetectedTS, which is why the assertion is on the count rather than on the timestamp.\n\nnamespaced_ids and no_placeholder_hostnames are skipped for the reasons the happy scenario records.",
  "kwargs": {
    "url": "$BASE",
    "company_id": "co-fixture",
    "api_token": "fixture-token"
  },
  "routes": [
    {
      "name": "assets",
      "match": {
        "method": "GET",
        "path": "/ratings/v1/companies/co-fixture/assets"
      },
      "responses": [
        {
          "status": 200,
          "json": {
            "count": 1,
            "links": {"next": null, "previous": null},
            "results": [
              {
                "asset": "198.51.100.20",
                "asset_type": "ip",
                "is_ip": true,
                "importance": "high",
                "country": "United States",
                "country_code": "US"
              }
            ]
          }
        }
      ],
      "when_exhausted": "repeat_last"
    },
    {
      "name": "findings",
      "match": {
        "method": "GET",
        "path": "/ratings/v1/companies/co-fixture/findings"
      },
      "responses": [
        {
          "status": 200,
          "json": {
            "count": 5,
            "links": {"next": null, "previous": null},
            "results": [
              {
                "risk_vector_label": "Patching Cadence",
                "severity": 7.0,
                "first_seen": "2026-01-05",
                "last_seen": "2026-02-05",
                "details": {
                  "dest_port": 443,
                  "observed_ips": ["198.51.100.20:443"],
                  "diligence_annotations": {
                    "message": "SYN-FIRST-SEEN-DATE-ONLY",
                    "Title": "A bare date, which is what Bitsight documents",
                    "transport": "tcp"
                  }
                }
              },
              {
                "risk_vector_label": "Open Ports",
                "severity": 4.0,
                "last_seen": "2026-02-05",
                "details": {
                  "dest_port": 22,
                  "observed_ips": ["198.51.100.20:22"],
                  "diligence_annotations": {
                    "message": "SYN-FIRST-SEEN-ABSENT",
                    "Title": "No first_seen key at all",
                    "transport": "tcp"
                  }
                }
              },
              {
                "risk_vector_label": "Open Ports",
                "severity": 3.0,
                "first_seen": null,
                "last_seen": "2026-02-05",
                "details": {
                  "dest_port": 25,
                  "observed_ips": ["198.51.100.20:25"],
                  "diligence_annotations": {
                    "message": "SYN-FIRST-SEEN-NULL",
                    "Title": "first_seen present but null",
                    "transport": "tcp"
                  }
                }
              },
              {
                "risk_vector_label": "SSL Configurations",
                "severity": 5.0,
                "first_seen": "not-a-date",
                "last_seen": "2026-02-05",
                "details": {
                  "dest_port": 8443,
                  "observed_ips": ["198.51.100.20:8443"],
                  "diligence_annotations": {
                    "message": "SYN-FIRST-SEEN-GARBAGE",
                    "Title": "A value that survives the padding step and still cannot parse",
                    "transport": "tcp"
                  }
                }
              },
              {
                "risk_vector_label": "SSL Certificates",
                "severity": 6.0,
                "first_seen": "2026-01-05 00:00:00",
                "last_seen": "2026-02-05",
                "details": {
                  "dest_port": 8080,
                  "observed_ips": ["198.51.100.20:8080"],
                  "diligence_annotations": {
                    "message": "SYN-FIRST-SEEN-SPACE-SEPARATED",
                    "Title": "A space-separated timestamp, padded into nonsense",
                    "transport": "tcp"
                  }
                }
              }
            ]
          }
        }
      ],
      "when_exhausted": "repeat_last"
    }
  ],
  "default_response": {"status": 404, "text": "no fixture route"},
  "expect": {
    "asset_count": 1,
    "ids": ["bitsight:ip:198.51.100.20"],
    "min_vulnerabilities_total": 5,
    "request_count": 2
  },
  "invariants": {
    "skip": [
      "namespaced_ids",
      "no_placeholder_hostnames"
    ]
  }
}
