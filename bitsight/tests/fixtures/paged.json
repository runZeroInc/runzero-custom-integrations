    "ids": [
      "bitsight:co-fixture:198.51.100.10",
      "bitsight:co-fixture:198.51.100.11",
      "bitsight:co-fixture:198.51.100.12",
      "bitsight:co-fixture:198.51.100.13"
    ],
    "assets": [
      {"id": "bitsight:co-fixture:198.51.100.12", "fields": {"country": "Germany", "countryCode": "DE"}}
    ],
    "min_vulnerabilities_total": 2,
    "request_count": 7,
    "requests_include": [
      {"method": "GET", "path": "/ratings/v1/companies/co-fixture/assets", "query_contains": "is_ip=true"},
      {"method": "GET", "path": "/ratings/v1/companies/co-fixture/assets", "query_contains": "offset=2"},
      {"method": "GET", "path": "/ratings/v1/companies/co-fixture/findings", "query_contains": "offset=1"}
    ],
    "requests_absent": [
