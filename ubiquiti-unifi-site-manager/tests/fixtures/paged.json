{
  "name": "paged",
  "integration": "ubiquiti-unifi-site-manager",
  "description": "Two consoles returned over two pages of /v1/hosts and two pages of /v1/devices at pageSize 2, using a real-shaped nextToken that contains a colon. Proves the cursor from one page is sent on the next request, that pageSize survives alongside it -- get_json's params= REPLACES a URL's query string rather than merging, so a cursor built that way is silently wiped and pagination restarts forever -- and that the walk stops when nextToken comes back empty rather than looping on the last page.",

  "kwargs": {
    "url": "$BASE",
    "api_key": "fixture-site-manager-key",
    "extract_sites": "false",
    "page_size": "2"
  },

  "routes": [
    {
      "match": {"method": "GET", "path": "/v1/hosts", "query_contains": "nextToken"},
