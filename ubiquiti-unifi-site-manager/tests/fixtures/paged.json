      "unifi-site-manager:$HOST:device:AABBCC000011",
      "unifi-site-manager:$HOST:device:AABBCC000002",
      "unifi-site-manager:$HOST:device:AABBCC000012"
    ],
    "assets": [
      {
        "id": "unifi-site-manager:$HOST:device:AABBCC000002",
        "fields": {
          "hostnames": "branch-b.example.com",
          "unifi_host_id": "HOSTB:222222222",
          "unifi_console_serial": "aabbcc000002"
        }
      }
    ],
    "requests_include": [
      {"method": "GET", "path": "/v1/hosts", "query_contains": "pageSize=2"},
      {"method": "GET", "path": "/v1/hosts", "query_contains": "nextToken=602232A87025"},
      {"method": "GET", "path": "/v1/devices", "query_contains": "pageSize=2"},
      {"method": "GET", "path": "/v1/devices", "query_contains": "nextToken=602232A87025"}
