                  "hostname": "branch-b.example.com",
                  "ip": "198.51.100.1",
                  "ipAddrs": ["198.51.100.1"],
                  "state": "connected",
                  "timezone": "Europe/Lisbon",
                  "version": "3.2.12"
                }
              }
            ],
            "httpStatusCode": 200,
            "traceId": "trace-hosts-2"
          }
        }
      ]
    },
    {
      "match": {"method": "GET", "path": "/v1/hosts"},
      "responses": [
        {
