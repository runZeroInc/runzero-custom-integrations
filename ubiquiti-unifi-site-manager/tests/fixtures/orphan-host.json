        }
      ]
    },
    {
      "match": {"method": "GET", "path": "/v1/devices"},
      "responses": [
        {
          "status": 200,
          "json": {
            "data": [
              {
                "hostId": "COVEREDCONSOLE:444444444",
                "hostName": "hq.example.com",
                "devices": [
                  {"id": "AABBCC000004", "mac": "AABBCC000004", "name": "hq.example.com", "model": "UDM SE", "shortname": "UDMPROSE", "ip": "198.51.100.5", "productLine": "network", "status": "online", "version": "4.1.13", "firmwareStatus": "upToDate", "isConsole": true, "isManaged": true}
                ],
                "updatedAt": "2026-06-23T07:21:27Z"
              }
            ],
            "httpStatusCode": 200,
            "traceId": "trace-devices"
          }
        }
      ]
    }
  ],

  "default_response": {"status": 404, "json": {"code": "not_found", "httpStatusCode": 404, "message": "no fixture route"}},

  "expect": {
    "asset_count": 3,
    "ids": [
      "unifi-site-manager:$HOST:device:AABBCC000004",
      "unifi-site-manager:$HOST:device:AABBCC000003",
      "unifi-site-manager:$HOST:host:1d9cf3ee-0c0f-466e-933c-9af829f09b50"
    ],
    "ids_absent": [
      "unifi-site-manager:$HOST:host:OFFLINECONSOLE:333333333",
      "unifi-site-manager:$HOST:host:COVEREDCONSOLE:444444444"
    ],
    "assets": [
      {
        "id": "unifi-site-manager:$HOST:device:AABBCC000003",
        "fields": {
          "hostnames": "shed.example.com",
          "model": "UniFi Cloud Key Gen2 Plus",
          "osVersion": "3.1.15",
          "deviceType": "Server",
          "unifi_state": "disconnected",
          "unifi_covered_by_device_list": "false",
          "unifi_console_cloud_address": "203.0.113.30"
        }
      },
      {
        "id": "unifi-site-manager:$HOST:host:1d9cf3ee-0c0f-466e-933c-9af829f09b50",
        "fields": {
          "hostnames": "unifi-server.example.com",
          "osVersion": "8.3.11",
          "unifi_host_type": "network-server"
        },
        "fields_absent": ["macAddresses", "deviceType"]
      },
      {
        "id": "unifi-site-manager:$HOST:device:AABBCC000004",
        "fields": {
          "hostnames": "hq.example.com",
          "unifi_console_serial": "aabbcc000004",
          "unifi_is_console": "true"
        }
      }
    ]
  },

  "check_determinism": true
}
