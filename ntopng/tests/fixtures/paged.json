                  }
                }
              ],
              "sort": [
                [
                  "column_ip",
                  "asc"
                ]
              ]
            }
          }
        }
      ],
      "when_exhausted": "repeat_last"
    }
  ],
  "default_response": {
    "status": 200,
    "json": {
      "rc": -1,
      "rc_str": "NOT_FOUND",
      "rc_str_hr": "Not found",
      "rsp": {}
    }
  },
  "expect": {
    "asset_count": 3,
    "ids": [
      "ntopng:$HOST:0:192.0.2.41",
      "ntopng:$HOST:30:192.0.2.42",
      "ntopng:$HOST:0:192.0.2.43"
    ],
    "requests_include": [
      {
        "body_contains": "\"currentPage\":2"
      }
    ],
    "requests_absent": [
      {
        "path_contains": "macs_list"
      },
      {
        "body_contains": "\"currentPage\":3"
      }
    ],
    "log_contains": [
      "ntopng: reported 3 assets from interface 1"
    ]
  },
  "invariants": {
    "skip": []
  },
  "check_determinism": true
}