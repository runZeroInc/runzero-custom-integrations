    "url": "$BASE",
    "api_token": "fixture-token",
    "page_size": "250"
  },
  "routes": [
    {
      "name": "interfaces",
      "match": {
        "method": "POST",
        "path": "/lua/rest/v2/get/ntopng/interfaces.lua"
      },
      "responses": [
        {
          "status": 200,
          "json": {
            "rc": 0,
            "rc_str": "OK",
            "rc_str_hr": "Success",
            "rsp": [
              {
                "ifid": 1,
                "ifname": "eth0",
                "name": "eth0",
                "is_packet_interface": true,
                "is_pcap_interface": false,
                "is_zmq_interface": false
