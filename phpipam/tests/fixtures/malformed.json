{
  "name": "malformed",
  "integration": "phpipam",
  "description": "Rows that break the documented shape must be skipped without ending the run: a bare string where an object belongs, a null id, a subnet whose location is a scalar rather than the object/empty-list pair phpIPAM really returns, an unparseable timestamp, and a FUTURE lastSeen. The future timestamp is the important one - the platform rejects the entire asset record on a time after now, so it must be clamped rather than passed through.",

  "kwargs": {
    "url": "$BASE",
    "app_id": "runzero",
    "username": "fixture-user",
    "password": "fixture-pass",
    "require_identity": "false"
  },

  "routes": [
    {
      "match": {"method": "POST", "path": "/api/runzero/user/"},
      "responses": [
        {"status": 200, "json": {"code": 200, "success": true, "data": {"token": "malformedtoken0000000001", "expires": "2036-08-16 11:03:55"}, "time": 0.005}}
      ],
      "when_exhausted": "repeat_last"
    },
    {
      "match": {"method": "GET", "path": "/api/runzero/sections/"},
      "responses": [
        {"status": 200, "json": {"code": 200, "success": true, "data": [
          "this is a string where an object belongs",
          {"id": 10, "name": "Lab Campus"},
          {"name": "section with no id"}
        ], "time": 0.002}}
      ],
      "when_exhausted": "repeat_last"
    },
    {
      "match": {"method": "GET", "path": "/api/runzero/tools/tags/"},
      "responses": [
        {"status": 200, "json": {"code": 200, "success": true, "data": [{"id": 2, "type": "Used"}], "time": 0.001}}
      ],
      "when_exhausted": "repeat_last"
    },
    {
      "match": {"method": "GET", "path": "/api/runzero/tools/locations/"},
      "responses": [
        {"status": 200, "json": {"code": 200, "success": true, "data": "not a list at all", "time": 0.001}}
      ],
      "when_exhausted": "repeat_last"
    },
    {
      "match": {"method": "GET", "path": "/api/runzero/tools/device_types/"},
      "responses": [
        {"status": 200, "json": {"code": 200, "success": true, "data": [{"tid": 1, "tname": "Switch"}], "time": 0.001}}
      ],
      "when_exhausted": "repeat_last"
    },
    {
      "match": {"method": "GET", "path": "/api/runzero/vlans/"},
      "responses": [
        {"status": 200, "json": {"code": 200, "success": true, "data": [{"id": 5, "number": null, "name": null}], "time": 0.001}}
      ],
      "when_exhausted": "repeat_last"
    },
    {
      "match": {"method": "GET", "path": "/api/runzero/devices/"},
      "responses": [
        {"status": 200, "json": {"code": 200, "success": true, "data": [
          {"id": null, "hostname": "device-with-null-id", "ip": "10.42.0.9", "type": 1},
          {"id": 60, "hostname": null, "ip": null, "type": 1, "description": "no hostname and no address"},
          {"id": 61, "hostname": "sw61.lab.example", "ip": "10.42.0.61", "type": 1, "sections": "10", "location": "99", "editDate": "not-a-timestamp"},
          "a bare string in the device list"
        ], "time": 0.002}}
      ],
      "when_exhausted": "repeat_last"
    },
    {
      "match": {"method": "GET", "path": "/api/runzero/subnets/30/addresses/"},
      "responses": [
        {"status": 200, "json": {"code": 200, "success": true, "data": [
          {"id": null, "subnetId": 30, "ip": "10.43.0.5", "hostname": "null-id.lab.example", "mac": "00:11:22:33:44:aa", "tag": 2},
          {"id": 200, "subnetId": 30, "ip": "10.43.0.10", "hostname": "future.lab.example", "mac": "00:11:22:33:44:bb", "tag": 2, "lastSeen": "2099-01-01 00:00:00"},
          {"id": 201, "subnetId": 30, "ip": "10.43.0.11", "hostname": "badtime.lab.example", "mac": "00:11:22:33:44:cc", "tag": 2, "lastSeen": "15/08/2026 09:30"},
          {"id": 202, "subnetId": 30, "ip": "169.254.10.10", "hostname": "apipa.lab.example", "mac": "00:11:22:33:44:dd", "tag": 2, "lastSeen": "2026-08-15 09:30:00"},
          {"id": 203, "subnetId": 30, "ip": "127.0.0.1", "hostname": null, "mac": null, "tag": 2},
          ["a list where an object belongs"]
        ], "time": 0.002}}
      ],
      "when_exhausted": "repeat_last"
    },
    {
      "match": {"method": "GET", "path": "/api/runzero/subnets/"},
      "responses": [
        {"status": 200, "json": {"code": 200, "success": true, "data": [
          {"id": 30, "subnet": "10.43.0.0", "mask": "24", "sectionId": 10, "description": "Malformed lab subnet", "vlanId": 5, "isFolder": 0, "location": "99", "tag": 2},
          {"subnet": "10.44.0.0", "mask": "24", "sectionId": 10, "description": "subnet with no id", "isFolder": 0, "location": []},
          "a bare string in the subnet list"
        ], "time": 0.004}}
      ],
      "when_exhausted": "repeat_last"
    },
    {
      "match": {"method": "GET", "path_prefix": "/api/runzero/subnets/"},
      "responses": [
        {"status": 404, "json": {"code": 404, "success": false, "message": "No addresses found", "time": 0.001}}
      ],
      "when_exhausted": "repeat_last"
    }
  ],

  "default_response": {"status": 404, "text": "no fixture route"},

  "expect": {
    "ids": [
      "phpipam:$HOST:address:200",
      "phpipam:$HOST:address:201",
      "phpipam:$HOST:address:202",
      "phpipam:$HOST:device:61"
    ],
    "ids_absent": [
      "phpipam:$HOST:device:60"
    ],
    "assets": [
      {
        "id": "phpipam:$HOST:address:200",
        "comment": "lastSeen is in the year 2099. A future timestamp makes the platform reject the ENTIRE record, so it must be clamped to now; the raw value survives as an attribute.",
        "fields": {"phpipam_last_seen_raw": "2099-01-01 00:00:00"}
      },
      {
        "id": "phpipam:$HOST:address:202",
        "comment": "169.254/16 is APIPA. The platform keeps link-local rather than filtering it, so this script must drop it; the address is left with the MAC alone.",
        "fields": {"phpipam_ip": "169.254.10.10"},
        "fields_absent": ["ipAddresses"]
      },
      {
        "id": "phpipam:$HOST:device:61",
        "comment": "location 99 resolves against an empty lookup because /tools/locations/ returned a string, and editDate is unparseable. Neither may abort the run.",
        "fields": {"phpipam_hostname": "sw61.lab.example", "deviceType": "Switch"}
      }
    ],
    "log_contains": [
      "phpipam: skipping address row with no id in subnet 30",
      "phpipam: skipping device row with no id",
      "phpipam: skipping device 60 with no usable address or hostname"
    ]
  },

  "check_determinism": true
}
