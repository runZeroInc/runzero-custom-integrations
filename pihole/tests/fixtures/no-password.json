{
  "name": "no-password",
  "integration": "pihole",
  "description": "A Pi-hole with no password set answers the login with valid=true and a null session id, and then expects no session header at all. The run must recognise that rather than treating the missing id as a failure.",
  "kwargs": {
    "url": "$BASE",
    "password": "fixture-password",
    "include_leases": "false"
  },
  "routes": [
    {
      "name": "auth",
      "match": {
        "method": "POST",
        "path": "/api/auth"
      },
      "responses": [
        {
          "status": 200,
          "json": {
            "session": {
              "valid": true,
              "totp": false,
              "sid": null,
              "csrf": null,
              "validity": -1,
              "message": "no auth for local user"
            },
            "took": 0.003
          }
        }
      ],
      "when_exhausted": "repeat_last"
    },
    {
      "name": "version",
      "match": {
        "method": "GET",
        "path": "/api/info/version"
      },
      "responses": [
        {
          "status": 200,
          "json": {
            "version": {
              "core": {
                "local": {
                  "branch": "master",
                  "version": "v6.1.2",
                  "hash": "955e36a9"
                },
                "remote": {
                  "version": "v6.1.2",
                  "hash": "955e36a9"
                }
              },
              "web": {
                "local": {
                  "branch": "master",
                  "version": "v6.1",
                  "hash": "f69f7e88"
                },
                "remote": {
                  "version": "v6.1",
                  "hash": "f69f7e88"
                }
              },
              "ftl": {
                "local": {
                  "branch": "master",
                  "version": "v6.1.3",
                  "hash": "64441ed6"
                },
                "remote": {
                  "version": "v6.1.3",
                  "hash": "64441ed6"
                }
              },
              "docker": {
                "local": null,
                "remote": null
              }
            },
            "took": 0.003
          }
        }
      ],
      "when_exhausted": "repeat_last"
    },
    {
      "name": "devices",
      "match": {
        "method": "GET",
        "path": "/api/network/devices"
      },
      "responses": [
        {
          "status": 200,
          "json": {
            "devices": [
              {
                "id": 1,
                "hwaddr": "aa:bb:cc:11:22:33",
                "interface": "eth0",
                "firstSeen": 1664623620,
                "lastQuery": 1786840100,
                "numQueries": 585462,
                "macVendor": "Digital Data Communications Asia Co.,Ltd",
                "ips": [
                  {
                    "ip": "192.0.2.51",
                    "name": "ubuntu-server",
                    "lastSeen": 1786840100,
                    "nameUpdated": 1786830000
                  },
                  {
                    "ip": "2001:db8:2::51",
                    "name": "ubuntu-server.lan",
                    "lastSeen": 1786840050,
                    "nameUpdated": 1786830000
                  },
                  {
                    "ip": "fe80::a8bb:ccff:fe11:2233",
                    "name": null,
                    "lastSeen": 1786840090,
                    "nameUpdated": 0
                  }
                ]
              }
            ],
            "took": 0.01
          }
        }
      ],
      "when_exhausted": "repeat_last"
    },
    {
      "name": "logout",
      "match": {
        "method": "DELETE",
        "path": "/api/auth"
      },
      "responses": [
        {
          "status": 204,
          "text": ""
        }
      ],
      "when_exhausted": "repeat_last"
    }
  ],
  "default_response": {
    "status": 404,
    "json": {
      "error": {
        "key": "not_found",
        "message": "Not found",
        "hint": null
      },
      "took": 0.001
    }
  },
  "expect": {
    "asset_count": 1,
    "ids": [
      "pihole:$HOST:1"
    ],
    "requests_absent": [
      {
        "method": "DELETE",
        "path": "/api/auth"
      }
    ],
    "log_contains": [
      "no session id was issued: no auth for local user",
      "pihole: reported 1 assets"
    ]
  },
  "invariants": {
    "skip": []
  },
  "check_determinism": true
}