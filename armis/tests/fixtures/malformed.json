                  "type": "Infusion Pumps"
                }
              ]
            }
          }
        }
      ],
      "when_exhausted": "error"
    }
  ],
  "default_response": {"status": 404, "text": "no fixture route"},
  "expect": {
    "asset_count": 2,
    "assets": [
      {
        "id": "armis:$HOST:9004",
        "fields": {
          "hostnames": "multi-address-host",
          "ipAddresses": "10.93.0.4",
          "macAddresses": "44:55:22:00:00:04\t44:55:22:00:00:05",
          "deviceType": "Servers",
          "armis_risk_level": "high",
          "tags": "Corporate"
        }
      }
    ],
    "ids": [
      "armis:$HOST:9001",
      "armis:$HOST:9004"
    ],
    "ids_absent": [
      "armis:$HOST:9005",
      "armis:$HOST:"
    ],
    "request_count": 2,
    "log_contains": [
      "armis: skipping device record with no id, name=no-id-host",
      "armis: skipped 1 devices with no MAC, IP, or hostname to correlate on"
    ]
  },
  "check_determinism": true
}
