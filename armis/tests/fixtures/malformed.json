{
  "name": "malformed",
  "integration": "armis",
  "description": "Junk in the device page must cost the record, never the run. Covered here: a null id, a bare string where the envelope documents an object, site and dataSources and customProperties arriving as strings where objects and arrays are documented, macAddress and ipAddress arriving as v3-style arrays where v1 documents scalars, an unparseable firstSeen, a zero lastSeen, and a device whose only address is loopback and whose only name is the placeholder 'unknown' -- that one has nothing runZero can correlate on and must be dropped rather than imported as a permanent orphan, which is the direct consequence of barring the Armis id from matching. The page also answers a non-numeric data.next, which the offset guard must read as end-of-walk instead of re-requesting offset 0 until the page ceiling fires.",
  "kwargs": {
    "url": "$BASE",
    "secret_key": "fixture-secret-key",
    "page_size": "1000",
    "include_vulnerabilities": "false"
  },
  "routes": [
    {
      "name": "token",
      "match": {"method": "POST", "path": "/api/v1/access_token/"},
      "responses": [
        {"status": 200, "json": {"data": {"access_token": "malformed-token", "expiration_utc": "2026-08-26T18:04:56.123456+00:00"}}}
      ],
      "when_exhausted": "repeat_last"
    },
    {
      "name": "devices",
      "match": {"method": "GET", "path": "/api/v1/search/"},
      "responses": [
        {
          "status": 200,
          "json": {
            "data": {
              "count": 5,
              "next": "not-an-offset",
              "prev": null,
              "results": [
                {
                  "category": "Computers",
                  "firstSeen": "2024-08-01T00:00:00.000000+00:00",
                  "id": 9001,
                  "ipAddress": "10.93.0.1",
                  "lastSeen": "2026-08-01T00:00:00.000000+00:00",
                  "macAddress": "44:55:22:00:00:01",
                  "name": "malformed-good",
                  "operatingSystem": "Linux",
                  "site": {"location": "Reno", "name": "Reno Plant"},
                  "type": "Servers"
                },
                {
                  "category": "Computers",
                  "id": null,
                  "ipAddress": "10.93.0.2",
                  "lastSeen": "2026-08-01T00:00:00.000000+00:00",
                  "macAddress": "44:55:22:00:00:02",
                  "name": "no-id-host",
                  "type": "Laptops"
                },
                "unexpected-row",
                {
                  "customProperties": "none",
                  "dataSources": "Active Directory",
                  "firstSeen": "yesterday afternoon",
                  "id": 9004,
                  "ipAddress": ["10.93.0.4", "127.0.0.1", "169.254.10.5"],
                  "ipv6": "not-an-address",
                  "lastSeen": 0,
                  "macAddress": ["44:55:22:00:00:04", "44:55:22:00:00:05"],
                  "name": "multi-address-host",
                  "riskLevel": "high",
                  "sensor": 42,
                  "site": "Reno Plant",
                  "tags": "Corporate",
