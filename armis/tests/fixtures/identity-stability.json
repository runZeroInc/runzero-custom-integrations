            }
          }
        }
      ],
      "when_exhausted": "empty"
    }
  ],
  "default_response": {"status": 404, "text": "no fixture route"},
  "expect": {
    "asset_count": 3,
    "ids": [
      "armis:$HOST:469",
      "armis:$HOST:2172",
      "armis:$HOST:74745"
    ],
    "assets": [
      {
        "id": "armis:$HOST:469",
        "fields": {
          "hostnames": "geneva-file-01-renamed",
          "ipAddresses": "192.0.2.77\t2001:db8:99::77",
          "macAddresses": "44:a7:4b:99:99:99",
