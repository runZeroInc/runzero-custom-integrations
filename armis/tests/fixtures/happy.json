{
  "name": "happy",
  "integration": "armis",
  "description": "The token exchange, one page of in:vulnerabilities, one page of vulnerability-match, and one page of in:devices, built from the device payloads Armis integration vendors publish. Covers the Armis 1.8 shape (ipv6 as an array), the 2021 shape (ipv6 as a scalar, and a link-local one that must be dropped), a device with no macAddress at all, and a device with no MAC, no IP, and no hostname, which has nothing for runZero to correlate on and must therefore be skipped rather than imported as a permanent orphan. One vulnerability match lands on a device in the inventory page and one on a device that is not, proving the unjoinable finding is counted rather than silently dropped.",
  "kwargs": {
    "url": "$BASE",
    "secret_key": "fixture-secret-key",
    "page_size": "1000",
    "include_vulnerabilities": "true"
  },
